{%- comment -%}
  Lightweight client search index. Images prefer Shopify Admin product/collection media.
{%- endcomment -%}
{%- liquid
  assign coffee_handle = settings.collection_coffee | default: 'coffee-tables'
  assign side_handle = settings.collection_side | default: 'side-tables'
  assign console_handle = settings.collection_console | default: 'console-tables'
  assign coffee = collections[coffee_handle]
  assign side = collections[side_handle]
  assign console = collections[console_handle]
-%}
<script type="application/json" data-nc-catalog-search>[
{%- assign catalog_handles = 'cft-1,cft-2,cft-3,cs-1,cs-2,cs-3,sd-1,sd-2,sd-3' | split: ',' -%}
{%- for handle in catalog_handles -%}
  {%- assign p = all_products[handle] -%}
  {%- capture img_src -%}{% render 'nc-catalog-default-img', handle: handle, product: p %}{%- endcapture -%}
  {%- capture pname -%}{% if p != blank %}{{ p.title }}{% else %}{{ handle }}{% endif %}{%- endcapture -%}
  {%- capture pcat -%}{% render 'nc-product-field', product: p, handle: handle, field: 'category' %}{%- endcapture -%}
  {%- assign pname = pname | strip -%}
  {%- assign pcat = pcat | strip -%}
  {%- assign img_src = img_src | strip -%}
  {"handle":{{ handle | json }},"name":{{ pname | json }},"category":{{ pcat | json }},"url":{% if p != blank %}{{ p.url | json }}{% else %}{{ handle | prepend: '/products/' | json }}{% endif %},"image":{{ img_src | json }},"keywords":{{ handle | append: ' ' | append: pname | append: ' ' | append: pcat | downcase | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
,{%- capture coffee_img -%}{% render 'nc-collection-cover', handle: coffee_handle %}{%- endcapture -%}
{%- capture side_img -%}{% render 'nc-collection-cover', handle: side_handle %}{%- endcapture -%}
{%- capture console_img -%}{% render 'nc-collection-cover', handle: console_handle %}{%- endcapture -%}
{"handle":"coffee-tables","name":"Coffee Tables","category":"Collection","url":{% if coffee != blank %}{{ coffee.url | json }}{% else %}"/collections/coffee-tables"{% endif %},"image":{{ coffee_img | strip | json }},"keywords":"coffee tables collection cft"},
{"handle":"side-tables","name":"Side Tables","category":"Collection","url":{% if side != blank %}{{ side.url | json }}{% else %}"/collections/side-tables"{% endif %},"image":{{ side_img | strip | json }},"keywords":"side tables collection sd"},
{"handle":"console-tables","name":"Console Tables","category":"Collection","url":{% if console != blank %}{{ console.url | json }}{% else %}"/collections/console-tables"{% endif %},"image":{{ console_img | strip | json }},"keywords":"console tables collection cs"}
]
</script>
