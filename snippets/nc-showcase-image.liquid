{%- comment -%}
  Returns a random product lifestyle image URL from the theme catalog.
  @param pool {String} hero | coffee | side | console | about | accent
{%- endcomment -%}
{%- liquid
  assign hero_pool = 'products/cft-2-armani-grey.jpg|products/cft-3-rosso-levanto.jpg|products/cs-3-armani-grey.jpg|products/cft-1-ibiza-white.jpg|products/cs-2-ibiza-white.jpg|products/sd-2-armani-grey.jpg|products/cft-2-travertine.jpg|products/cs-1-travertine.jpg' | split: '|'
  assign coffee_pool = 'products/cft-1-ibiza-white.jpg|products/cft-1-armani-grey.jpg|products/cft-1-travertine.jpg|products/cft-2-ibiza-white.jpg|products/cft-2-armani-grey.jpg|products/cft-2-travertine.jpg|products/cft-3-ibiza-white.jpg|products/cft-3-travertine.jpg|products/cft-3-rosso-levanto.jpg' | split: '|'
  assign side_pool = 'products/sd-1-ibiza-white.jpg|products/sd-1-armani-grey.jpg|products/sd-1-travertine.jpg|products/sd-2-ibiza-white.jpg|products/sd-2-armani-grey.jpg|products/sd-2-travertine.jpg|products/sd-3-ibiza-white.jpg|products/sd-3-armani-grey.jpg|products/sd-3-travertine.jpg' | split: '|'
  assign console_pool = 'products/cs-1-ibiza-white.jpg|products/cs-1-armani-grey.jpg|products/cs-1-travertine.jpg|products/cs-2-ibiza-white.jpg|products/cs-2-armani-grey.jpg|products/cs-2-travertine.jpg|products/cs-3-ibiza-white.jpg|products/cs-3-armani-grey.jpg|products/cs-3-travertine.jpg' | split: '|'
  assign about_pool = 'products/cft-1-travertine.jpg|products/cs-2-armani-grey.jpg|products/sd-3-travertine.jpg|products/cft-3-ibiza-white.jpg|products/cs-1-ibiza-white.jpg|products/sd-1-armani-grey.jpg' | split: '|'
  assign accent_pool = 'products/cft-2-ibiza-white.jpg|products/sd-3-ibiza-white.jpg|products/cs-3-travertine.jpg|products/cft-3-rosso-levanto.jpg|products/sd-2-travertine.jpg|products/cs-2-travertine.jpg' | split: '|'

  case pool
    when 'coffee'
      assign picked = coffee_pool | sample
    when 'side'
      assign picked = side_pool | sample
    when 'console'
      assign picked = console_pool | sample
    when 'about'
      assign picked = about_pool | sample
    when 'accent'
      assign picked = accent_pool | sample
    else
      assign picked = hero_pool | sample
  endcase

  echo picked | asset_url
-%}
