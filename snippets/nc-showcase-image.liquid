{%- comment -%}
  Returns a random product lifestyle image URL from the theme catalog.
  @param pool {String} hero | coffee | side | console | about | accent
{%- endcomment -%}
{%- liquid
  assign hero_pool = 'cft-2-armani-grey-v2.jpg|cft-3-rosso-levanto-v2.jpg|cs-3-armani-grey-v2.jpg|cft-1-ibiza-white-v2.jpg|cs-2-ibiza-white-v2.jpg|sd-2-armani-grey-v2.jpg|cft-2-travertine-v2.jpg|cs-1-travertine-v2.jpg' | split: '|'
  assign coffee_pool = 'cft-1-ibiza-white-v2.jpg|cft-1-armani-grey-v2.jpg|cft-1-travertine-v2.jpg|cft-2-ibiza-white-v2.jpg|cft-2-armani-grey-v2.jpg|cft-2-travertine-v2.jpg|cft-3-ibiza-white-v2.jpg|cft-3-travertine-v2.jpg|cft-3-rosso-levanto-v2.jpg' | split: '|'
  assign side_pool = 'sd-1-ibiza-white-v2.jpg|sd-1-armani-grey-v2.jpg|sd-1-travertine-v2.jpg|sd-2-ibiza-white-v2.jpg|sd-2-armani-grey-v2.jpg|sd-2-travertine-v2.jpg|sd-3-ibiza-white-v2.jpg|sd-3-armani-grey-v2.jpg|sd-3-travertine-v2.jpg' | split: '|'
  assign console_pool = 'cs-1-ibiza-white-v2.jpg|cs-1-armani-grey-v2.jpg|cs-1-travertine-v2.jpg|cs-2-ibiza-white-v2.jpg|cs-2-armani-grey-v2.jpg|cs-2-travertine-v2.jpg|cs-3-ibiza-white-v2.jpg|cs-3-armani-grey-v2.jpg|cs-3-travertine-v2.jpg' | split: '|'
  assign about_pool = 'cft-1-travertine-v2.jpg|cs-2-armani-grey-v2.jpg|sd-3-travertine-v2.jpg|cft-3-ibiza-white-v2.jpg|cs-1-ibiza-white-v2.jpg|sd-1-armani-grey-v2.jpg' | split: '|'
  assign accent_pool = 'cft-2-ibiza-white-v2.jpg|sd-3-ibiza-white-v2.jpg|cs-3-travertine-v2.jpg|cft-3-rosso-levanto-v2.jpg|sd-2-travertine-v2.jpg|cs-2-travertine-v2.jpg' | split: '|'

  case pool
    when 'coffee'
      assign picked = coffee_pool | sample
    when 'side'
      assign picked = side_pool | sample
    when 'console'
      assign picked = console_pool | sample
    when 'about'
      assign picked = about_pool | sample
    when 'accent'
      assign picked = accent_pool | sample
    else
      assign picked = hero_pool | sample
  endcase

  echo picked | asset_url
-%}
