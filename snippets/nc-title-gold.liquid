{%- comment -%}
  Last word of a multi-word title is gold. Single-word titles stay ink
  (CASA and product names are marked in their own markup).
  @param title {String}
{%- endcomment -%}
{%- assign title_words = title | strip | split: ' ' -%}
{%- if title_words.size <= 1 -%}
  {{- title | strip -}}
{%- else -%}
  {%- capture prefix -%}
    {%- for word in title_words -%}
      {%- unless forloop.last -%}{{ word }} {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {{- prefix -}}<span class="nc-gold">{{ title_words | last }}</span>
{%- endif -%}
