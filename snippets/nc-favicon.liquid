{%- comment -%}
  Browser icon: black-background monogram, not the clear mark.
  Placed after content_for_header so it wins over Shopify's default icon.
{%- endcomment -%}
{%- assign nc_favicon = 'nerocasa-favicon.png' | asset_url | prepend: 'https:' -%}
<link rel="icon" type="image/png" href="{{ nc_favicon }}" sizes="192x192">
<link rel="shortcut icon" type="image/png" href="{{ nc_favicon }}">
<link rel="apple-touch-icon" href="{{ nc_favicon }}">
