{%- comment -%}
  Renders best-seller cards from the theme catalog (random pick each load).
  Used when the Shopify best-sellers collection is empty or thin.
  @param limit {Number} optional, default 6
{%- endcomment -%}
{%- liquid
  assign card_limit = limit | default: 6 | plus: 0
  assign showcase_pool = 'cft-1::Coffee Table 1::products/cft-1-ibiza-white.jpg::coffee|cft-2::Coffee Table 2::products/cft-2-armani-grey.jpg::coffee|cft-3::Coffee Table 3::products/cft-3-rosso-levanto.jpg::coffee|cs-1::Console Table 1::products/cs-1-travertine.jpg::console|cs-2::Console Table 2::products/cs-2-ibiza-white.jpg::console|cs-3::Console Table 3::products/cs-3-armani-grey.jpg::console|sd-1::Side Table 1::products/sd-1-armani-grey.jpg::side|sd-2::Side Table 2::products/sd-2-travertine.jpg::side|sd-3::Side Table 3::products/sd-3-ibiza-white.jpg::side' | split: '|'
  assign picks = showcase_pool | sample: card_limit
-%}
{%- for entry in picks -%}
  {%- assign parts = entry | split: '::' -%}
  {%- assign item_handle = parts[0] -%}
  {%- assign item_title = parts[1] -%}
  {%- assign item_image = parts[2] -%}
  {%- assign item_category = parts[3] -%}
  {%- assign shop_product = all_products[item_handle] -%}
  {%- if shop_product != blank -%}
    {%- assign item_url = shop_product.url -%}
    {%- assign item_price = shop_product.price | money -%}
  {%- else -%}
    {%- assign item_url = '/products/' | append: item_handle -%}
    {%- assign item_price = 'Configure ↗' -%}
  {%- endif -%}
  <a class="ncs-best-card" href="{{ item_url }}">
    <div class="ncs-best-image">
      <img src="{{ item_image | asset_url }}" alt="{{ item_title | escape }}" width="900" height="1125" loading="lazy">
    </div>
    <div class="ncs-best-meta">
      <span>{{ item_title }}</span>
      <b>{{ item_price }}</b>
    </div>
  </a>
{%- endfor -%}
