{%- comment -%}
  Collection grid — prefers Shopify collection products; fallback handles for dev.
  @param category {String} coffee | side | console
  @param collection {Collection} optional
{%- endcomment -%}
{%- if collection != blank and collection.products_count > 0 -%}
  {%- for shop_product in collection.products -%}
    {% render 'nc-catalog-card', shop_product: shop_product %}
  {%- endfor -%}
{%- else -%}
  {%- liquid
    case category
      when 'side'
        assign catalog_handles = 'sd-1,sd-2,sd-3' | split: ','
      when 'console'
        assign catalog_handles = 'cs-1,cs-2,cs-3' | split: ','
      else
        assign catalog_handles = 'cft-1,cft-2,cft-3' | split: ','
    endcase
  -%}
  {%- for item_handle in catalog_handles -%}
    {%- assign shop_product = all_products[item_handle] -%}
    {%- if shop_product != blank -%}
      {% render 'nc-catalog-card', shop_product: shop_product %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
