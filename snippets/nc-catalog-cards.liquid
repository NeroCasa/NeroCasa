{%- comment -%}
  Catalog product cards for a collection page.
  @param category {String} coffee | side | console
{%- endcomment -%}
{%- liquid
  case category
    when 'side'
      assign catalog_handles = 'sd-1,sd-2,sd-3' | split: ','
    when 'console'
      assign catalog_handles = 'cs-1,cs-2,cs-3' | split: ','
    else
      assign catalog_handles = 'cft-1,cft-2,cft-3' | split: ','
  endcase
-%}
{%- for item_handle in catalog_handles -%}
  {%- assign shop_product = all_products[item_handle] -%}
  {%- if shop_product != blank -%}
    {%- assign item_url = shop_product.url -%}
    {%- assign item_title = shop_product.title -%}
    {%- assign item_price = shop_product.price | money -%}
  {%- else -%}
    {%- assign item_url = '/products/' | append: item_handle -%}
    {%- case item_handle -%}
      {%- when 'cft-1' -%}{%- assign item_title = 'Coffee Table 1' -%}
      {%- when 'cft-2' -%}{%- assign item_title = 'Coffee Table 2' -%}
      {%- when 'cft-3' -%}{%- assign item_title = 'Coffee Table 3' -%}
      {%- when 'cs-1' -%}{%- assign item_title = 'Console Table 1' -%}
      {%- when 'cs-2' -%}{%- assign item_title = 'Console Table 2' -%}
      {%- when 'cs-3' -%}{%- assign item_title = 'Console Table 3' -%}
      {%- when 'sd-1' -%}{%- assign item_title = 'Side Table 1' -%}
      {%- when 'sd-2' -%}{%- assign item_title = 'Side Table 2' -%}
      {%- when 'sd-3' -%}{%- assign item_title = 'Side Table 3' -%}
      {%- else -%}{%- assign item_title = item_handle | upcase -%}
    {%- endcase -%}
    {%- assign item_price = '' -%}
  {%- endif -%}
  {%- capture item_src -%}{% render 'nc-catalog-default-img', handle: item_handle %}{%- endcapture -%}
  <a class="ncs-card" href="{{ item_url }}" data-nc-reveal>
    <div class="ncs-fit-img ncs-fit-img--tile ncs-card-media">
      <img src="{{ item_src | strip }}" alt="{{ item_title | escape }}" width="900" height="1125" loading="lazy">
    </div>
    <div class="ncs-card-info">
      <span>{{ item_title }}</span>
      {%- if item_price != blank -%}<b>{{ item_price }}</b>{%- endif -%}
    </div>
  </a>
{%- endfor -%}
