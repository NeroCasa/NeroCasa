{%- comment -%}
  Collection grid — prefers Shopify collection products; fallback handles for dev.
  @param category {String} coffee | side | console
  @param collection {Collection} optional
{%- endcomment -%}
{%- if collection != blank and collection.products_count > 0 -%}
  {%- for shop_product in collection.products -%}
    {% render 'nc-catalog-card', shop_product: shop_product, reveal_delay: forloop.index0 %}
  {%- endfor -%}
{%- else -%}
  {%- liquid
    case category
      when 'side'
        assign catalog_handles = 'nodo,sd-1,punto,sd-2,scalino,sd-3' | split: ','
      when 'console'
        assign catalog_handles = 'galleria,cs-1,passaggio,cs-2,atrio,cs-3' | split: ','
      else
        assign catalog_handles = 'soglia,cft-1,equilibrio,cft-2,monolite,cft-3' | split: ','
    endcase
  -%}
  {%- for item_handle in catalog_handles -%}
    {%- assign shop_product = all_products[item_handle] -%}
    {%- if shop_product != blank -%}
      {% render 'nc-catalog-card', shop_product: shop_product, reveal_delay: forloop.index0 %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
