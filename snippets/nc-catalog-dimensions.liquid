{%- comment -%}
  Standard dimension chips from Shopify metafields (fallback: catalog defaults).
  @param product {Product} optional
  @param handle {String}
{%- endcomment -%}
{%- capture dim_h -%}{% render 'nc-product-field', product: product, handle: handle, field: 'height' %}{%- endcapture -%}
{%- capture dim_l -%}{% render 'nc-product-field', product: product, handle: handle, field: 'length' %}{%- endcapture -%}
{%- capture dim_w -%}{% render 'nc-product-field', product: product, handle: handle, field: 'width' %}{%- endcapture -%}
{%- capture dim_d -%}{% render 'nc-product-field', product: product, handle: handle, field: 'depth' %}{%- endcapture -%}
{%- assign dim_h = dim_h | strip -%}
{%- assign dim_l = dim_l | strip -%}
{%- assign dim_w = dim_w | strip -%}
{%- assign dim_d = dim_d | strip -%}
{%- if handle == 'cft-3' -%}
  <div class="ncs-dim-set">
    <small>Piece 1</small>
    <span><b>H</b> 45 cm</span>
    <span><b>L</b> 190 cm</span>
    <span><b>W</b> 60 cm</span>
  </div>
  <div class="ncs-dim-set">
    <small>Piece 2</small>
    <span><b>H</b> 30 cm</span>
    <span><b>L</b> 190 cm</span>
    <span><b>W</b> 60 cm</span>
  </div>
{%- else -%}
  {%- if dim_h != blank -%}<span><b>H</b> {{ dim_h }} cm</span>{%- endif -%}
  {%- if dim_l != blank -%}<span><b>L</b> {{ dim_l }} cm</span>{%- endif -%}
  {%- if dim_w != blank -%}<span><b>W</b> {{ dim_w }} cm</span>{%- endif -%}
  {%- if dim_d != blank -%}<span><b>D</b> {{ dim_d }} cm</span>{%- endif -%}
{%- endif -%}
