{%- comment -%}
  Standard dimensions as a spec grid (not dim chips).
  @param product {Product} optional
  @param handle {String}
{%- endcomment -%}
{%- capture dim_h -%}{% render 'nc-product-field', product: product, handle: handle, field: 'height' %}{%- endcapture -%}
{%- capture dim_l -%}{% render 'nc-product-field', product: product, handle: handle, field: 'length' %}{%- endcapture -%}
{%- capture dim_w -%}{% render 'nc-product-field', product: product, handle: handle, field: 'width' %}{%- endcapture -%}
{%- capture dim_d -%}{% render 'nc-product-field', product: product, handle: handle, field: 'depth' %}{%- endcapture -%}
{%- assign dim_h = dim_h | strip -%}
{%- assign dim_l = dim_l | strip -%}
{%- assign dim_w = dim_w | strip -%}
{%- assign dim_d = dim_d | strip -%}
{%- capture catalog_code -%}{% render 'nc-catalog-code', handle: handle %}{%- endcapture -%}
{%- assign catalog_code = catalog_code | strip -%}
{%- if catalog_code == 'cft-3' -%}
  <div class="ncs-dim-set">
    <small>Piece 1</small>
    <dl class="ncs-spec-grid">
      <div><dt>Height</dt><dd>45 cm</dd></div>
      <div><dt>Length</dt><dd>190 cm</dd></div>
      <div><dt>Width</dt><dd>60 cm</dd></div>
    </dl>
  </div>
  <div class="ncs-dim-set">
    <small>Piece 2</small>
    <dl class="ncs-spec-grid">
      <div><dt>Height</dt><dd>30 cm</dd></div>
      <div><dt>Length</dt><dd>190 cm</dd></div>
      <div><dt>Width</dt><dd>60 cm</dd></div>
    </dl>
  </div>
{%- else -%}
  <dl class="ncs-spec-grid">
    {%- if dim_h != blank -%}<div><dt>Height</dt><dd>{{ dim_h }} cm</dd></div>{%- endif -%}
    {%- if dim_l != blank -%}<div><dt>Length</dt><dd>{{ dim_l }} cm</dd></div>{%- endif -%}
    {%- if dim_w != blank -%}<div><dt>Width</dt><dd>{{ dim_w }} cm</dd></div>{%- endif -%}
    {%- if dim_d != blank -%}<div><dt>Depth</dt><dd>{{ dim_d }} cm</dd></div>{%- endif -%}
  </dl>
{%- endif -%}
