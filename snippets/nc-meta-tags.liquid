{%- liquid
  assign brand = settings.brand_name | default: 'NEROCASA'
  assign tagline = settings.brand_tagline | default: 'Made-to-order marble furniture from our factory in Sharjah Industrial Area 15. Delivered across the UAE.'
  assign the_9_handle = settings.collection_the_9 | default: 'the-9'
  assign workshop_address = settings.workshop_address | default: 'Industrial Area 15, Sharjah, United Arab Emirates'
  assign seo_title = page_title | default: brand
  assign seo_description = page_description
  assign og_type = 'website'
  assign og_image = blank
  # `canonical_url | default: x | append: request.path` appended the path even
  # when canonical_url was set, producing /products/cft-1/products/cft-1.
  assign page_url = canonical_url
  if page_url == blank
    assign page_url = request.origin | append: request.path
  endif
  if request.page_type == 'product' and product
    assign og_type = 'product'
    if product.featured_image
      assign og_image = product.featured_image | image_url: width: 1200
    endif
    if product.seo.description != blank
      assign seo_description = product.seo.description
    elsif page_description != blank
      assign seo_description = page_description
    elsif product.description != blank
      assign seo_description = product.description | strip_html | strip_newlines
    endif
  elsif request.page_type == 'collection' and collection
    if collection.image
      assign og_image = collection.image | image_url: width: 1200
    elsif collection.products_count > 0 and collection.products.first.featured_image
      assign og_image = collection.products.first.featured_image | image_url: width: 1200
    endif
    assign the_9_handle = settings.collection_the_9 | default: 'the-9'
    if collection.handle == the_9_handle
      if page_title == blank or page_title == collection.title
        assign seo_title = 'The 9 | Marble Furniture UAE | ' | append: brand
      endif
      if seo_description == blank
        assign seo_description = 'Nine made-to-order marble designs from our Sharjah factory. Coffee, side and console tables, delivered across the UAE.'
      endif
    endif
    if seo_description == blank
      if collection.seo.description != blank
        assign seo_description = collection.seo.description
      elsif collection.description != blank
        assign seo_description = collection.description | strip_html | strip_newlines | truncate: 160
      endif
    endif
  elsif request.page_type == 'page' and page
    if seo_description == blank
      if page.seo.description != blank
        assign seo_description = page.seo.description
      elsif page.excerpt != blank
        assign seo_description = page.excerpt | strip_html | strip_newlines | truncate: 160
      elsif page.content != blank
        assign seo_description = page.content | strip_html | strip_newlines | truncate: 160
      endif
    endif
  elsif request.page_type == 'article' and article
    assign og_type = 'article'
    if article.image
      assign og_image = article.image | image_url: width: 1200
    else
      assign og_image = 'nerocasa-brand-logo.jpg' | asset_url
    endif
    if seo_description == blank
      if article.excerpt != blank
        assign seo_description = article.excerpt | strip_html | strip_newlines | truncate: 160
      else
        assign seo_description = article.content | strip_html | strip_newlines | truncate: 160
      endif
    endif
  elsif request.page_type == 'blog' and blog
    if seo_description == blank
      assign seo_description = 'Guides on luxury marble furniture, natural stone finishes and interior design from ' | append: brand | append: '.'
    endif
    if page_title == blank or page_title == blog.title or page_title == 'Journal'
      assign seo_title = brand | append: ' Journal | Marble Furniture UAE'
    endif
  elsif request.page_type == 'list-collections'
    # /collections is the canonical collections index, but list-collections has
    # no SEO fields in Admin, so it rendered as bare "Collections" with the
    # generic brand description. The descriptive metadata previously lived on
    # the /pages/collections duplicate that now canonicalises here.
    assign seo_title = 'Marble Furniture Collections UAE | ' | append: brand
    if seo_description == blank
      assign seo_description = 'The 9 marble collection from NEROCASA. Coffee, side and console tables made in Sharjah Industrial Area 15 and delivered across the UAE.'
    endif
  elsif request.page_type == 'index'
    if page_title == blank or page_title == shop.name or page_title contains 'Luxury Marble Furniture'
      assign seo_title = brand | append: ' | Marble Furniture UAE'
    endif
    unless seo_title contains 'UAE'
      assign seo_title = brand | append: ' | Marble Furniture UAE'
    endunless
    if seo_description == blank
      assign seo_description = tagline
    endif
    unless seo_description contains 'Sharjah' or seo_description contains 'UAE'
      assign seo_description = tagline
    endunless
  elsif request.page_type == 'search'
    assign seo_title = brand | append: ' | The 9'
    if seo_description == blank
      assign seo_description = brand | append: ' marble furniture. Nine made-to-order pieces from Sharjah, delivered across the UAE.'
    endif
  endif

  if seo_description == blank
    assign seo_description = brand | append: '. ' | append: tagline
  endif

  assign seo_title = seo_title | replace: '&amp;', '&' | replace: '| NeroCasa', '| NEROCASA' | replace: '| Nero Casa', '| NEROCASA'
  assign seo_description = seo_description | replace: '&amp;', '&'

  if og_image == blank and settings.logo != blank
    assign og_image = settings.logo | image_url: width: 1200
  endif
  if og_image == blank
    assign og_image = 'nerocasa-brand-logo.jpg' | asset_url
  endif

  # /pages/collections and the native /collections route render the same
  # ncs-collections-index section. Canonicalise the page template to
  # /collections so the two do not compete as duplicates.
  if request.page_type == 'page' and page.template_suffix == 'collections'
    assign page_url = shop.url | append: routes.collections_url
  endif
  if request.page_type == 'collection' and collection.handle == 'all'
    assign page_url = shop.url | append: '/collections/' | append: the_9_handle
  endif

  if settings.logo != blank
    assign brand_logo = settings.logo | image_url: width: 600
  else
    assign brand_logo = 'nerocasa-brand-logo.jpg' | asset_url
  endif
  if brand_logo contains 'https:'
    assign brand_logo = brand_logo
  else
    assign brand_logo = brand_logo | prepend: 'https:'
  endif

  if og_image != blank
    if og_image contains 'https:'
      assign og_image_abs = og_image
    else
      assign og_image_abs = og_image | prepend: 'https:'
    endif
  endif

  assign seo_noindex = false
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'gift_card'
    assign seo_noindex = true
  endif
  if request.path contains '/account' or request.path contains '/policies/'
    assign seo_noindex = true
  endif
  if request.page_type == 'collection' and collection.handle == 'all'
    assign seo_noindex = true
  endif
-%}

<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ seo_description | escape }}">
<link rel="canonical" href="{{ page_url }}">
{%- comment -%}
  Search, cart and account pages canonicalise to themselves, so every ?q=
  permutation was a separate indexable URL with no unique content. Keep them
  crawlable (follow) so link equity still reaches the products.
{%- endcomment -%}
{%- if seo_noindex -%}
<meta name="robots" content="noindex,follow">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ seo_description | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_image_abs != blank -%}
<meta property="og:image" content="{{ og_image_abs }}">
<meta property="og:image:secure_url" content="{{ og_image_abs }}">
<meta property="og:image:alt" content="{{ seo_title | escape }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if og_image_abs != blank -%}
<meta name="twitter:image" content="{{ og_image_abs }}">
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
{%- liquid
  capture schema_h
    render 'nc-product-field', product: product, handle: product.handle, field: 'height'
  endcapture
  capture schema_l
    render 'nc-product-field', product: product, handle: product.handle, field: 'length'
  endcapture
  capture schema_w
    render 'nc-product-field', product: product, handle: product.handle, field: 'width'
  endcapture
  capture schema_d
    render 'nc-product-field', product: product, handle: product.handle, field: 'depth'
  endcapture
  assign schema_h = schema_h | strip
  assign schema_l = schema_l | strip
  assign schema_w = schema_w | strip
  assign schema_d = schema_d | strip

  # Catalog records either height/length/width (tables) or height/width/depth
  # (side tables). Schema.org wants width as the horizontal span and depth as
  # front-to-back, so length maps to width when it is present.
  if schema_l != blank
    assign schema_span = schema_l
    assign schema_front = schema_w
  else
    assign schema_span = schema_w
    assign schema_front = schema_d
  endif
  assign nc_ship_id = shop.url | append: '#shipping-policy'
  assign nc_return_id = shop.url | append: '#return-policy'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ seo_description | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ brand | json }}
  },
  "url": {{ page_url | json }},
  "material": "Natural stone",
  {%- if product.type != blank %}
  "category": {{ product.type | json }},
  {%- endif %}
  {%- if product.selected_or_first_available_variant.sku != blank %}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  {%- if schema_h != blank %}
  "height": { "@type": "QuantitativeValue", "value": {{ schema_h | times: 1 }}, "unitCode": "CMT" },
  {%- endif %}
  {%- if schema_span != blank %}
  "width": { "@type": "QuantitativeValue", "value": {{ schema_span | times: 1 }}, "unitCode": "CMT" },
  {%- endif %}
  {%- if schema_front != blank %}
  "depth": { "@type": "QuantitativeValue", "value": {{ schema_front | times: 1 }}, "unitCode": "CMT" },
  {%- endif %}
  {%- if product.images.size > 0 %}
  "image": [
    {%- for product_image in product.images limit: 4 -%}
    {{ product_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ variant.url | prepend: shop.url | json }},
      "priceCurrency": {{ shop.currency | json }},
      "price": {{ variant.price | divided_by: 100.0 }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if variant.available %}{% if variant.inventory_quantity > 0 %}InStock{% else %}PreOrder{% endif %}{% else %}OutOfStock{% endif %}",
      "shippingDetails": [{
        {%- if forloop.first -%}
        "@type": "OfferShippingDetails",
        "@id": {{ nc_ship_id | json }},
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": {{ shop.currency | json }}
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "AE"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 3,
            "maxValue": 7,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 3,
            "unitCode": "DAY"
          }
        }
        {%- else -%}
        "@id": {{ nc_ship_id | json }}
        {%- endif -%}
      }],
      "hasMerchantReturnPolicy": [{
        {%- if forloop.first -%}
        "@type": "MerchantReturnPolicy",
        "@id": {{ nc_return_id | json }},
        "applicableCountry": "AE",
        "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
        "merchantReturnLink": {{ shop.url | append: '/pages/refunds' | json }}
        {%- else -%}
        "@id": {{ nc_return_id | json }}
        {%- endif -%}
      }]
      {%- if variant.sku != blank -%},
      "sku": {{ variant.sku | json }}
      {%- endif -%}
      {%- if variant.title != blank -%},
      "name": {{ variant.title | json }}
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value != blank -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
    "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
  }
  {%- endif -%}
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ seo_description | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": {
    "@type": "Organization",
    "name": {{ brand | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ brand_logo | json }}
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ page_url | json }}
  },
  {%- if og_image_abs != blank -%}
  "image": [{{ og_image_abs | json }}],
  {%- endif -%}
  "url": {{ page_url | json }}
}
</script>
{%- endif -%}

{%- comment -%}
  Organization and WebSite describe the brand entity itself, so they belong on
  the home page only. Repeating them on every template would declare the same
  entity dozens of times over.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Organization", "FurnitureStore"],
  "name": {{ shop.name | json }},
  "alternateName": {{ brand | json }},
  "url": {{ shop.url | json }},
  "logo": {{ brand_logo | json }},
  "description": {{ tagline | json }},
  "parentOrganization": {
    "@type": "Organization",
    "name": "AL SOURAH AL THAHABIA MARBLE AND GRANITE L.L.C",
    "identifier": "1253846"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ workshop_address | json }},
    "addressLocality": "Sharjah",
    "addressRegion": "Sharjah",
    "addressCountry": "AE"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United Arab Emirates"
  },
  {%- assign social_profiles = '' -%}
  {%- if settings.instagram_url != blank -%}
    {%- assign social_profiles = settings.instagram_url -%}
  {%- endif -%}
  {%- if settings.pinterest_url != blank -%}
    {%- if social_profiles != blank -%}
      {%- assign social_profiles = social_profiles | append: '|' | append: settings.pinterest_url -%}
    {%- else -%}
      {%- assign social_profiles = settings.pinterest_url -%}
    {%- endif -%}
  {%- endif -%}
  {%- if social_profiles != blank %}
  "sameAs": [
    {%- assign social_list = social_profiles | split: '|' -%}
    {%- for profile in social_list -%}
    {{ profile | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "areaServed": "AE",
    "availableLanguage": ["English", "Arabic"]
    {%- if settings.contact_phone != blank -%},
    "telephone": {{ settings.contact_phone | replace: ' ', '' | json }}
    {%- endif -%}
    {%- if settings.contact_email != blank -%},
    "email": {{ settings.contact_email | json }}
    {%- endif -%}
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
}
</script>
{%- liquid
  assign nav_collections = routes.collections_url | prepend: shop.url
  assign nav_custom = pages[settings.page_custom_handle].url | default: '/pages/custom' | prepend: shop.url
  assign nav_b2b = pages[settings.page_b2b_handle].url | default: '/pages/b2b' | prepend: shop.url
  assign nav_about = pages[settings.page_about_handle].url | default: '/pages/why-nerocasa' | prepend: shop.url
  assign nav_journal_path = blogs[settings.blog_handle].url | default: '/blogs/journal'
  assign nav_journal = nav_journal_path | prepend: shop.url
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "NEROCASA",
  "itemListElement": [
    { "@type": "SiteNavigationElement", "position": 1, "name": "Home", "url": {{ shop.url | append: routes.root_url | json }} },
    { "@type": "SiteNavigationElement", "position": 2, "name": "Collections", "url": {{ nav_collections | json }} },
    { "@type": "SiteNavigationElement", "position": 3, "name": "Custom", "url": {{ nav_custom | json }} },
    { "@type": "SiteNavigationElement", "position": 4, "name": "B2B", "url": {{ nav_b2b | json }} },
    { "@type": "SiteNavigationElement", "position": 5, "name": "Why Nerocasa", "url": {{ nav_about | json }} },
    { "@type": "SiteNavigationElement", "position": 6, "name": "Journal", "url": {{ nav_journal | json }} }
  ]
}
</script>
{%- endif -%}

{%- comment -%}
  BreadcrumbList is emitted for every inner page type. It is invisible to
  visitors — there is no breadcrumb UI in this theme — but it gives search
  engines the site hierarchy the navigation implies.
{%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'article' or request.page_type == 'blog' or request.page_type == 'list-collections' -%}
{%- liquid
  assign crumb_names = ''
  assign crumb_urls = ''

  case request.page_type
    when 'product'
      assign parent_collection = blank
      assign coffee_handle = settings.collection_coffee | default: 'coffee-tables'
      assign side_handle = settings.collection_side | default: 'side-tables'
      assign console_handle = settings.collection_console | default: 'console-tables'
      for coll in product.collections
        if coll.handle == coffee_handle or coll.handle == side_handle or coll.handle == console_handle
          assign parent_collection = coll
          break
        endif
      endfor
      if parent_collection == blank
        assign parent_collection = product.collections.first
      endif
      if parent_collection != blank
        assign crumb_names = parent_collection.title
        assign crumb_urls = shop.url | append: parent_collection.url
      endif
      if crumb_names != blank
        assign crumb_names = crumb_names | append: '|' | append: product.title
        assign crumb_urls = crumb_urls | append: '|' | append: shop.url | append: product.url
      else
        assign crumb_names = product.title
        assign crumb_urls = shop.url | append: product.url
      endif
    when 'collection'
      assign crumb_names = 'Collections|' | append: collection.title
      assign crumb_urls = shop.url | append: routes.collections_url | append: '|' | append: shop.url | append: collection.url
    when 'list-collections'
      assign crumb_names = 'Collections'
      assign crumb_urls = shop.url | append: routes.collections_url
    when 'page'
      assign crumb_names = page.title
      assign crumb_urls = page_url
    when 'blog'
      assign crumb_names = blog.title
      assign crumb_urls = shop.url | append: blog.url
    when 'article'
      assign crumb_names = blog.title | append: '|' | append: article.title
      assign crumb_urls = shop.url | append: blog.url | append: '|' | append: shop.url | append: article.url
  endcase

  assign crumb_name_list = crumb_names | split: '|'
  assign crumb_url_list = crumb_urls | split: '|'
-%}
{%- if crumb_name_list.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | append: routes.root_url | json }}
    },
    {%- for crumb_name in crumb_name_list -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index | plus: 1 }},
      "name": {{ crumb_name | json }},
      "item": {{ crumb_url_list[forloop.index0] | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- endif -%}

{%- if request.page_type == 'collection' and collection and collection.handle != 'all' and collection.products_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ seo_title | json }},
  "description": {{ seo_description | json }},
  "url": {{ page_url | json }},
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- for list_product in collection.products limit: 24 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": {{ list_product.title | json }},
        "url": {{ shop.url | append: list_product.url | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'list-collections' -%}
{%- liquid
  assign coffee_handle_ld = settings.collection_coffee | default: 'coffee-tables'
  assign side_handle_ld = settings.collection_side | default: 'side-tables'
  assign console_handle_ld = settings.collection_console | default: 'console-tables'
  assign coffee_coll_ld = collections[coffee_handle_ld]
  assign side_coll_ld = collections[side_handle_ld]
  assign console_coll_ld = collections[console_handle_ld]
  assign the_9_coll_ld = collections[the_9_handle]
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ seo_title | json }},
  "url": {{ page_url | json }},
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- if the_9_coll_ld != blank -%}
      { "@type": "ListItem", "position": 1, "name": {{ the_9_coll_ld.title | json }}, "url": {{ shop.url | append: the_9_coll_ld.url | json }} }
      {%- if coffee_coll_ld != blank or side_coll_ld != blank or console_coll_ld != blank -%},{%- endif -%}
      {%- endif -%}
      {%- if coffee_coll_ld != blank -%}
      { "@type": "ListItem", "position": 2, "name": {{ coffee_coll_ld.title | json }}, "url": {{ shop.url | append: coffee_coll_ld.url | json }} }
      {%- if side_coll_ld != blank or console_coll_ld != blank -%},{%- endif -%}
      {%- endif -%}
      {%- if side_coll_ld != blank -%}
      { "@type": "ListItem", "position": 3, "name": {{ side_coll_ld.title | json }}, "url": {{ shop.url | append: side_coll_ld.url | json }} }
      {%- if console_coll_ld != blank -%},{%- endif -%}
      {%- endif -%}
      {%- if console_coll_ld != blank -%}
      { "@type": "ListItem", "position": 4, "name": {{ console_coll_ld.title | json }}, "url": {{ shop.url | append: console_coll_ld.url | json }} }
      {%- endif -%}
    ]
  }
}
