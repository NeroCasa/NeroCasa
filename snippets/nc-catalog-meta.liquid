{%- comment -%}
  Catalog metadata for a product handle.
  @param handle {String} e.g. cft-1
  @param field {String} name | category | height | length | width | depth
  Values are bare numbers (cm) for dimensions; empty when not applicable.
{%- endcomment -%}
{%- liquid
  assign field = field | default: 'name'
  case handle
    when 'cft-1'
      case field
        when 'name'
          echo 'Soglia'
        when 'category'
          echo 'Coffee Table'
        when 'height'
          echo '35'
        when 'length'
          echo '160'
        when 'width'
          echo '90'
      endcase
    when 'cft-2'
      case field
        when 'name'
          echo 'Equilibrio'
        when 'category'
          echo 'Coffee Table'
        when 'height'
          echo '60'
        when 'length'
          echo '100'
        when 'depth'
          echo '40'
      endcase
    when 'cft-3'
      case field
        when 'name'
          echo 'Monolite'
        when 'category'
          echo 'Coffee Table'
        when 'height'
          echo '45'
        when 'length'
          echo '100'
        when 'width'
          echo '40'
      endcase
    when 'cs-1'
      case field
        when 'name'
          echo 'Galleria'
        when 'category'
          echo 'Console Table'
        when 'height'
          echo '160'
        when 'width'
          echo '35'
        when 'length'
          echo '90'
      endcase
    when 'cs-2'
      case field
        when 'name'
          echo 'Passaggio'
        when 'category'
          echo 'Console Table'
        when 'height'
          echo '40'
        when 'width'
          echo '30'
        when 'length'
          echo '140'
      endcase
    when 'cs-3'
      case field
        when 'name'
          echo 'Atrio'
        when 'category'
          echo 'Console Table'
        when 'height'
          echo '90'
        when 'width'
          echo '35'
        when 'length'
          echo '175'
      endcase
    when 'sd-1'
      case field
        when 'name'
          echo 'Nodo'
        when 'category'
          echo 'Side Table'
        when 'height'
          echo '60'
        when 'width'
          echo '30'
        when 'depth'
          echo '18'
      endcase
    when 'sd-2'
      case field
        when 'name'
          echo 'Punto'
        when 'category'
          echo 'Side Table'
        when 'height'
          echo '50'
        when 'width'
          echo '40'
        when 'depth'
          echo '40'
      endcase
    when 'sd-3'
      case field
        when 'name'
          echo 'Scalino'
        when 'category'
          echo 'Side Table'
        when 'height'
          echo '35'
        when 'width'
          echo '40'
        when 'depth'
          echo '25'
      endcase
  endcase
-%}
