{%- comment -%}
  Default marble label for catalog product hero (pairs with nc-catalog-default-img).
  @param handle {String} product handle e.g. cft-1
{%- endcomment -%}
{%- liquid
  case handle
    when 'cft-1', 'soglia', 'cs-2', 'passaggio', 'sd-3', 'scalino'
      echo 'Ibiza White'
    when 'cft-2', 'equilibrio', 'cs-3', 'atrio', 'sd-1', 'nodo'
      echo 'Armani Grey'
    when 'cft-3', 'monolite'
      echo 'Rosso Levanto'
    when 'cs-1', 'galleria', 'sd-2', 'punto'
      echo 'Travertine'
    else
      echo 'Ibiza White'
  endcase
-%}
