{%- comment -%}
  Default product image — Shopify Admin media only.
  @param handle {String} product handle
  @param product {Product} optional
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank and handle != blank
    assign p = all_products[handle]
  endif

  if p != blank and p.featured_image != blank
    echo p.featured_image | image_url: width: 1800
  elsif p != blank and p.images.size > 0
    echo p.images.first | image_url: width: 1800
  endif
-%}
