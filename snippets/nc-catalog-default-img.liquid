{%- comment -%}
  Default hero image per catalog product handle (distinct marble per piece).
  @param handle {String} product handle e.g. cft-1
{%- endcomment -%}
{%- liquid
  case handle
    when 'cft-1'
      echo 'cft-1-ibiza-white-v2.jpg' | asset_url
    when 'cft-2'
      echo 'cft-2-armani-grey-v2.jpg' | asset_url
    when 'cft-3'
      echo 'cft-3-rosso-levanto-v2.jpg' | asset_url
    when 'cs-1'
      echo 'cs-1-travertine-v2.jpg' | asset_url
    when 'cs-2'
      echo 'cs-2-ibiza-white-v2.jpg' | asset_url
    when 'cs-3'
      echo 'cs-3-armani-grey-v2.jpg' | asset_url
    when 'sd-1'
      echo 'sd-1-armani-grey-v2.jpg' | asset_url
    when 'sd-2'
      echo 'sd-2-travertine-v2.jpg' | asset_url
    when 'sd-3'
      echo 'sd-3-ibiza-white-v2.jpg' | asset_url
    else
      echo handle | append: '-ibiza-white-v2.jpg' | asset_url
  endcase
-%}
