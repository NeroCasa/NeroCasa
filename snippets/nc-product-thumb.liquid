{%- comment -%}
  Product thumbnail — Shopify image or theme catalog fallback.
  Expects product handle: cft-1, cft-2, cft-3, cs-1, cs-2, cs-3, sd-1, sd-2, sd-3
{%- endcomment -%}
{%- assign fallback_asset = 'products/' | append: product.handle | append: '-ibiza-white.jpg' -%}
{%- if product.featured_image -%}
  {{ product.featured_image | image_url: width: 1600 }}
{%- else -%}
  {{ fallback_asset | asset_url }}
{%- endif -%}
