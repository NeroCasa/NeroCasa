{% comment %}
  Balanced page hero shell. Pass captured inner markup as `body`.
  Params: slab_left, slab_center, slab_right; left_image, center_image, right_image;
          quiet (boolean) — no marble wallpaper.
{% endcomment %}
<div class="ncs-page-hero-shell{% if quiet %} ncs-page-hero-shell--quiet{% endif %}">
  {%- unless quiet -%}
    <div class="ncs-hero-media" aria-hidden="true">
      {% render 'nc-hero-marble-bg',
        mode: 'triple',
        slab_left: slab_left,
        slab_center: slab_center,
        slab_right: slab_right,
        left_image: left_image,
        center_image: center_image,
        right_image: right_image
      %}
    </div>
  {%- endunless -%}
  {{ body }}
</div>
