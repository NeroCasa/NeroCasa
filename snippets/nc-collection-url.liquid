{%- comment -%}
  Outputs a collection URL.
  @param handle {String} Collection handle
{%- endcomment -%}
{%- liquid
  assign coll = collections[handle]
  if coll != blank
    echo coll.url
  else
    capture collections_index
      render 'nc-collections-index-url'
    endcapture
    echo collections_index | strip
  endif
-%}
