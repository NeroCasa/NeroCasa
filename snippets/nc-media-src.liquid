{%- comment -%}
  Resolve a media URL from an optional Theme Editor image, else a theme asset filename.
  @param image {Image} optional image_picker value
  @param asset {String} optional asset filename e.g. hero-slab-white.jpg
  @param width {Number} optional, default 1600
{%- endcomment -%}
{%- liquid
  assign media_width = width | default: 1600
  if image != blank
    echo image | image_url: width: media_width
  elsif asset != blank
    # asset_url serves the file at full size. asset_img_url runs it through the
    # CDN resizer so hero slabs can ship a mobile-sized variant instead of the
    # full 1024x1536 original.
    assign asset_size = media_width | append: 'x'
    echo asset | asset_img_url: asset_size
  endif
-%}
