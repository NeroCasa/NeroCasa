<section class="ncs-search-page">
  <header class="ncs-search-hero" data-nc-reveal>
    {% if search.performed %}
      <h1>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</h1>
      <p>For “{{ search.terms }}”</p>
    {% else %}
      <h1>Find your <em>object</em></h1>
      <p>Search by product name, collection, or product number.</p>
    {% endif %}
  </header>

  <form action="{{ routes.search_url }}" method="get" role="search" class="ncs-search-page-form" data-nc-reveal>
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, collections…" aria-label="Search">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="ncs-btn">Search ↗</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="ncs-empty ncs-search-empty">No results found. Try a product name, collection, or product number.</p>
    {% else %}
      {% paginate search.results by 24 %}
      <div class="ncs-grid-products ncs-search-results">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <a class="ncs-card" href="{{ item.url }}" data-nc-reveal>
              <div class="ncs-card-media">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 1400 }}" alt="{{ item.title | escape }}" loading="lazy" width="700" height="875">
                {% else %}
                  <img src="{{ 'hero-marble.svg' | asset_url }}" alt="{{ item.title | escape }}" loading="lazy">
                {% endif %}
              </div>
              <div class="ncs-card-info"><span>{{ item.title }}</span><b>{{ item.price | money }}</b></div>
            </a>
          {% elsif item.object_type == 'page' or item.object_type == 'article' %}
            <a class="ncs-card ncs-card-page" href="{{ item.url }}" data-nc-reveal>
              <div class="ncs-card-info"><span>{{ item.title }}</span><b>{{ item.object_type | capitalize }}</b></div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <div class="ncs-pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}
        </div>
      {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
{% schema %}{"name":"Search","presets":[{"name":"Search"}]}{% endschema %}
