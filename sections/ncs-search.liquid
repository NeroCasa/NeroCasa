<section class="ncs-search-page">
  {%- capture nc_hero_body -%}
  <header class="ncs-search-hero ncs-page-hero ncs-page-hero--compact" data-nc-reveal>
    {%- assign the_9_heading = 'The 9' -%}
    <h1>{% render 'nc-title-gold', title: the_9_heading %}</h1>
    <p>Nine made-to-order pieces. Browse the collection.</p>
  </header>
  {%- endcapture -%}
  {% render 'nc-page-hero-shell',
    quiet: true,
    body: nc_hero_body,
    slab_left: 'hero-slab-white.jpg',
    slab_center: 'hero-slab-green.jpg',
    slab_right: 'hero-slab-grey.jpg'
  %}

  {%- assign empty_collection = collections['the-9'] -%}
  {%- if empty_collection != blank -%}
    <div class="ncs-cart-empty" data-nc-reveal>
      <div class="ncs-cart-empty-card">
        {% render 'nc-collection-tile', collection: empty_collection %}
      </div>
      {%- assign cta_collection = 'actions.our_collection' | t -%}
      <a class="ncs-btn" href="{% render 'nc-collections-index-url' %}">{% render 'nc-title-gold', title: cta_collection %}</a>
    </div>
  {%- else -%}
    <p class="ncs-empty" data-nc-reveal>
      <a href="{% render 'nc-collections-index-url' %}">{{ 'actions.our_collection' | t }}</a>
    </p>
  {%- endif -%}
</section>
{% schema %}{"name":"Search","presets":[{"name":"Search"}]}{% endschema %}
