<section class="ncs-home-hero">
  <div class="ncs-hero-media">
    {% render 'nc-hero-marble-bg',
      mode: 'triple',
      slab_left: 'hero-slab-white.jpg',
      slab_center: 'hero-slab-red.jpg',
      slab_right: 'hero-slab-green.jpg'
    %}
  </div>
  <div class="ncs-hero-content">
    <h1><span>NE<span>RO</span></span><span class="nc-gold">CASA</span></h1>
    <p class="ncs-hero-tagline">{{ section.settings.hero_tagline | default: settings.brand_tagline }}</p>
    <a class="ncs-btn ncs-btn--ghost ncs-hero-cta" href="{% render 'nc-collections-index-url' %}">Explore collections ↗</a>
  </div>
</section>

<section class="ncs-home-values" data-nc-reveal>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_1_title %}</h2>
    <p>{{ section.settings.value_1_text }}</p>
  </article>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_2_title %}</h2>
    <p>{{ section.settings.value_2_text }}</p>
  </article>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_3_title %}</h2>
    <p>{{ section.settings.value_3_text }}</p>
  </article>
</section>

<section class="ncs-home-story" data-nc-reveal>
  <div class="ncs-home-story-copy">
    <span class="ncs-page-kicker">Why Nerocasa</span>
    <h2>{% render 'nc-title-gold', title: section.settings.story_heading %}</h2>
    <p>{{ section.settings.story_text }}</p>
    <a class="ncs-btn ncs-btn--outline" href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}">Our story ↗</a>
  </div>
  <div class="ncs-home-story-visual ncs-brand-visual-frame">
    <img src="{% render 'nc-brand-visual' %}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="900" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "Nerocasa Store Home",
  "settings": [
    {
      "type": "textarea",
      "id": "hero_tagline",
      "label": "Hero tagline",
      "default": "Real marble furniture. From our factory to your home."
    },
    {
      "type": "header",
      "content": "Value strip"
    },
    {
      "type": "text",
      "id": "value_1_title",
      "label": "Value 1 title",
      "default": "From our workshop"
    },
    {
      "type": "textarea",
      "id": "value_1_text",
      "label": "Value 1 text",
      "default": "We design, cut and finish under one roof. When you order, we begin work on your piece with the care it deserves."
    },
    {
      "type": "text",
      "id": "value_2_title",
      "label": "Value 2 title",
      "default": "Stone from anywhere"
    },
    {
      "type": "textarea",
      "id": "value_2_text",
      "label": "Value 2 text",
      "default": "We import marble from quarries worldwide and can source the stone you want, from any origin on earth. Every piece is then cut and finished in our own factory."
    },
    {
      "type": "text",
      "id": "value_3_title",
      "label": "Value 3 title",
      "default": "Marble for every home"
    },
    {
      "type": "textarea",
      "id": "value_3_text",
      "label": "Value 3 text",
      "default": "Living with stone should not be reserved for a few. We exist so more people can own real marble, beautifully made and fairly priced."
    },
    {
      "type": "header",
      "content": "Story teaser"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Stone you live with"
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story text",
      "default": "NeroCasa imports marble and manufactures in its own workshop. We do not buy ready-made products from outside. Every piece is made when you order, with the attention we would want in our own home."
    }
  ],
  "presets": [{ "name": "Nerocasa Store Home" }]
}
{% endschema %}
