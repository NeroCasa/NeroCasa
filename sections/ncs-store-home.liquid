<section class="ncs-home-hero">
  <div class="ncs-hero-media">
    {% if settings.hero_image != blank %}
      <img src="{{ settings.hero_image | image_url: width: 2400 }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} marble furniture" width="2400" height="1600" fetchpriority="high">
    {% else %}
      {% capture hero_image %}{% render 'nc-showcase-image', pool: 'hero' %}{% endcapture %}
      <img src="{{ hero_image | strip }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} marble furniture" width="2400" height="1600" fetchpriority="high">
    {% endif %}
    <div class="ncs-hero-overlay"></div>
  </div>
  <div class="ncs-hero-content">
    <h1><span>NE<span>RO</span></span><span class="nc-gold">CASA</span></h1>
    <p class="ncs-hero-tagline">{{ section.settings.hero_tagline | default: settings.brand_tagline }}</p>
    <a class="ncs-btn ncs-btn--ghost ncs-hero-cta" href="{% render 'nc-collections-index-url' %}">Explore collections ↗</a>
  </div>
</section>

<section class="ncs-home-values" data-nc-reveal>
  <article class="ncs-home-value">
    <span class="ncs-home-value-num">01</span>
    <h2>{{ section.settings.value_1_title }}</h2>
    <p>{{ section.settings.value_1_text }}</p>
  </article>
  <article class="ncs-home-value">
    <span class="ncs-home-value-num">02</span>
    <h2>{{ section.settings.value_2_title }}</h2>
    <p>{{ section.settings.value_2_text }}</p>
  </article>
  <article class="ncs-home-value">
    <span class="ncs-home-value-num">03</span>
    <h2>{{ section.settings.value_3_title }}</h2>
    <p>{{ section.settings.value_3_text }}</p>
  </article>
</section>

<section class="ncs-home-story" data-nc-reveal>
  <div class="ncs-home-story-copy">
    <span class="ncs-page-kicker">Why Nerocasa</span>
    <h2>{{ section.settings.story_heading }}</h2>
    <p>{{ section.settings.story_text }}</p>
    <a class="ncs-btn ncs-btn--outline" href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}">Our story ↗</a>
  </div>
  <div class="ncs-home-story-visual">
    {% capture story_image %}{% render 'nc-showcase-image', pool: 'about' %}{% endcapture %}
    <img src="{{ story_image | strip }}" alt="" width="1200" height="900" loading="lazy">
  </div>
</section>

<section class="ncs-mail ncs-cta">
  <div class="ncs-cta-title" data-nc-reveal><h2>{{ section.settings.newsletter_heading }}</h2></div>
  <p class="ncs-cta-sub" data-nc-reveal>{{ section.settings.newsletter_subtext }}</p>
  {% form 'customer', class: 'ncs-mail-form' %}
    {% if form.posted_successfully? %}
      <p class="ncs-form-success">Thank you. You are on the list.</p>
    {% else %}
      <input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email address">
      <button type="submit" class="ncs-btn ncs-btn--compact" aria-label="Subscribe">Subscribe ↗</button>
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Nerocasa Store Home",
  "settings": [
    {
      "type": "textarea",
      "id": "hero_tagline",
      "label": "Hero tagline",
      "default": "Real marble furniture. From our factory to your home."
    },
    {
      "type": "header",
      "content": "Value strip"
    },
    {
      "type": "text",
      "id": "value_1_title",
      "label": "Value 1 title",
      "default": "Factory direct"
    },
    {
      "type": "textarea",
      "id": "value_1_text",
      "label": "Value 1 text",
      "default": "We design, cut and finish under one roof. No showroom layers between the slab and your home."
    },
    {
      "type": "text",
      "id": "value_2_title",
      "label": "Value 2 title",
      "default": "Genuine stone"
    },
    {
      "type": "textarea",
      "id": "value_2_text",
      "label": "Value 2 text",
      "default": "Every piece is carved from real natural marble and stone. Honest material, honestly finished."
    },
    {
      "type": "text",
      "id": "value_3_title",
      "label": "Value 3 title",
      "default": "Made for living"
    },
    {
      "type": "textarea",
      "id": "value_3_text",
      "label": "Value 3 text",
      "default": "Marble belongs in everyday rooms, not only in showrooms. We keep the craft high and the price fair."
    },
    {
      "type": "header",
      "content": "Story teaser"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Marble you can fall in love with"
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story text",
      "default": "NeroCasa is a brand with its own production. That is why our tables cost less than comparable pieces on the market, without ever compromising the stone, the finish, or the way we treat you."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay close"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "New designs, stone arrivals, and quiet notes from the workshop."
    }
  ],
  "presets": [{ "name": "Nerocasa Store Home" }]
}
{% endschema %}
