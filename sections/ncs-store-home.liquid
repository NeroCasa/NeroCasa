<section class="ncs-home-hero">
  <div class="ncs-hero-media">
    {% if section.settings.hero_image != blank or settings.hero_image != blank %}
      {%- assign home_hero = section.settings.hero_image | default: settings.hero_image -%}
      <img
        class="ncs-home-hero-photo"
        src="{{ home_hero | image_url: width: 2400 }}"
        alt=""
        width="2400"
        height="1600"
        fetchpriority="high"
      >
      <div class="ncs-hero-overlay"></div>
    {% else %}
      {% render 'nc-hero-marble-bg',
        mode: 'triple',
        slab_left: 'hero-slab-white.jpg',
        slab_center: 'hero-slab-red.jpg',
        slab_right: 'hero-slab-green.jpg',
        left_image: section.settings.hero_slab_left,
        center_image: section.settings.hero_slab_center,
        right_image: section.settings.hero_slab_right
      %}
    {% endif %}
  </div>
  <div class="ncs-hero-content">
    <h1>NERO<span class="nc-gold">CASA</span></h1>
    <p class="ncs-hero-tagline">{{ section.settings.hero_tagline | default: 'Furniture in stone.' }}</p>
    <a class="ncs-btn ncs-btn--ghost ncs-hero-cta" href="{% render 'nc-collections-index-url' %}">The collection</a>
  </div>
</section>

<section class="ncs-home-maison">
  <article class="ncs-home-family">
    <header class="ncs-home-family-head">
      <h2>{% render 'nc-title-gold', title: 'The collection' %}</h2>
      <a href="{% render 'nc-collections-index-url' %}">View all</a>
    </header>
    <div class="ncs-grid-products">
      {%- assign home_coffee = all_products['cft-3'] -%}
      {%- assign home_side = all_products['sd-1'] -%}
      {%- assign home_console = all_products['cs-1'] -%}
      {%- if home_coffee != blank -%}
        {% render 'nc-catalog-card', shop_product: home_coffee %}
      {%- endif -%}
      {%- if home_side != blank -%}
        {% render 'nc-catalog-card', shop_product: home_side %}
      {%- endif -%}
      {%- if home_console != blank -%}
        {% render 'nc-catalog-card', shop_product: home_console %}
      {%- endif -%}
    </div>
  </article>
</section>

<section class="ncs-home-values" data-nc-reveal>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_1_title %}</h2>
    <p>{{ section.settings.value_1_text }}</p>
  </article>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_2_title %}</h2>
    <p>{{ section.settings.value_2_text }}</p>
  </article>
  <article class="ncs-home-value">
    <h2>{% render 'nc-title-gold', title: section.settings.value_3_title %}</h2>
    <p>{{ section.settings.value_3_text }}</p>
  </article>
</section>

<section class="ncs-home-story" data-nc-reveal>
  <div class="ncs-home-story-copy">
    <span class="ncs-page-kicker">Why Nerocasa</span>
    <h2>{% render 'nc-title-gold', title: section.settings.story_heading %}</h2>
    <p>{{ section.settings.story_text }}</p>
    <a class="ncs-btn ncs-btn--outline" href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}">The house</a>
  </div>
  <div class="ncs-home-story-visual ncs-brand-visual-frame">
    <img src="{% render 'nc-brand-visual' %}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="1200" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "Nerocasa Store Home",
  "settings": [
    {
      "type": "textarea",
      "id": "hero_tagline",
      "label": "Hero tagline",
      "default": "Furniture in stone."
    },
    {
      "type": "header",
      "content": "Hero images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Full-bleed hero photo",
      "info": "Optional. Replaces the three marble slabs when set. You can also set Brand → Home hero image."
    },
    {
      "type": "image_picker",
      "id": "hero_slab_left",
      "label": "Hero slab — left"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_center",
      "label": "Hero slab — center"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_right",
      "label": "Hero slab — right"
    },
    {
      "type": "header",
      "content": "Value strip"
    },
    {
      "type": "text",
      "id": "value_1_title",
      "label": "Value 1 title",
      "default": "Under one roof"
    },
    {
      "type": "textarea",
      "id": "value_1_text",
      "label": "Value 1 text",
      "default": "We design, cut and finish in our own workshop. When you order, work on your piece begins here."
    },
    {
      "type": "text",
      "id": "value_2_title",
      "label": "Value 2 title",
      "default": "Quarried, then cut here"
    },
    {
      "type": "textarea",
      "id": "value_2_text",
      "label": "Value 2 text",
      "default": "Marble from quarries worldwide, cut and finished in our workshop. The origin you want, made under our roof."
    },
    {
      "type": "text",
      "id": "value_3_title",
      "label": "Value 3 title",
      "default": "Made to be lived with"
    },
    {
      "type": "textarea",
      "id": "value_3_text",
      "label": "Value 3 text",
      "default": "Stone for rooms that are used, not staged. Pieces made to hold a life around them."
    },
    {
      "type": "header",
      "content": "Story teaser"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Stone you live with"
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story text",
      "default": "NEROCASA imports premium marble from quarries worldwide and crafts luxury furniture in its own workshop. Real stone, architectural design and the finish we would choose for our own homes."
    }
  ],
  "presets": [{ "name": "Nerocasa Store Home" }]
}
{% endschema %}
