<section class="ncs-home-hero">
  <div class="ncs-hero-media">
    {% if settings.hero_image != blank %}
      <img src="{{ settings.hero_image | image_url: width: 2400 }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} marble furniture" width="2400" height="1600" fetchpriority="high">
    {% else %}
      {% capture hero_image %}{% render 'nc-showcase-image', pool: 'hero' %}{% endcapture %}
      <img src="{{ hero_image | strip }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} marble furniture" width="2400" height="1600" fetchpriority="high">
    {% endif %}
    <div class="ncs-hero-overlay"></div>
  </div>
  <div class="ncs-hero-content">
    <h1><span>NE<span>RO</span></span><span class="nc-gold">CASA</span></h1>
    <p class="ncs-hero-tagline">{{ settings.brand_tagline | default: 'Architectural marble furniture, made to order' }}</p>
  </div>
</section>

<section class="ncs-collections">
  <div class="ncs-section-head" data-nc-reveal><h2>Collections</h2></div>
  <div class="ncs-collection-grid">
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_coffee %}" data-nc-reveal>
      <div class="ncs-image-frame">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_coffee %}" alt="Coffee Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label"><strong>Coffee Tables</strong></div>
    </a>
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_side %}" data-nc-reveal>
      <div class="ncs-image-frame">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_side %}" alt="Side Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label"><strong>Side Tables</strong></div>
    </a>
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_console %}" data-nc-reveal>
      <div class="ncs-image-frame">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_console %}" alt="Console Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label"><strong>Console Tables</strong></div>
    </a>
  </div>
</section>

<section class="ncs-best">
  <div class="ncs-section-head" data-nc-reveal><h2>Best Sellers</h2></div>
  {% assign best_collection = collections[settings.collection_best_sellers] %}
  <div class="ncs-rail-wrap" data-nc-carousel-wrap>
    <div class="ncs-product-rail" data-nc-carousel tabindex="0" role="region" aria-label="Selected Nerocasa objects">
      {% if best_collection != blank and best_collection.products_count > 0 %}
        {% for product in best_collection.products limit: 6 %}
          {% capture product_thumb %}{% render 'nc-product-thumb', product: product %}{% endcapture %}
          <a class="ncs-best-card" href="{{ product.url }}">
            <div class="ncs-image-frame ncs-best-image">
              <img src="{{ product_thumb | strip }}" alt="{{ product.title | escape }}" width="900" height="1125" loading="lazy">
            </div>
            <div class="ncs-best-meta">
              <span>{{ product.title }}</span>
              <b>{{ product.price | money }}</b>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% render 'nc-showcase-best', limit: 6 %}
      {% endif %}
    </div>
    <div class="ncs-rail-controls">
      <button class="ncs-rail-control" data-nc-prev type="button" aria-label="Previous products">←</button>
      <div class="ncs-rail-progress"><i></i></div>
      <button class="ncs-rail-control" data-nc-next type="button" aria-label="Next products">→</button>
    </div>
  </div>
</section>

<section class="ncs-mail ncs-cta">
  <div class="ncs-cta-title" data-nc-reveal><h2>Stay close</h2></div>
  {% form 'customer', class: 'ncs-mail-form' %}
    {% if form.posted_successfully? %}
      <p class="ncs-form-success">Thank you — you're on the list.</p>
    {% else %}
      <input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email address">
      <button type="submit" class="ncs-btn ncs-btn--compact" aria-label="Subscribe">Subscribe ↗</button>
    {% endif %}
  {% endform %}
</section>

{% schema %}{"name":"Nerocasa Store Home","presets":[{"name":"Nerocasa Store Home"}]}{% endschema %}
