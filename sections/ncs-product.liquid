{% render 'nc-product-catalog-data', product: product %}

{%- capture display_name -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'name' %}{%- endcapture -%}
{%- capture catalog_category -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'category' %}{%- endcapture -%}
{%- capture dim_h -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'height' %}{%- endcapture -%}
{%- capture dim_l -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'length' %}{%- endcapture -%}
{%- capture dim_w -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'width' %}{%- endcapture -%}
{%- capture dim_d -%}{% render 'nc-product-field', product: product, handle: product.handle, field: 'depth' %}{%- endcapture -%}
{%- assign display_name = display_name | strip | default: product.title -%}
{%- assign catalog_category = catalog_category | strip -%}
{%- assign dim_h = dim_h | strip -%}
{%- assign dim_l = dim_l | strip -%}
{%- assign dim_w = dim_w | strip -%}
{%- assign dim_d = dim_d | strip -%}
{%- capture catalog_code -%}{% render 'nc-catalog-code', handle: product.handle %}{%- endcapture -%}
{%- assign catalog_code = catalog_code | strip -%}
{%- assign is_catalog_product = false -%}
{%- if catalog_code contains 'cft-' or catalog_code contains 'cs-' or catalog_code contains 'sd-' -%}
  {%- assign is_catalog_product = true -%}
{%- endif -%}

<section class="ncs-product-page" data-ncs-product data-product-handle="{{ product.handle }}">
  <div class="ncs-product-gallery">
    <div class="ncs-fit-img ncs-main-product-image">
      {%- capture main_img -%}{% render 'nc-product-img-src', product: product %}{%- endcapture -%}
      {%- capture default_marble -%}{% render 'nc-catalog-default-marble', handle: product.handle %}{%- endcapture -%}
      {%- assign main_img = main_img | strip -%}
      {%- assign default_marble = default_marble | strip -%}
      {%- assign main_image_obj = product.featured_image -%}
      {%- if main_image_obj == blank -%}
        {%- assign main_image_obj = product.images.first -%}
      {%- endif -%}
      {%- comment -%}
        The gallery renders at the image's own ratio (width:100%; height:auto),
        so the width/height attributes must be the real dimensions. Hardcoded
        values reserve the wrong box and shift the layout on load.
        The marble selector appends the finish to this alt in JS.
      {%- endcomment -%}
      {%- capture main_alt -%}
        {%- if catalog_category != blank -%}
          {{ display_name }} marble {{ catalog_category | downcase }}
        {%- else -%}
          {{ display_name }}
        {%- endif -%}
      {%- endcapture -%}
      {%- assign main_alt = main_alt | strip -%}
      {%- if main_img != blank -%}
        <img src="{{ main_img }}"
             alt="{{ main_alt | escape }}"
             data-ncs-main
             data-ncs-alt="{{ main_alt | escape }}"
             width="{{ main_image_obj.width | default: 1264 }}" height="{{ main_image_obj.height | default: 843 }}" loading="eager" fetchpriority="high">
      {%- else -%}
        <div class="ncs-main-product-image-empty" data-ncs-main-empty aria-hidden="true"></div>
        <img src="" alt="{{ main_alt | escape }}" data-ncs-main data-ncs-alt="{{ main_alt | escape }}" width="1264" height="843" hidden>
      {%- endif -%}
      <p class="ncs-shown-in" data-ncs-shown-in>
        {%- liquid
          assign shown_marble = default_marble
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'marble' or opt_name contains 'color' or opt_name contains 'colour'
              assign shown_marble = option.selected_value
              break
            endif
          endfor
        -%}
        Shown in {{ shown_marble }}
      </p>
    </div>
  </div>

  <div class="ncs-product-config">
    <h1 class="nc-gold">{{ display_name }}</h1>
    {%- if catalog_category != blank -%}
      <p class="ncs-product-category">{{ catalog_category }}</p>
    {%- endif -%}
    <div class="ncs-availability">{% if product.available %}Made to order{% else %}Not available{% endif %}</div>

    <div class="ncs-price">
      <span data-ncs-price>{{ product.selected_or_first_available_variant.price | money }}</span>
      {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
        <s class="ncs-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
      {% endif %}
      <small>Includes VAT</small>
    </div>

    {% if product.description != blank %}<div class="ncs-short-desc">{{ product.description }}</div>{% endif %}

    <div class="ncs-product-options" data-nc-product-options>
      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          {%- assign opt_l = option.name | downcase -%}
          {%- assign is_marble = false -%}
          {%- if opt_l contains 'marble' or opt_l contains 'color' or opt_l contains 'colour' or opt_l contains 'finish' -%}
            {%- assign is_marble = true -%}
          {%- endif -%}
          <div class="ncs-choice" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
            <label>{{ option.name }}</label>
            <div class="ncs-choice-row{% if is_marble %} ncs-choice-row--marbles{% endif %}">
              {% for value in option.values %}
                {% if is_marble %}
                  {%- capture marble_slug -%}{% render 'nc-marble-slug', name: value %}{%- endcapture -%}
                  {%- assign marble_selected = false -%}
                  {%- if option.selected_value == value -%}
                    {%- assign marble_selected = true -%}
                  {%- endif -%}
                  {% render 'nc-marble-choice',
                    name: value,
                    slug: marble_slug,
                    mode: 'button',
                    selected: marble_selected
                  %}
                {% else %}
                  <button type="button" data-value="{{ value | escape }}" class="{% if option.selected_value == value %}is-active{% endif %}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="ncs-size-mode" data-size-mode>
      <label>Size</label>
      <div class="ncs-size-mode-row">
        <button type="button" class="is-active" data-size-mode-button="fixed">Standard</button>
        <button type="button" data-size-mode-button="custom">{{ 'nav.custom' | t }}</button>
      </div>

      <div class="ncs-fixed-dimensions" data-fixed-size>
        <div class="ncs-fixed-size-title">Standard dimensions</div>
        <div class="ncs-fixed-dimensions-values">
          {% render 'nc-catalog-dimensions', product: product, handle: product.handle %}
        </div>
        {%- if catalog_code == 'cft-1' or catalog_code == 'cft-3' -%}
          <p class="ncs-product-note">Sold as a pair. The price shown is for both tables together.</p>
        {%- endif -%}
      </div>

      <div class="ncs-custom-dimensions" data-custom-size hidden>
        {%- capture wa_text -%}Hello NeroCasa, I would like a custom size for {{ display_name }}.{%- endcapture -%}
        <a class="ncs-custom-whatsapp-box" href="{% render 'nc-whatsapp-link', message: wa_text %}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>

    <div class="ncs-buy" data-ncs-buy>
      <div>
        <span>This piece</span>
        <b data-ncs-summary></b>
        <small class="ncs-selected-dimensions" data-ncs-selected-dimensions></small>
      </div>
      {% form 'product', product, data-nc-ajax-cart: 'true' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-ncs-variant>
        <input type="hidden" name="properties[Color / Marble]" value="" data-ncs-color-property>
        <input type="hidden" name="properties[Size Type]" value="Standard" data-ncs-size-type-property>
        <button type="submit" name="add" data-ncs-add-btn data-label-add="{{ 'actions.add_to_cart' | t }}" data-label-unavailable="{{ 'actions.not_available' | t }}" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}{{ 'actions.add_to_cart' | t }}{% else %}{{ 'actions.not_available' | t }}{% endif %}
        </button>
        <p class="ncs-cart-added" data-nc-cart-added hidden>Added to cart.</p>
      {% endform %}
    </div>

    <div class="ncs-accordion" data-ncs-accordion>
      <details class="ncs-story-detail" open>
        <summary>Story</summary>
        <div class="ncs-story-body" data-ncs-story>
          {%- if is_catalog_product -%}
            {%- assign initial_marble = default_marble -%}
            {%- capture hook_html -%}{% render 'nc-design-marble-hook', handle: product.handle, marble: initial_marble %}{%- endcapture -%}
            {%- capture origin_html -%}{% render 'nc-marble-profile', marble: initial_marble, part: 'story' %}{%- endcapture -%}
            {{ hook_html }}{{ origin_html }}
          {%- elsif product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>Luxury natural stone furniture, hand-finished in our workshop from quarry-sourced marble.</p>
          {%- endif -%}
        </div>
      </details>
      <details class="ncs-story-detail">
        <summary>Stone</summary>
        <div class="ncs-story-body" data-ncs-materials>
          {%- if is_catalog_product -%}
            {% render 'nc-marble-profile', marble: default_marble, part: 'materials' %}
          {%- elsif product.metafields.custom.materials != blank -%}
            {{ product.metafields.custom.materials }}
          {%- else -%}
            <p>Natural stone. Veining and tone vary from slab to slab. That variation is part of the material's character.</p>
          {%- endif -%}
        </div>
      </details>
      <details class="ncs-story-detail">
        <summary>Measure</summary>
        <div class="ncs-story-body" data-ncs-dimensions>
          {%- if dim_h != blank or dim_l != blank or dim_w != blank or dim_d != blank -%}
            {%- if catalog_code == 'cft-1' -%}
              <p class="ncs-dimension-note">Dimensions shown are for each table. Soglia is a set of two matching pieces.</p>
            {%- elsif catalog_code == 'cft-3' -%}
              <p class="ncs-dimension-note">Monolite is a set of two pieces. Dimensions for each table:</p>
            {%- endif -%}
            {% render 'nc-catalog-dimensions', product: product, handle: product.handle %}
          {%- else -%}
            <p>Dimensions are controlled by the selected configuration.</p>
          {%- endif -%}
        </div>
      </details>
      <details class="ncs-story-detail">
        <summary>Making</summary>
        <div class="ncs-story-body" data-ncs-production>
          {%- if product.metafields.custom.production_info != blank -%}
            {{ product.metafields.custom.production_info }}
          {%- else -%}
            <p>Each NeroCasa piece is cut, finished and assembled in our workshop from natural stone sourced at quarries worldwide.</p>
            <p>White-glove delivery typically within <strong>3 to 7 working days</strong> after order confirmation. We confirm timing for your selected marble and configuration before dispatch.</p>
          {%- endif -%}
        </div>
      </details>
    </div>
  </div>

  <script type="application/json" data-ncs-variants>[{% for variant in product.variants %}{"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"options":{{ variant.options | json }},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1800 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</section>

<script>
(function(){
  var root=document.querySelector('[data-ncs-product]'); if(!root)return;
  var handle=root.dataset.productHandle||'';
  var catalogCode={{ catalog_code | json }};
  var catalog=window.NC_CATALOG&&window.NC_CATALOG[handle];
  var marbleContent={};
  var marbleContentEl=document.querySelector('[data-nc-marble-content]');
  if(marbleContentEl){try{marbleContent=JSON.parse(marbleContentEl.textContent)}catch(e){}}
  var storyEl=root.querySelector('[data-ncs-story]');
  var materialsEl=root.querySelector('[data-ncs-materials]');
  var main=root.querySelector('[data-ncs-main]');
  var optionsWrap=root.querySelector('[data-nc-product-options]');
  var variantsEl=root.querySelector('[data-ncs-variants]'), variants=[];
  try{variants=JSON.parse(variantsEl.textContent)}catch(e){}
  var groups=[].slice.call(root.querySelectorAll('.ncs-choice[data-option-index]'));
  var price=root.querySelector('[data-ncs-price]'), summary=root.querySelector('[data-ncs-summary]');
  var variantInput=root.querySelector('[data-ncs-variant]'), add=root.querySelector('[data-ncs-add-btn]');
  var colorProp=root.querySelector('[data-ncs-color-property]');
  var typeProp=root.querySelector('[data-ncs-size-type-property]');
  var mode=root.querySelector('[data-size-mode]'), fixed=root.querySelector('[data-fixed-size]'), custom=root.querySelector('[data-custom-size]');
  var buy=root.querySelector('[data-ncs-buy]');

  function isColorGroup(g){var n=(g.dataset.optionName||'').toLowerCase();return n.indexOf('color')>-1||n.indexOf('colour')>-1||n.indexOf('marble')>-1||n.indexOf('finish')>-1;}
  function normalizeColor(v){
    v=(v||'').toLowerCase().trim();
    if(!v)return '';
    if(v.indexOf('ibiza')>-1||v==='white')return 'Ibiza White';
    if(v.indexOf('armani')>-1||v.indexOf('dgrey')>-1||v.indexOf('grey')>-1||v.indexOf('gray')>-1)return 'Armani Grey';
    if(v.indexOf('travert')>-1||v.indexOf('trav')>-1)return 'Travertine';
    if(v.indexOf('rosso')>-1||v.indexOf('levant')>-1||v==='red')return 'Rosso Levanto';
    return v.replace(/\b\w/g,function(c){return c.toUpperCase();});
  }
  function fixedDims(){return {h:'{{ dim_h | escape }}',l:'{{ dim_l | escape }}',w:'{{ dim_w | escape }}',d:'{{ dim_d | escape }}'};}
  function formatDims(dims){
    if(catalogCode==='cft-3') return 'Piece 1 H 45 × L 190 × W 60 cm · Piece 2 H 30 × L 190 × W 60 cm';
    var parts=[];
    if(dims.h)parts.push('H '+dims.h);
    if(dims.l)parts.push('L '+dims.l);
    if(dims.w)parts.push('W '+dims.w);
    if(dims.d)parts.push('D '+dims.d);
    return parts.length?parts.join(' × ')+' cm':'';
  }
  function selectedValues(){var a=[];groups.forEach(function(g){var b=g.querySelector('.is-active');a[+g.dataset.optionIndex]=b?b.dataset.value:null});return a;}
  function getSelectedColor(){
    var values=selectedValues(), color='';
    groups.forEach(function(g,i){if(isColorGroup(g))color=values[i]||'';});
    return normalizeColor(color);
  }
  function resolveImage(v){
    if(v&&v.image)return v.image;
    var color=getSelectedColor();
    if(catalog&&catalog.images&&color&&catalog.images[color])return catalog.images[color];
    return null;
  }
  function setImage(src){
    if(!main||!src)return;
    main.hidden=false;
    var emptyEl=root.querySelector('[data-ncs-main-empty]');
    if(emptyEl)emptyEl.hidden=true;
    var baseAlt=main.getAttribute('data-ncs-alt')||main.alt||'';
    var color=getSelectedColor();
    main.alt=color? (baseAlt+' — '+color) : baseAlt;
    if(main.getAttribute('src')===src){
      main.style.opacity='1';
      return;
    }
    main.style.transition='opacity 0.5s cubic-bezier(0.22,1,0.36,1)';
    main.style.opacity='0';
    window.setTimeout(function(){
      main.src=src;
      requestAnimationFrame(function(){ main.style.opacity='1'; });
    }, 280);
  }
  function updateShownIn(){
    var el=root.querySelector('[data-ncs-shown-in]');
    if(!el)return;
    var color=getSelectedColor();
    if(color)el.textContent='Shown in '+color;
  }
  function updateMarbleContent(){
    var color=getSelectedColor();
    if(!color)return;
    var entry=marbleContent[color];
    if(!entry)return;
    if(storyEl&&entry.story)storyEl.innerHTML=entry.story;
    if(materialsEl&&entry.materials)materialsEl.innerHTML=entry.materials;
  }
  function setProps(color){
    if(colorProp)colorProp.value=color||'';
    if(typeProp)typeProp.value='Standard';
  }
  function updateCustomProps(){
    var isCustom=mode&&mode.querySelector('[data-size-mode-button="custom"].is-active');
    if(fixed)fixed.hidden=!!isCustom; if(custom)custom.hidden=!isCustom;
    if(buy)buy.hidden=!!isCustom;
    var values=selectedValues(), color='';
    groups.forEach(function(g,i){if(isColorGroup(g))color=normalizeColor(values[i]||'');});
    setProps(color);
    var dim=root.querySelector('[data-ncs-selected-dimensions]');
    if(dim)dim.textContent=isCustom?'':formatDims(fixedDims());
  }
  function findVariant(selected){
    return variants.find(function(item){
      return item.options.every(function(opt,i){
        if(selected[i]===null||selected[i]===undefined)return true;
        if(groups[i]&&isColorGroup(groups[i]))return normalizeColor(opt)===normalizeColor(selected[i]);
        return opt===selected[i];
      });
    });
  }
  function syncVariant(){
    updateCustomProps();
    if(!variants.length){
      var img=resolveImage(null);
      if(img)setImage(img);
      updateShownIn();
      updateMarbleContent();
      return;
    }
    var selected=selectedValues();
    var v=findVariant(selected);
    if(!v){
      if(add){add.disabled=true;add.innerHTML=add.getAttribute('data-label-unavailable')||'Not available';}
      var imgOnly=resolveImage(null);
      if(imgOnly)setImage(imgOnly);
      updateShownIn();
      updateMarbleContent();
      return;
    }
    if(variantInput)variantInput.value=v.id;
    if(price)price.textContent=v.price;
    if(add){add.disabled=!v.available;add.innerHTML=v.available?(add.getAttribute('data-label-add')||'Add to cart'):(add.getAttribute('data-label-unavailable')||'Not available');}
    if(summary)summary.textContent=getSelectedColor()||v.title;
    var img=resolveImage(v);
    if(img)setImage(img);
    updateShownIn();
    updateMarbleContent();
  }
  function marbleSlug(name){
    return String(name||'').toLowerCase().replace(/\s+/g,'-');
  }
  function bindChoiceGroup(g){
    g.querySelectorAll('[data-value]').forEach(function(btn){
      btn.addEventListener('click',function(){
        g.querySelectorAll('[data-value]').forEach(function(x){
          x.classList.remove('is-active');
          if(x.hasAttribute('aria-pressed')) x.setAttribute('aria-pressed','false');
        });
        btn.classList.add('is-active');
        if(btn.hasAttribute('aria-pressed')) btn.setAttribute('aria-pressed','true');
        syncVariant();
      });
    });
  }
  function injectMarblePicker(){
    if(!catalog||!optionsWrap||groups.some(isColorGroup))return;
    var wrap=document.createElement('div');
    wrap.className='ncs-choice';
    wrap.dataset.optionIndex='0';
    wrap.dataset.optionName='Marble';
    wrap.dataset.ncInjectedMarble='1';
    wrap.innerHTML='<label>Marble</label><div class="ncs-choice-row ncs-choice-row--marbles"></div>';
    var row=wrap.querySelector('.ncs-choice-row');
    catalog.colors.forEach(function(color,i){
      var btn=document.createElement('button');
      btn.type='button';
      btn.dataset.value=color;
      btn.className='ncs-marble-choice'+(i===0?' is-active':'');
      btn.setAttribute('aria-label',color);
      btn.setAttribute('aria-pressed', i===0 ? 'true' : 'false');
      var sample=document.createElement('span');
      sample.className='ncs-marble-swatch ncs-marble-swatch--'+marbleSlug(color);
      sample.setAttribute('aria-hidden','true');
      var label=document.createElement('span');
      label.className='ncs-marble-name';
      label.textContent=color;
      btn.appendChild(sample);
      btn.appendChild(label);
      row.appendChild(btn);
    });
    optionsWrap.prepend(wrap);
    groups=[].slice.call(root.querySelectorAll('.ncs-choice[data-option-index]'));
    bindChoiceGroup(wrap);
  }
  groups.forEach(bindChoiceGroup);
  injectMarblePicker();
  if(mode)mode.querySelectorAll('[data-size-mode-button]').forEach(function(btn){btn.addEventListener('click',function(){mode.querySelectorAll('[data-size-mode-button]').forEach(function(x){x.classList.remove('is-active')});btn.classList.add('is-active');updateCustomProps()})});
  syncVariant();
})();
</script>
{% schema %}{"name":"Nerocasa Product","presets":[{"name":"Nerocasa Product"}]}{% endschema %}
