<section class="ncs-info-page ncs-legal-page">
  {% render 'nc-page-hero-shell-open',
    slab_left: 'hero-slab-green.jpg',
    slab_center: 'hero-slab-white.jpg',
    slab_right: 'hero-slab-travertine.jpg'
  %}
  <h1>{% render 'nc-title-gold', title: page.title | default: 'Refunds and Returns' %}</h1>
  {% render 'nc-page-hero-shell-close' %}
  <div class="ncs-legal-body">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      <p>Add your refund policy in <strong>Online Store → Pages → Refunds</strong>. Content entered there will appear here automatically.</p>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"REFUNDS","presets":[{"name":"REFUNDS"}]}{% endschema %}
