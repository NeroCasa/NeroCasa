<section class="ncs-about-page">
  <div class="ncs-about-hero-split ncs-page-hero-shell" data-nc-reveal>
    <div class="ncs-hero-media" aria-hidden="true">
      {% render 'nc-hero-marble-bg',
        mode: 'triple',
        slab_left: 'hero-slab-green.jpg',
        slab_center: 'hero-slab-grey.jpg',
        slab_right: 'hero-slab-travertine.jpg',
        left_image: section.settings.hero_slab_left,
        center_image: section.settings.hero_slab_center,
        right_image: section.settings.hero_slab_right
      %}
    </div>
    <div class="ncs-about-hero-copy">
      <span class="ncs-page-kicker">Why Nerocasa</span>
      <h1>{% render 'nc-title-gold', title: section.settings.hero_heading | default: page.title %}</h1>
      <p class="ncs-about-hero-lead">{{ section.settings.hero_lead }}</p>
    </div>
    <div class="ncs-about-hero-visual ncs-about-hero-logo">
      {%- if section.settings.hero_brand_image != blank -%}
        <img src="{{ section.settings.hero_brand_image | image_url: width: 1600 }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="1200" loading="eager">
      {%- elsif settings.brand_visual != blank -%}
        <img src="{{ settings.brand_visual | image_url: width: 1600 }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="1200" loading="eager">
      {%- else -%}
        <img src="{{ 'nerocasa-wordmark-why.png' | asset_url }}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="1200" loading="eager">
      {%- endif -%}
    </div>
  </div>

  {% if page.content != blank %}
    <div class="ncs-about-page-content ncs-legal-body" data-nc-reveal>
      {{ page.content }}
    </div>
  {% endif %}

  <div class="ncs-about-values">
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{% render 'nc-title-gold', title: section.settings.block_1_title %}</h2>
      <p>{{ section.settings.block_1_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{% render 'nc-title-gold', title: section.settings.block_2_title %}</h2>
      <p>{{ section.settings.block_2_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{% render 'nc-title-gold', title: section.settings.block_3_title %}</h2>
      <p>{{ section.settings.block_3_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{% render 'nc-title-gold', title: section.settings.block_4_title %}</h2>
      <p>{{ section.settings.block_4_text }}</p>
    </article>
  </div>

  <div class="ncs-about-manifesto" data-nc-reveal>
    <p class="ncs-about-manifesto-lead">{% render 'nc-title-gold', title: section.settings.manifesto_lead %}</p>
    <p>{{ section.settings.manifesto_text }}</p>
  </div>

  <div class="ncs-about-closer" data-nc-reveal>
    <div class="ncs-about-closer-intro">
      <span class="ncs-page-kicker">Continue</span>
      <h2 class="ncs-about-closer-heading">{% render 'nc-title-gold', title: 'Begin with stone' %}</h2>
      <p class="ncs-about-closer-lead">Explore the collection, or speak with us about a project made for your space.</p>
    </div>
    <div class="ncs-about-closer-grid">
      <article>
        <h3>{% render 'nc-title-gold', title: section.settings.advantage_1_title %}</h3>
        <p>{{ section.settings.advantage_1_text }}</p>
      </article>
      <article>
        <h3>{% render 'nc-title-gold', title: section.settings.advantage_2_title %}</h3>
        <p>{{ section.settings.advantage_2_text }}</p>
      </article>
    </div>
    <div class="ncs-about-closer-actions">
      <a class="ncs-btn ncs-btn--compact" href="{% render 'nc-collections-index-url' %}">Shop collections ↗</a>
      <a class="ncs-btn ncs-btn--outline ncs-btn--compact" href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}">B2B enquiry ↗</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Nerocasa",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Marble for every home"
    },
    {
      "type": "textarea",
      "id": "hero_lead",
      "label": "Hero lead",
      "default": "NEROCASA imports premium marble from quarries worldwide and crafts luxury furniture in its own workshop. Real stone, architectural design and the finish we would choose for our own homes."
    },
    {
      "type": "header",
      "content": "Hero images"
    },
    {
      "type": "image_picker",
      "id": "hero_brand_image",
      "label": "Hero brand image",
      "info": "Optional. Defaults to Brand → Brand mark, then the built-in wordmark."
    },
    {
      "type": "image_picker",
      "id": "hero_slab_left",
      "label": "Hero slab — left"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_center",
      "label": "Hero slab — center"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_right",
      "label": "Hero slab — right"
    },
    {
      "type": "header",
      "content": "Story blocks"
    },
    {
      "type": "text",
      "id": "block_1_title",
      "label": "Block 1 title",
      "default": "Import and manufacture"
    },
    {
      "type": "textarea",
      "id": "block_1_text",
      "label": "Block 1 text",
      "default": "We import marble from quarries worldwide and can source virtually any stone you need. Unlike others, we do not buy ready-made furniture from outside. We bring the slab in and craft the piece ourselves."
    },
    {
      "type": "text",
      "id": "block_2_title",
      "label": "Block 2 title",
      "default": "Genuine marble and stone"
    },
    {
      "type": "textarea",
      "id": "block_2_text",
      "label": "Block 2 text",
      "default": "Natural materials only. Veining, tone and texture vary from slab to slab. That is the signature of real stone, chosen with care for your project."
    },
    {
      "type": "text",
      "id": "block_3_title",
      "label": "Block 3 title",
      "default": "Crafted in our workshop"
    },
    {
      "type": "textarea",
      "id": "block_3_text",
      "label": "Block 3 text",
      "default": "Each piece is cut, finished and inspected in our workshop with the precision and care expected of luxury stone furniture."
    },
    {
      "type": "text",
      "id": "block_4_title",
      "label": "Block 4 title",
      "default": "You are the priority"
    },
    {
      "type": "textarea",
      "id": "block_4_text",
      "label": "Block 4 text",
      "default": "We listen, advise and stay close through production. Your satisfaction is how we build trust, one home at a time."
    },
    {
      "type": "header",
      "content": "Manifesto"
    },
    {
      "type": "text",
      "id": "manifesto_lead",
      "label": "Manifesto lead",
      "default": "Marble is not a privilege"
    },
    {
      "type": "textarea",
      "id": "manifesto_text",
      "label": "Manifesto text",
      "default": "It is part of how a home feels. As our collection grows, our standards stay the same. Real stone, honest craft, and a brand that treats every client as someone we want in our world for years."
    },
    {
      "type": "header",
      "content": "Closing section"
    },
    {
      "type": "text",
      "id": "advantage_1_title",
      "label": "Advantage 1 title",
      "default": "Better quality, lower price"
    },
    {
      "type": "textarea",
      "id": "advantage_1_text",
      "label": "Advantage 1 text",
      "default": "Because we import the stone and manufacture in our own factory, we avoid finished-product markups from third parties. That means better material and finishing for less than most names at the same level."
    },
    {
      "type": "text",
      "id": "advantage_2_title",
      "label": "Advantage 2 title",
      "default": "See your piece being made"
    },
    {
      "type": "textarea",
      "id": "advantage_2_text",
      "label": "Advantage 2 text",
      "default": "Visit the workshop to see your piece take shape, or receive curated video updates as we cut, finish and prepare it for delivery."
    }
  ],
  "presets": [{ "name": "Why Nerocasa" }]
}
{% endschema %}
