<section class="ncs-about-page">
  <div class="ncs-about-hero-split" data-nc-reveal>
    <div class="ncs-about-hero-copy">
      <span class="ncs-page-kicker">Why Nerocasa</span>
      <h1>{{ section.settings.hero_heading | default: page.title }}</h1>
      <p class="ncs-about-hero-lead">{{ section.settings.hero_lead }}</p>
    </div>
    <div class="ncs-about-hero-visual ncs-brand-visual-frame">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.hero_image.alt | default: settings.brand_name | escape }}" width="1200" height="900" loading="eager">
      {% else %}
        <img src="{% render 'nc-brand-visual' %}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="900" loading="eager">
      {% endif %}
    </div>
  </div>

  {% if page.content != blank %}
    <div class="ncs-about-page-content ncs-legal-body" data-nc-reveal>
      {{ page.content }}
    </div>
  {% endif %}

  <div class="ncs-about-values">
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{{ section.settings.block_1_title }}</h2>
      <p>{{ section.settings.block_1_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{{ section.settings.block_2_title }}</h2>
      <p>{{ section.settings.block_2_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{{ section.settings.block_3_title }}</h2>
      <p>{{ section.settings.block_3_text }}</p>
    </article>
    <article class="ncs-about-value" data-nc-reveal>
      <h2>{{ section.settings.block_4_title }}</h2>
      <p>{{ section.settings.block_4_text }}</p>
    </article>
  </div>

  <div class="ncs-about-manifesto" data-nc-reveal>
    <p class="ncs-about-manifesto-lead">{{ section.settings.manifesto_lead }}</p>
    <p>{{ section.settings.manifesto_text }}</p>
  </div>

  <div class="ncs-about-cta ncs-about-cta--dual" data-nc-reveal>
    <div class="ncs-about-cta-copy">
      <h2>{{ section.settings.cta_heading }}</h2>
      <p>{{ section.settings.cta_text }}</p>
    </div>
    <div class="ncs-about-cta-actions">
      <a class="ncs-btn" href="{% render 'nc-collections-index-url' %}">Shop collections ↗</a>
      <a class="ncs-btn ncs-btn--outline" href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}">B2B ↗</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Nerocasa",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Marble for every home"
    },
    {
      "type": "textarea",
      "id": "hero_lead",
      "label": "Hero lead",
      "default": "We believe everyone should live with real stone. NeroCasa makes marble furniture and objects from our own workshop, priced so ownership feels possible, finished so it feels personal."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image override"
    },
    {
      "type": "header",
      "content": "Story blocks"
    },
    {
      "type": "text",
      "id": "block_1_title",
      "label": "Block 1 title",
      "default": "Our own production"
    },
    {
      "type": "textarea",
      "id": "block_1_text",
      "label": "Block 1 text",
      "default": "We are makers, not middlemen. What you order is what we craft, without layers of margin between the slab and your home."
    },
    {
      "type": "text",
      "id": "block_2_title",
      "label": "Block 2 title",
      "default": "Genuine marble and stone"
    },
    {
      "type": "textarea",
      "id": "block_2_text",
      "label": "Block 2 text",
      "default": "Natural materials only. Veining, tone and texture vary from slab to slab. That is the signature of real stone."
    },
    {
      "type": "text",
      "id": "block_3_title",
      "label": "Block 3 title",
      "default": "Made when you order"
    },
    {
      "type": "textarea",
      "id": "block_3_text",
      "label": "Block 3 text",
      "default": "Your piece enters production after you order. We cut, finish and inspect it with the same care we would expect as clients ourselves."
    },
    {
      "type": "text",
      "id": "block_4_title",
      "label": "Block 4 title",
      "default": "You are the priority"
    },
    {
      "type": "textarea",
      "id": "block_4_text",
      "label": "Block 4 text",
      "default": "We listen, advise and stay close through production. Your satisfaction is how we build trust, one home at a time."
    },
    {
      "type": "header",
      "content": "Manifesto"
    },
    {
      "type": "textarea",
      "id": "manifesto_lead",
      "label": "Manifesto lead",
      "default": "Marble is not a privilege. It is part of how a home feels."
    },
    {
      "type": "textarea",
      "id": "manifesto_text",
      "label": "Manifesto text",
      "default": "Our catalog will grow. Our commitment will not. Real stone, honest craft, and a brand that treats every client as someone we want in our world for years."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Begin with stone"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Explore the collections or speak with us about trade and project work."
    }
  ],
  "presets": [{ "name": "Why Nerocasa" }]
}
{% endschema %}
