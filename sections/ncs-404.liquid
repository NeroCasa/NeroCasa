<section class="ncs-info-page ncs-404-page">
  <h1>{% render 'nc-title-gold', title: 'Page not found' %}</h1>
  <div class="ncs-legal-body">
    <p>The page you requested is unavailable or may have moved.</p>
    <a class="ncs-btn" href="{{ routes.root_url }}">Return home ↗</a>
    <a class="ncs-btn ncs-btn--ghost" href="{% render 'nc-collections-index-url' %}">Browse collections ↗</a>
  </div>
</section>
{% schema %}{"name":"404","presets":[{"name":"404"}]}{% endschema %}
