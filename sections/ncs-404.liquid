<section class="ncs-info-page ncs-404-page">
  {% render 'nc-page-hero-shell-open',
    quiet: true,
    slab_left: 'hero-slab-red.jpg',
    slab_center: 'hero-slab-black.jpg',
    slab_right: 'hero-slab-grey.jpg'
  %}
  <h1>{% render 'nc-title-gold', title: 'Page not found' %}</h1>
  {% render 'nc-page-hero-shell-close' %}
  <div class="ncs-legal-body">
    <p>This page is not here.</p>
    <a class="ncs-btn" href="{{ routes.root_url }}">Home</a>
    <a class="ncs-btn ncs-btn--ghost" href="{% render 'nc-collections-index-url' %}">The collection</a>
  </div>
</section>
{% schema %}{"name":"404","presets":[{"name":"404"}]}{% endschema %}
