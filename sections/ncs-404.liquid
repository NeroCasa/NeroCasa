<section class="ncs-info-page ncs-404-page">
  {%- capture nc_hero_body -%}
  <header class="ncs-page-hero ncs-page-hero--compact">
    {%- assign not_found_title = 'errors.not_found' | t -%}
    <h1>{% render 'nc-title-gold', title: not_found_title %}</h1>
  </header>
  {%- endcapture -%}
  {% render 'nc-page-hero-shell',
    quiet: true,
    body: nc_hero_body,
    slab_left: 'hero-slab-red.jpg',
    slab_center: 'hero-slab-black.jpg',
    slab_right: 'hero-slab-grey.jpg'
  %}
  <div class="ncs-legal-body">
    <p>This page is not here. The piece, or the path, has moved.</p>
    <div class="ncs-404-actions">
      <a class="ncs-btn" href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a>
      {%- assign cta_collection = 'actions.our_collection' | t -%}
      <a class="ncs-btn ncs-btn--ghost" href="{% render 'nc-collections-index-url' %}">{% render 'nc-title-gold', title: cta_collection %}</a>
    </div>
  </div>
</section>
{% schema %}{"name":"404","presets":[{"name":"404"}]}{% endschema %}
