<section class="ncs-b2b-page">
  <div class="ncs-b2b-layout ncs-b2b-layout--split">
    <header class="ncs-b2b-header ncs-page-hero" data-nc-reveal>
      <span class="ncs-page-kicker">{{ section.settings.kicker }}</span>
      <h1>{% render 'nc-title-gold', title: section.settings.heading %}</h1>
      <p class="ncs-b2b-lead">{{ section.settings.lead }}</p>
      <p class="ncs-b2b-detail">{{ section.settings.detail_text }}</p>
      <ul class="ncs-b2b-trust">
        <li>{{ section.settings.trust_1 }}</li>
        <li>{{ section.settings.trust_2 }}</li>
        <li>{{ section.settings.trust_3 }}</li>
      </ul>
    </header>

    <div class="ncs-b2b-form-wrap" data-nc-reveal>
      <div class="ncs-b2b-form-panel">
        {% form 'contact', class: 'ncs-b2b-form' %}
          {% if form.posted_successfully? %}
            <p class="ncs-form-success">Thank you. Your enquiry has been received. We will respond within one business day.</p>
          {% else %}
            {% if form.errors %}<p class="ncs-form-error">Please check the form and try again.</p>{% endif %}
            <input type="hidden" name="contact[tags]" value="b2b-enquiry">
            <div class="ncs-form-row">
              <label>Name<input type="text" name="contact[name]" required autocomplete="name"></label>
              <label>Company<input type="text" name="contact[company]" autocomplete="organization"></label>
            </div>
            <div class="ncs-form-row">
              <label>Email<input type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email"></label>
              <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel"></label>
            </div>
            <div class="ncs-form-row">
              <label class="ncs-form-full">Project type
                <select name="contact[project_type]">
                  <option>Residential interior</option>
                  <option>Architecture and build</option>
                  <option>Hospitality and hotel</option>
                  <option>Restaurant and retail</option>
                  <option>Multi unit development</option>
                  <option>Other commercial</option>
                </select>
              </label>
            </div>
            <label class="ncs-form-full">Marble or stone preference<input type="text" name="contact[marble_preference]" placeholder="Describe the finish you want, or leave open for our suggestion"></label>
            <label class="ncs-form-full">Project details<textarea name="contact[body]" rows="7" placeholder="Space, pieces required, location, timeline, anything else we should know."></textarea></label>
            <button type="submit" class="ncs-btn">Send enquiry ↗</button>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B2B Enquiry",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Trade and projects"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "B2B enquiries"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Hotels, residences, restaurants and retail spaces. We partner with designers, architects and developers who need real stone at volume, with production they can trust."
    },
    {
      "type": "textarea",
      "id": "detail_text",
      "label": "Detail",
      "default": "Because NeroCasa owns its workshop, we remove importer, distributor and boutique margins. That means better stone and finishing for less than comparable suppliers, without cutting corners on material or craft."
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust point 1",
      "default": "Direct workshop pricing"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust point 2",
      "default": "Genuine stone at scale"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust point 3",
      "default": "Dedicated project support"
    }
  ],
  "presets": [{ "name": "B2B Project Enquiry" }]
}
{% endschema %}
