<section class="ncs-custom-page">
  {% render 'nc-page-hero-shell-open',
    slab_left: 'hero-slab-red.jpg',
    slab_center: 'hero-slab-white.jpg',
    slab_right: 'hero-slab-grey.jpg'
  %}
  <header class="ncs-page-hero" data-nc-reveal>
    <span class="ncs-page-kicker">{{ section.settings.hero_kicker }}</span>
    <h1>{% render 'nc-title-gold', title: section.settings.hero_heading %}</h1>
    <p>{{ section.settings.hero_lead }}</p>
  </header>
  {% render 'nc-page-hero-shell-close' %}

  <section class="ncs-custom-block ncs-custom-block--whatsapp" data-nc-reveal>
    <span class="ncs-page-kicker">Your commission</span>
    <h2>{% render 'nc-title-gold', title: section.settings.vision_heading %}</h2>
    <p class="ncs-form-lead">{{ section.settings.vision_lead }}</p>

    <ul class="ncs-custom-scope">
      <li>{{ section.settings.scope_1 }}</li>
      <li>{{ section.settings.scope_2 }}</li>
      <li>{{ section.settings.scope_3 }}</li>
      <li>{{ section.settings.scope_4 }}</li>
    </ul>

    <div class="ncs-custom-whatsapp-panel">
      <p class="ncs-custom-whatsapp-note">{{ section.settings.whatsapp_note }}</p>
      <a class="ncs-btn" href="{% render 'nc-contact-whatsapp' %}" target="_blank" rel="noopener">Talk to us on WhatsApp ↗</a>
      <p class="ncs-custom-whatsapp-hint">{{ section.settings.whatsapp_hint }}</p>
    </div>

    <p class="ncs-custom-b2b-note">{{ section.settings.b2b_note }} <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}">B2B enquiry ↗</a></p>
  </section>

  <section class="ncs-custom-block ncs-custom-block--waterjet" data-nc-reveal>
    <span class="ncs-page-kicker">{{ section.settings.waterjet_kicker }}</span>
    <h2>{% render 'nc-title-gold', title: section.settings.waterjet_heading %}</h2>
    <p class="ncs-custom-soon">{{ section.settings.waterjet_note }}</p>
    <p>{{ section.settings.waterjet_text }}</p>
  </section>
</section>

{% schema %}
{
  "name": "Custom Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Hero kicker",
      "default": "Beyond the catalog"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Made for you"
    },
    {
      "type": "textarea",
      "id": "hero_lead",
      "label": "Hero lead",
      "default": "Beyond our collections, NeroCasa commissions bespoke marble furniture in any stone, size or design. From an existing piece in a new finish to a fully original brief, our workshop crafts premium natural stone to your specification. Start on WhatsApp."
    },
    {
      "type": "text",
      "id": "vision_heading",
      "label": "Vision heading",
      "default": "Share your vision"
    },
    {
      "type": "textarea",
      "id": "vision_lead",
      "label": "Vision lead",
      "default": "Tell us what you want on WhatsApp. We reply with feasibility, stone options, timing, and next steps."
    },
    {
      "type": "text",
      "id": "scope_1",
      "label": "Scope point 1",
      "default": "Any collection design in a different marble or custom size"
    },
    {
      "type": "text",
      "id": "scope_2",
      "label": "Scope point 2",
      "default": "Soglia, Monolite, Galleria, and every piece in our catalog, adapted to your space"
    },
    {
      "type": "text",
      "id": "scope_3",
      "label": "Scope point 3",
      "default": "One-off furniture, tables and surfaces in premium marble and natural stone"
    },
    {
      "type": "text",
      "id": "scope_4",
      "label": "Scope point 4",
      "default": "Stone preference, dimensions, finish, and reference images discussed directly with our team"
    },
    {
      "type": "textarea",
      "id": "whatsapp_note",
      "label": "WhatsApp note",
      "default": "Custom commissions are handled on WhatsApp so we can talk through your idea, images, and measurements directly."
    },
    {
      "type": "text",
      "id": "whatsapp_hint",
      "label": "WhatsApp hint",
      "default": "Share dimensions, marble preference, reference images, and your room or project details."
    },
    {
      "type": "textarea",
      "id": "b2b_note",
      "label": "B2B note",
      "default": "For trade, hospitality, and commercial projects, use our B2B form. Enquiries go to info@nerocasa.com."
    },
    {
      "type": "text",
      "id": "waterjet_kicker",
      "label": "Water jet kicker",
      "default": "Water jet cutting"
    },
    {
      "type": "text",
      "id": "waterjet_heading",
      "label": "Water jet heading",
      "default": "Our water jet designs"
    },
    {
      "type": "text",
      "id": "waterjet_note",
      "label": "Water jet note",
      "default": "Coming soon"
    },
    {
      "type": "textarea",
      "id": "waterjet_text",
      "label": "Water jet text",
      "default": "A curated line of NeroCasa water-cut marble shapes, surfaces, and objects is in development. Bespoke water jet work is still available now through WhatsApp above."
    }
  ],
  "presets": [{ "name": "Custom Page" }]
}
{% endschema %}
