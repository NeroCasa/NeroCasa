<section class="ncs-custom-page">
  {%- capture nc_hero_body -%}
  <header class="ncs-page-hero ncs-page-hero--compact" data-nc-reveal>
    <h1>{% render 'nc-title-gold', title: section.settings.hero_heading %}</h1>
    <p>{{ section.settings.hero_lead }}</p>
  </header>
  {%- endcapture -%}
  {% render 'nc-page-hero-shell',
    quiet: true,
    body: nc_hero_body,
    slab_left: 'hero-slab-red.jpg',
    slab_center: 'hero-slab-white.jpg',
    slab_right: 'hero-slab-grey.jpg',
    left_image: section.settings.hero_slab_left,
    center_image: section.settings.hero_slab_center,
    right_image: section.settings.hero_slab_right
  %}

  <section class="ncs-custom-block ncs-custom-block--whatsapp" data-nc-reveal>
    <div class="ncs-custom-block-copy">
      <h2>{% render 'nc-title-gold', title: section.settings.vision_heading %}</h2>
      <p class="ncs-form-lead">{{ section.settings.vision_lead }}</p>

      <ol class="ncs-process">
        <li>{{ section.settings.scope_1 }}</li>
        <li>{{ section.settings.scope_2 }}</li>
        <li>{{ section.settings.scope_3 }}</li>
      </ol>

      <aside class="ncs-coming-soon">
        <span class="ncs-coming-soon-kicker">{{ section.settings.waterjet_note | default: 'Coming soon' }}</span>
        <p>{{ section.settings.waterjet_text }}</p>
      </aside>
    </div>

    <div class="ncs-custom-visual ncs-home-story-visual nc-brand-visual-frame">
      <img src="{% render 'nc-brand-visual' %}" alt="{{ settings.brand_name | default: 'NeroCasa' }} Marble Works" width="1200" height="1200" loading="lazy">
      {%- assign cta_whatsapp = 'actions.talk_whatsapp' | t -%}
      <a class="ncs-btn" href="{% render 'nc-contact-whatsapp' %}" target="_blank" rel="noopener">{% render 'nc-title-gold', title: cta_whatsapp %}</a>
      <p class="ncs-custom-whatsapp-hint">{{ section.settings.whatsapp_hint }}</p>
      <p class="ncs-custom-b2b-note">{{ section.settings.b2b_note }} <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}">B2B</a></p>
    </div>
  </section>
</section>

{% schema %}
{
  "name": "Custom Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Hero kicker",
      "default": "Beyond the catalog"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Made for you"
    },
    {
      "type": "textarea",
      "id": "hero_lead",
      "label": "Hero lead",
      "default": "Beyond our collections, NeroCasa creates custom marble furniture in any stone, size or design. We source marble from quarries worldwide. From an existing piece in a new finish to a fully original brief, our workshop crafts natural stone to your specification. Start on WhatsApp."
    },
    {
      "type": "header",
      "content": "Hero images"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_left",
      "label": "Hero slab — left"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_center",
      "label": "Hero slab — center"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_right",
      "label": "Hero slab — right"
    },
    {
      "type": "text",
      "id": "vision_heading",
      "label": "Vision heading",
      "default": "Share your vision"
    },
    {
      "type": "textarea",
      "id": "vision_lead",
      "label": "Vision lead",
      "default": "Tell us what you want on WhatsApp. We reply with feasibility, stone options, timing, and next steps."
    },
    {
      "type": "text",
      "id": "scope_1",
      "label": "Scope point 1",
      "default": "Send dimensions, stone preference, and references on WhatsApp"
    },
    {
      "type": "text",
      "id": "scope_2",
      "label": "Scope point 2",
      "default": "We confirm feasibility, marble, and timing"
    },
    {
      "type": "text",
      "id": "scope_3",
      "label": "Scope point 3",
      "default": "Production in our workshop"
    },
    {
      "type": "text",
      "id": "scope_4",
      "label": "Scope point 4",
      "default": "Stone preference, dimensions, finish, and reference images discussed directly with our team"
    },
    {
      "type": "textarea",
      "id": "whatsapp_note",
      "label": "WhatsApp note",
      "default": "Custom pieces are handled on WhatsApp so we can talk through your idea, images, and measurements directly."
    },
    {
      "type": "text",
      "id": "whatsapp_hint",
      "label": "WhatsApp hint",
      "default": "Share dimensions, marble preference, reference images, and your room or project details."
    },
    {
      "type": "textarea",
      "id": "b2b_note",
      "label": "B2B note",
      "default": "For trade, hospitality, and commercial projects, use our B2B form. Enquiries go to nerocasamarbles@gmail.com."
    },
    {
      "type": "text",
      "id": "waterjet_kicker",
      "label": "Water jet kicker",
      "default": "Water jet cutting"
    },
    {
      "type": "text",
      "id": "waterjet_heading",
      "label": "Water jet heading",
      "default": "Our water jet designs"
    },
    {
      "type": "text",
      "id": "waterjet_note",
      "label": "Water jet note",
      "default": "Coming soon"
    },
    {
      "type": "textarea",
      "id": "waterjet_text",
      "label": "Water jet text",
      "default": "A line of water-cut marble shapes, surfaces, and objects is in development. Custom water-jet work is available on WhatsApp now."
    }
  ],
  "presets": [{ "name": "Custom Page" }]
}
{% endschema %}
