<section class="ncs-custom-page">
  <header class="ncs-page-hero" data-nc-reveal>
    <span class="ncs-page-kicker">Custom</span>
    <h1>Your vision in <em>stone</em></h1>
    <p>Start from one of our designs or bring your own dimensions. Every piece is cut and finished to order in our workshop.</p>
    <a class="ncs-btn ncs-btn--ghost" href="{% render 'nc-collections-index-url' %}">Browse ready designs ↗</a>
  </header>

  <div class="ncs-custom-form-wrap">
    <div class="ncs-custom-form-panel" data-nc-reveal>
      <h2 class="ncs-form-title">Custom request</h2>
      <p class="ncs-form-lead">Share your dimensions, stone preference and any reference. We will reply with a quote and lead time.</p>

      {% form 'contact', class: 'ncs-b2b-form', id: 'NerocasaCustomForm' %}
        {% if form.posted_successfully? %}
          <p class="ncs-form-success">Thank you. Your custom request has been received.</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="custom-enquiry">
          <div class="ncs-form-row">
            <label>Name<input type="text" name="contact[name]" required autocomplete="name"></label>
            <label>Email<input type="email" name="contact[email]" required autocomplete="email"></label>
          </div>
          <div class="ncs-form-row">
            <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel"></label>
            <label>Marble or stone preference<input type="text" name="contact[marble_preference]" placeholder="White marble, travertine, or describe what you want"></label>
          </div>

          <div class="ncs-custom-dimension-grid ncs-custom-dimension-grid--4">
            <label>H (cm)<input type="number" min="1" step="0.1" name="contact[height_cm]" required placeholder="cm"></label>
            <label>L (cm)<input type="number" min="1" step="0.1" name="contact[length_cm]" required placeholder="cm"></label>
            <label>W (cm)<input type="number" min="1" step="0.1" name="contact[width_cm]" required placeholder="cm"></label>
            <label>D (cm)<input type="number" min="1" step="0.1" name="contact[depth_cm]" placeholder="cm"></label>
          </div>
          <label class="ncs-form-full">Additional details<textarea name="contact[body]" rows="6" placeholder="Design notes, finish, room context, or anything else we should know."></textarea></label>
          <button type="submit" class="ncs-btn">Submit request ↗</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}{"name":"Ready Designs","presets":[{"name":"Ready Designs"}]}{% endschema %}
