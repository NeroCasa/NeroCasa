<section class="ncs-custom-page">
  <header class="ncs-page-hero" data-nc-reveal>
    <span class="ncs-page-kicker">Custom</span>
    <h1>Your vision, in <em>stone</em></h1>
    <p>Choose from ready designs or submit your own dimensions and reference — every piece is made to order.</p>
  </header>

  <div class="ncs-custom-ready">
    <div class="ncs-section-head ncs-section-head--compact" data-nc-reveal>
      <span class="ncs-page-kicker">Ready designs</span>
      <h2>Starting points</h2>
    </div>
    <div class="ncs-custom-grid">
      <article data-nc-reveal>
        <img src="{{ 'collection-decorative.svg' | asset_url }}" alt="Obsidian Table" width="1600" height="1100" loading="lazy">
        <div><strong>Obsidian Table</strong><b>Enquire ↗</b></div>
      </article>
      <article data-nc-reveal>
        <img src="{{ 'collection-coffee.svg' | asset_url }}" alt="Forma Coffee Table" width="1600" height="1100" loading="lazy">
        <div><strong>Forma Coffee Table</strong><b>Enquire ↗</b></div>
      </article>
      <article data-nc-reveal>
        <img src="{{ 'collection-side.svg' | asset_url }}" alt="Line Side Table" width="1600" height="1100" loading="lazy">
        <div><strong>Line Side Table</strong><b>Enquire ↗</b></div>
      </article>
    </div>
  </div>

  <div class="ncs-custom-form-wrap">
    <div class="ncs-custom-form-panel" data-nc-reveal>
      <span class="ncs-page-kicker">Bespoke</span>
      <h2 class="ncs-form-title">Your own design</h2>
      <p class="ncs-form-lead">Share your dimensions, marble preference and any reference images. We will respond with a quote and timeline.</p>

      {% form 'contact', class: 'ncs-b2b-form', id: 'NerocasaCustomForm' %}
        {% if form.posted_successfully? %}
          <p class="ncs-form-success">Thank you — your custom request has been received.</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="custom-enquiry">
          <div class="ncs-form-row">
            <label>Name<input type="text" name="contact[name]" required autocomplete="name"></label>
            <label>Email<input type="email" name="contact[email]" required autocomplete="email"></label>
          </div>
          <div class="ncs-form-row">
            <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel"></label>
            <label>Marble
              <select name="contact[marble_color]">
                <option>Ibiza White</option>
                <option>Beige Travertine</option>
                <option>Armani Grey</option>
                <option>Rosso Levanto</option>
              </select>
            </label>
          </div>

          <div class="ncs-custom-upload" data-upload-zone>
            <input id="NcCustomFile" type="file" accept="image/*" data-upload-input>
            <strong>Upload reference</strong>
            <span data-upload-name>Drag &amp; drop or click to choose an image.</span>
          </div>

          <div class="ncs-custom-dimension-grid">
            <label>Height (cm)<input type="number" min="1" step="0.1" name="contact[height_cm]" required placeholder="cm"></label>
            <label>Width (cm)<input type="number" min="1" step="0.1" name="contact[width_cm]" required placeholder="cm"></label>
            <label>Length (cm)<input type="number" min="1" step="0.1" name="contact[length_cm]" required placeholder="cm"></label>
          </div>
          <label class="ncs-form-full">Additional details<textarea name="contact[body]" rows="6" placeholder="Tell us about the design, finish or anything else we should know."></textarea></label>
          <button type="submit" class="ncs-btn">Submit Enquiry ↗</button>
        {% endif %}
      {% endform %}
      <p class="ncs-upload-note">Reference images are collected in the theme UI. Connect a file-upload endpoint before publishing if binary delivery is required.</p>
    </div>
  </div>
</section>

<script>
(function(){
  var zone=document.querySelector('[data-upload-zone]');
  var input=document.querySelector('[data-upload-input]');
  var name=document.querySelector('[data-upload-name]');
  if(!zone||!input)return;
  zone.addEventListener('click',function(e){if(e.target!==input)input.click()});
  ['dragenter','dragover'].forEach(function(type){zone.addEventListener(type,function(e){e.preventDefault();zone.classList.add('is-dragging')})});
  ['dragleave','drop'].forEach(function(type){zone.addEventListener(type,function(e){e.preventDefault();zone.classList.remove('is-dragging')})});
  zone.addEventListener('drop',function(e){if(e.dataTransfer.files.length){try{input.files=e.dataTransfer.files}catch(_){ } input.dispatchEvent(new Event('change',{bubbles:true}))}});
  input.addEventListener('change',function(){if(input.files&&input.files.length)name.textContent=input.files[0].name});
})();
</script>
{% schema %}{"name":"Ready Designs","presets":[{"name":"Ready Designs"}]}{% endschema %}
