<section class="ncs-article-page">
  {%- capture nc_hero_body -%}
  <header class="ncs-page-hero ncs-page-hero--compact ncs-article-hero" data-nc-reveal>
    <a class="ncs-article-back" href="{{ blog.url }}">← Journal</a>
    <span class="ncs-page-kicker">{{ blog.title | default: 'Journal' }}</span>
    <h1>{% render 'nc-title-gold', title: article.title %}</h1>
    <p class="ncs-article-meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time>
      {%- if article.tags.size > 0 -%}
        <span class="ncs-article-tags">
          {%- for tag in article.tags -%}
            <span>{{ tag }}</span>
          {%- endfor -%}
        </span>
      {%- endif -%}
    </p>
  </header>
  {%- endcapture -%}
  {% render 'nc-page-hero-shell',
    quiet: true,
    body: nc_hero_body,
    slab_left: 'hero-slab-white.jpg',
    slab_center: 'hero-slab-grey.jpg',
    slab_right: 'hero-slab-travertine.jpg'
  %}

  {%- liquid
    assign show_article_image = false
    if article.image
      assign article_img_src = article.image.src | downcase
      unless article_img_src contains 'nerocasa-brand-logo' or article_img_src contains 'nerocasa-logo' or article_img_src contains 'logo-user'
        assign show_article_image = true
      endunless
    endif
  -%}
  {%- if show_article_image -%}
    <figure class="ncs-article-featured" data-nc-reveal>
      <img
        src="{{ article.image | image_url: width: 1600 }}"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="1600"
        height="900"
        loading="eager"
      >
    </figure>
  {%- endif -%}

  <div class="ncs-article-content ncs-legal-body" data-nc-reveal>
    {{ article.content }}
  </div>

  <div class="ncs-article-cta" data-nc-reveal>
    <div class="ncs-article-cta-actions">
      {%- assign cta_collection = 'actions.our_collection' | t -%}
      {%- assign cta_custom = 'actions.custom_pieces' | t -%}
      <a class="ncs-btn ncs-btn--compact" href="{% render 'nc-collections-index-url' %}">{% render 'nc-title-gold', title: cta_collection %}</a>
      <a class="ncs-btn ncs-btn--outline ncs-btn--compact" href="{% render 'nc-page-url', handle: settings.page_custom_handle, view: 'custom' %}">{% render 'nc-title-gold', title: cta_custom %}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal article",
  "presets": [{ "name": "Journal article" }]
}
{% endschema %}
