<section class="ncs-collection-page">
  <header class="ncs-collection-header" data-nc-reveal>
    <h1>{{ collection.title }}</h1>
    <p class="ncs-collection-lead">{{ section.settings.lead | default: 'Three signature designs per collection. Each available in multiple stone finishes. Hover to preview on the grid, then choose your marble on the product page.' }}</p>
    {% if collection.description != blank %}
      <p class="ncs-collection-desc">{{ collection.description | strip_html }}</p>
    {% endif %}
    <span class="ncs-collection-count">3 designs</span>
  </header>

  <div class="ncs-grid-products">
    {% liquid
      assign catalog_category = 'coffee'
      if collection.handle == settings.collection_side or collection.handle == 'side-tables'
        assign catalog_category = 'side'
      elsif collection.handle == settings.collection_console or collection.handle == 'console-tables'
        assign catalog_category = 'console'
      endif
    %}
    {% render 'nc-catalog-cards', category: catalog_category, collection: collection %}
  </div>
</section>

{% schema %}
{
  "name": "Nerocasa Collection",
  "settings": [
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "Three signature designs per collection. Each available in multiple stone finishes. Hover to preview on the grid, then choose your marble on the product page."
    }
  ],
  "presets": [{ "name": "Nerocasa Collection" }]
}
{% endschema %}
