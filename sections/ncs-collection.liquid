<section class="ncs-collection-page">
  <header class="ncs-collection-header" data-nc-reveal>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html }}</p>
    {% endif %}
    <span class="ncs-collection-count">{{ collection.products_count }} object{% if collection.products_count != 1 %}s{% endif %}</span>
  </header>

  <div class="ncs-grid-products">
    {% for product in collection.products limit: 3 %}
      <a class="ncs-card" href="{{ product.url }}" data-nc-reveal>
        <div class="ncs-card-media">
          <img src="{% render 'nc-product-thumb', product: product %}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="1000">
        </div>
        <div class="ncs-card-info"><span>{{ product.title }}</span><b>{{ product.price | money }}</b></div>
      </a>
    {% else %}
      <div class="ncs-empty">No products are currently available in this collection.</div>
    {% endfor %}
  </div>
</section>

{% schema %}{"name":"Nerocasa Collection","presets":[{"name":"Nerocasa Collection"}]}{% endschema %}
