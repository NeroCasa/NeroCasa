<section class="ncs-info-page ncs-legal-page">
  {% render 'nc-page-hero-shell-open',
    slab_left: 'hero-slab-grey.jpg',
    slab_center: 'hero-slab-travertine.jpg',
    slab_right: 'hero-slab-white.jpg'
  %}
  <h1>{% render 'nc-title-gold', title: page.title | default: 'Terms and Conditions' %}</h1>
  {% render 'nc-page-hero-shell-close' %}
  <div class="ncs-legal-body">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      <p>Add your terms in <strong>Online Store → Pages → Terms &amp; Conditions</strong>. Content entered there will appear here automatically.</p>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"TERMS & CONDITIONS","presets":[{"name":"TERMS & CONDITIONS"}]}{% endschema %}
