<section class="ncs-info-page ncs-legal-page">
  <h1>{{ page.title | default: 'Terms & Conditions' }}</h1>
  <div class="ncs-legal-body">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      <p>Add your terms in <strong>Online Store → Pages → Terms &amp; Conditions</strong>. Content entered there will appear here automatically.</p>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"TERMS & CONDITIONS","presets":[{"name":"TERMS & CONDITIONS"}]}{% endschema %}
