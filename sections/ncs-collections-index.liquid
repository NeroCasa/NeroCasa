<section class="ncs-collections-page">
  <header class="ncs-page-hero" data-nc-reveal>
    <span class="ncs-page-kicker">Collections</span>
    <h1>Explore by <em>category</em></h1>
    <p>Architectural marble tables and objects, grouped by form and function.</p>
  </header>

  <div class="ncs-collections-list">
    <a href="{% render 'nc-collection-url', handle: settings.collection_coffee %}" data-nc-reveal>
      <img src="{{ 'collection-coffee.svg' | asset_url }}" alt="Coffee Tables" width="1600" height="1100" loading="lazy">
      <div><small>Coffee Tables</small><h2>Coffee Tables</h2><b>Explore ↗</b></div>
    </a>
    <a href="{% render 'nc-collection-url', handle: settings.collection_side %}" data-nc-reveal>
      <img src="{{ 'collection-side.svg' | asset_url }}" alt="Side Tables" width="1600" height="1100" loading="lazy">
      <div><small>Side Tables</small><h2>Side Tables</h2><b>Explore ↗</b></div>
    </a>
    <a href="{% render 'nc-collection-url', handle: settings.collection_console %}" data-nc-reveal>
      <img src="{{ 'collection-console.svg' | asset_url }}" alt="Console Tables" width="1600" height="1100" loading="lazy">
      <div><small>Console Tables</small><h2>Console Tables</h2><b>Explore ↗</b></div>
    </a>
    <a href="{% render 'nc-collection-url', handle: settings.collection_dining %}" data-nc-reveal>
      <img src="{{ 'collection-dining.svg' | asset_url }}" alt="Dining Tables" width="1600" height="1100" loading="lazy">
      <div><small>Dining Tables</small><h2>Dining Tables</h2><b>Explore ↗</b></div>
    </a>
  </div>
</section>

{% schema %}{"name":"Collections Index","presets":[{"name":"Collections Index"}]}{% endschema %}
