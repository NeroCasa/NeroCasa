{%- liquid
  assign coffee_handle = settings.collection_coffee | default: 'coffee-tables'
  assign side_handle = settings.collection_side | default: 'side-tables'
  assign console_handle = settings.collection_console | default: 'console-tables'
  assign the_9_handle = settings.collection_the_9 | default: 'the-9'
  assign coffee_coll = collections[coffee_handle]
  assign side_coll = collections[side_handle]
  assign console_coll = collections[console_handle]
  assign the_9_coll = collections[the_9_handle]
  assign show_type_tiles = false
  if request.page_type == 'collection'
    assign show_type_tiles = true
  endif
  assign index_heading = section.settings.heading
  if show_type_tiles and collection.title != blank
    assign index_heading = collection.title
  endif
-%}
<section class="ncs-collections-page{% unless show_type_tiles %} ncs-collections-page--index{% endunless %}">
  {%- if show_type_tiles -%}
    {% render 'nc-page-hero-shell-open',
      quiet: true,
      slab_left: 'hero-slab-red.jpg',
      slab_center: 'hero-slab-green.jpg',
      slab_right: 'hero-slab-travertine.jpg',
      left_image: section.settings.hero_slab_left,
      center_image: section.settings.hero_slab_center,
      right_image: section.settings.hero_slab_right
    %}
    <header class="ncs-page-hero ncs-page-hero--compact" data-nc-reveal>
      <h1>{% render 'nc-title-gold', title: index_heading %}</h1>
      {%- if collection.description != blank -%}
        <p class="ncs-collections-lead">{{ collection.description | strip_html }}</p>
      {%- endif -%}
    </header>
    {% render 'nc-page-hero-shell-close' %}
  {%- endif -%}

  <div class="ncs-collections-list ncs-collections-list--grid">
    {%- if show_type_tiles -%}
      {%- assign skip = ',all,' | append: the_9_handle | append: ',' -%}
      {%- if coffee_coll != blank -%}
        {% render 'nc-collection-tile', collection: coffee_coll, cover: section.settings.cover_coffee, subtitle: section.settings.coffee_subtitle %}
        {%- assign skip = skip | append: coffee_handle | append: ',' -%}
      {%- endif -%}
      {%- if side_coll != blank -%}
        {% render 'nc-collection-tile', collection: side_coll, cover: section.settings.cover_side, subtitle: section.settings.side_subtitle %}
        {%- assign skip = skip | append: side_handle | append: ',' -%}
      {%- endif -%}
      {%- if console_coll != blank -%}
        {% render 'nc-collection-tile', collection: console_coll, cover: section.settings.cover_console, subtitle: section.settings.console_subtitle %}
        {%- assign skip = skip | append: console_handle | append: ',' -%}
      {%- endif -%}
    {%- else -%}
      {%- assign skip = ',all,' | append: coffee_handle | append: ',' | append: side_handle | append: ',' | append: console_handle | append: ',' -%}
      {%- if the_9_coll != blank -%}
        {% render 'nc-collection-tile', collection: the_9_coll, cover: section.settings.cover_the_9, cover_product_handle: 'cft-3', cover_marble: 'Rosso Levanto' %}
        {%- assign skip = skip | append: the_9_handle | append: ',' -%}
      {%- endif -%}
      {%- for collection in collections -%}
        {%- assign needle = ',' | append: collection.handle | append: ',' -%}
        {%- unless skip contains needle -%}
          {% render 'nc-collection-tile', collection: collection %}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections Index",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our collections"
    },
    {
      "type": "header",
      "content": "Hero images"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_left",
      "label": "Hero slab — left"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_center",
      "label": "Hero slab — center"
    },
    {
      "type": "image_picker",
      "id": "hero_slab_right",
      "label": "Hero slab — right"
    },
    {
      "type": "header",
      "content": "Collection covers"
    },
    {
      "type": "image_picker",
      "id": "cover_the_9",
      "label": "The 9 cover",
      "info": "Used on the Collections index. Optional. Else uses the collection image in Admin, then the first product image."
    },
    {
      "type": "text",
      "id": "the_9_subtitle",
      "label": "The 9 subtitle",
      "default": "Coffee, side and console tables"
    },
    {
      "type": "image_picker",
      "id": "cover_coffee",
      "label": "Coffee Tables cover",
      "info": "Optional. Else uses the collection image in Admin, then the first product image."
    },
    {
      "type": "image_picker",
      "id": "cover_side",
      "label": "Side Tables cover"
    },
    {
      "type": "image_picker",
      "id": "cover_console",
      "label": "Console Tables cover"
    },
    {
      "type": "text",
      "id": "coffee_subtitle",
      "label": "Coffee subtitle",
      "default": "Living room pieces"
    },
    {
      "type": "text",
      "id": "side_subtitle",
      "label": "Side subtitle",
      "default": "Beside the sofa or bed"
    },
    {
      "type": "text",
      "id": "console_subtitle",
      "label": "Console subtitle",
      "default": "Hallway and entry"
    }
  ],
  "presets": [{ "name": "Collections Index" }]
}
{% endschema %}
