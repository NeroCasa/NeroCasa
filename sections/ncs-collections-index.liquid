<section class="ncs-collections-page">
  <header class="ncs-page-hero" data-nc-reveal>
    <span class="ncs-page-kicker">Collections</span>
    <h1>{% render 'nc-title-gold', title: section.settings.heading %}</h1>
    <p>{{ section.settings.lead }}</p>
  </header>

  <div class="ncs-collections-list ncs-collections-list--grid">
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_coffee %}" data-nc-reveal>
      <div class="ncs-fit-img ncs-fit-img--tile ncs-fit-img--compact">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_coffee %}" alt="Coffee Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label">
        <h2>{% render 'nc-title-gold', title: 'Coffee Tables' %}</h2>
        <small>{{ section.settings.coffee_subtitle }}</small>
      </div>
    </a>
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_side %}" data-nc-reveal>
      <div class="ncs-fit-img ncs-fit-img--tile ncs-fit-img--compact">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_side %}" alt="Side Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label">
        <h2>{% render 'nc-title-gold', title: 'Side Tables' %}</h2>
        <small>{{ section.settings.side_subtitle }}</small>
      </div>
    </a>
    <a class="ncs-collection-tile" href="{% render 'nc-collection-url', handle: settings.collection_console %}" data-nc-reveal>
      <div class="ncs-fit-img ncs-fit-img--tile ncs-fit-img--compact">
        <img src="{% render 'nc-collection-cover', handle: settings.collection_console %}" alt="Console Tables" width="1600" height="1200" loading="lazy">
      </div>
      <div class="ncs-collection-tile-label">
        <h2>{% render 'nc-title-gold', title: 'Console Tables' %}</h2>
        <small>{{ section.settings.console_subtitle }}</small>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Collections Index",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The marble collections"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Marble furniture shaped for living. Explore the collections, preview finishes on each piece, and choose your stone on the product page."
    },
    {
      "type": "text",
      "id": "coffee_subtitle",
      "label": "Coffee subtitle",
      "default": "Living room pieces"
    },
    {
      "type": "text",
      "id": "side_subtitle",
      "label": "Side subtitle",
      "default": "Beside the sofa or bed"
    },
    {
      "type": "text",
      "id": "console_subtitle",
      "label": "Console subtitle",
      "default": "Hallway and entry"
    }
  ],
  "presets": [{ "name": "Collections Index" }]
}
{% endschema %}
