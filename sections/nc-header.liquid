<header class="nc-header" data-header>
  <button
    type="button"
    class="nc-menu-toggle"
    data-mobile-menu-toggle
    data-label-open="{{ 'nav.open_menu' | t }}"
    data-label-close="{{ 'nav.close_menu' | t }}"
    aria-label="{{ 'nav.open_menu' | t }}"
    aria-expanded="false"
    aria-controls="nc-mobile-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <a class="nc-logo-brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: 'Nerocasa' }} home">
    {% if settings.logo != blank %}
      <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ settings.brand_name | default: 'NEROCASA' }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="eager">
    {% else %}
      {%- comment -%}
        CSS renders this at 44px tall. asset_url would ship the full 1600x1600
        source, so route the bundled logo through the CDN resizer instead.
      {%- endcomment -%}
      <img src="{{ 'nerocasa-logo-user.png' | asset_img_url: '240x' }}" alt="{{ settings.brand_name | default: 'NEROCASA' }}" width="240" height="240" loading="eager">
    {% endif %}
  </a>

  <nav class="nc-nav" aria-label="{{ 'nav.primary' | t }}">
    <a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' %}is-active{% endif %}">{{ 'nav.home' | t }}</a>
    <a href="{% render 'nc-collections-index-url' %}" class="{% if request.page_type == 'collection' or request.page_type == 'list-collections' %}is-active{% endif %}">{{ 'nav.collections' | t }}</a>
    <a href="{% render 'nc-page-url', handle: settings.page_custom_handle, view: 'custom' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_custom_handle %}is-active{% endif %}">{{ 'nav.custom' | t }}</a>
    <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_b2b_handle %}is-active{% endif %}">{{ 'nav.b2b' | t }}</a>
    <a href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_about_handle %}is-active{% endif %}">{{ 'nav.why' | t }}</a>
  </nav>

  <div class="nc-actions">
    <a class="nc-icon-link" href="{{ routes.cart_url }}" aria-label="{{ 'nav.cart' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2.1 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
      {% if cart.item_count > 0 %}<span class="nc-cart-count" data-cart-count>{{ cart.item_count }}</span>{% endif %}
    </a>
  </div>
</header>

<nav class="nc-mobile-menu" id="nc-mobile-menu" data-mobile-menu hidden aria-label="{{ 'nav.mobile' | t }}">
  <a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' %}is-active{% endif %}">{{ 'nav.home' | t }}</a>
  <a href="{% render 'nc-collections-index-url' %}" class="{% if request.page_type == 'collection' or request.page_type == 'list-collections' %}is-active{% endif %}">{{ 'nav.collections' | t }}</a>
  <a href="{% render 'nc-page-url', handle: settings.page_custom_handle, view: 'custom' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_custom_handle %}is-active{% endif %}">{{ 'nav.custom' | t }}</a>
  <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_b2b_handle %}is-active{% endif %}">{{ 'nav.b2b' | t }}</a>
  <a href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_about_handle %}is-active{% endif %}">{{ 'nav.why' | t }}</a>
</nav>

<script>
(function(){
  var menuToggle=document.querySelector('[data-mobile-menu-toggle]');
  var mobileMenu=document.querySelector('[data-mobile-menu]');
  function closeMenu(){
    if(!mobileMenu)return;
    mobileMenu.hidden=true;
    mobileMenu.classList.remove('is-open');
    if(menuToggle){
      menuToggle.setAttribute('aria-expanded','false');
      menuToggle.setAttribute('aria-label', menuToggle.getAttribute('data-label-open') || 'Open menu');
    }
    document.body.classList.remove('nc-menu-open');
  }
  function openMenu(){
    if(!mobileMenu)return;
    mobileMenu.hidden=false;
    mobileMenu.classList.add('is-open');
    if(menuToggle){
      menuToggle.setAttribute('aria-expanded','true');
      menuToggle.setAttribute('aria-label', menuToggle.getAttribute('data-label-close') || 'Close menu');
    }
    document.body.classList.add('nc-menu-open');
  }
  if(mobileMenu){
    mobileMenu.hidden=true;
    mobileMenu.classList.remove('is-open');
  }
  if(menuToggle&&mobileMenu){
    menuToggle.addEventListener('click',function(){
      if(mobileMenu.hidden)openMenu();else closeMenu();
    });
    mobileMenu.querySelectorAll('a').forEach(function(link){
      link.addEventListener('click',closeMenu);
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape'&&!mobileMenu.hidden)closeMenu();
    });
  }
})();
</script>
{% schema %}{"name":"Nerocasa Header"}{% endschema %}
