<header class="nc-header" data-header>
  <button
    type="button"
    class="nc-menu-toggle"
    data-mobile-menu-toggle
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nc-mobile-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <a class="nc-logo-brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: 'Nerocasa' }} home">
    {% if settings.logo != blank %}
      <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ settings.brand_name | default: 'NEROCASA' }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="eager">
    {% else %}
      {%- comment -%}
        CSS renders this at 44px tall. asset_url would ship the full 1600x1600
        source, so route the bundled logo through the CDN resizer instead.
      {%- endcomment -%}
      <img src="{{ 'nerocasa-logo-user.png' | asset_img_url: '240x' }}" alt="{{ settings.brand_name | default: 'NEROCASA' }}" width="240" height="240" loading="eager">
    {% endif %}
  </a>

  <nav class="nc-nav" aria-label="Primary navigation">
    <a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' %}is-active{% endif %}">Home</a>
    <a href="{% render 'nc-collections-index-url' %}" class="{% if request.page_type == 'collection' or request.page_type == 'list-collections' %}is-active{% endif %}">Collections</a>
    <a href="{% render 'nc-page-url', handle: settings.page_custom_handle, view: 'custom' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_custom_handle %}is-active{% endif %}">Custom</a>
    <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_b2b_handle %}is-active{% endif %}">B2B</a>
    <a href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_about_handle %}is-active{% endif %}">Why Nerocasa</a>
  </nav>

  <div class="nc-actions">
    <button type="button" class="nc-icon-link" data-search-open aria-label="Search" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
    </button>
    <a class="nc-icon-link" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2.1 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
      {% if cart.item_count > 0 %}<span class="nc-cart-count" data-cart-count>{{ cart.item_count }}</span>{% endif %}
    </a>
  </div>
</header>

<nav class="nc-mobile-menu" id="nc-mobile-menu" data-mobile-menu hidden aria-label="Mobile navigation">
  <a href="{{ routes.root_url }}" class="{% if request.page_type == 'index' %}is-active{% endif %}">Home</a>
  <a href="{% render 'nc-collections-index-url' %}" class="{% if request.page_type == 'collection' or request.page_type == 'list-collections' %}is-active{% endif %}">Collections</a>
  <a href="{% render 'nc-page-url', handle: settings.page_custom_handle, view: 'custom' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_custom_handle %}is-active{% endif %}">Custom</a>
  <a href="{% render 'nc-page-url', handle: settings.page_b2b_handle, view: 'b2b' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_b2b_handle %}is-active{% endif %}">B2B</a>
  <a href="{% render 'nc-page-url', handle: settings.page_about_handle, view: 'about' %}" class="{% if request.page_type == 'page' and page.handle == settings.page_about_handle %}is-active{% endif %}">Why Nerocasa</a>
</nav>

<div class="nc-search-overlay" data-search-overlay hidden>
  <div class="nc-search-panel" data-search-panel>
    <form action="{{ routes.search_url }}" method="get" role="search" class="nc-search-form" data-search-form>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search Soglia, collections, marble…" aria-label="Search" autocomplete="off" data-search-input>
      <button type="submit" aria-label="Submit search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
      </button>
    </form>
    <button type="button" class="nc-search-close" data-search-close aria-label="Close search">×</button>
  </div>
</div>

<script>
(function(){
  var menuToggle=document.querySelector('[data-mobile-menu-toggle]');
  var mobileMenu=document.querySelector('[data-mobile-menu]');
  function closeMenu(){
    if(!mobileMenu)return;
    mobileMenu.hidden=true;
    mobileMenu.classList.remove('is-open');
    if(menuToggle){
      menuToggle.setAttribute('aria-expanded','false');
      menuToggle.setAttribute('aria-label','Open menu');
    }
    document.body.classList.remove('nc-menu-open');
  }
  function openMenu(){
    if(!mobileMenu)return;
    mobileMenu.hidden=false;
    mobileMenu.classList.add('is-open');
    if(menuToggle){
      menuToggle.setAttribute('aria-expanded','true');
      menuToggle.setAttribute('aria-label','Close menu');
    }
    document.body.classList.add('nc-menu-open');
  }
  if(mobileMenu){
    mobileMenu.hidden=true;
    mobileMenu.classList.remove('is-open');
  }
  if(menuToggle&&mobileMenu){
    menuToggle.addEventListener('click',function(){
      if(mobileMenu.hidden)openMenu();else closeMenu();
    });
    mobileMenu.querySelectorAll('a').forEach(function(link){
      link.addEventListener('click',closeMenu);
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape'&&!mobileMenu.hidden)closeMenu();
    });
  }

  var buttons=document.querySelectorAll('[data-search-open]');
  var overlay=document.querySelector('[data-search-overlay]');
  if(!overlay)return;
  var panel=overlay.querySelector('[data-search-panel]');
  var close=overlay.querySelector('[data-search-close]');
  var form=overlay.querySelector('[data-search-form]');
  var input=overlay.querySelector('[data-search-input]');
  var searchBase={{ routes.search_url | json }};

  function openSearch(){
    closeMenu();
    overlay.hidden=false;
    document.body.classList.add('nc-search-open');
    buttons.forEach(function(b){b.setAttribute('aria-expanded','true')});
    if(input)setTimeout(function(){input.focus();input.select()},40);
  }
  function closeSearch(){
    overlay.hidden=true;
    document.body.classList.remove('nc-search-open');
    buttons.forEach(function(b){b.setAttribute('aria-expanded','false')});
  }
  function goSearch(q){
    q=(q||'').trim();
    if(!q)return;
    window.location.href=searchBase+(searchBase.indexOf('?')>-1?'&':'?')+'q='+encodeURIComponent(q);
  }

  buttons.forEach(function(b){b.addEventListener('click',openSearch)});
  if(close)close.addEventListener('click',closeSearch);
  overlay.addEventListener('click',function(e){if(e.target===overlay)closeSearch()});
  if(panel)panel.addEventListener('click',function(e){e.stopPropagation()});
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&!overlay.hidden)closeSearch();
    if(e.key==='/'&&!overlay.hidden&&document.activeElement!==input){
      e.preventDefault();
      if(input)input.focus();
    }
  });
  if(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      goSearch(input?input.value:'');
    });
  }
})();
</script>
{% schema %}{"name":"Nerocasa Header"}{% endschema %}
