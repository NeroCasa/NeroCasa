.nc-loader {
  position: fixed;
  inset: 0;
  z-index: 4000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nc-bg, #080807);
  pointer-events: none;
  opacity: 1;
  animation: nc-loader-hold 1.6s var(--nc-ease, cubic-bezier(0.22, 1, 0.36, 1)) forwards;
}

@keyframes nc-loader-hold {
  0%, 55% { opacity: 1; }
  100% { opacity: 0; visibility: hidden; }
}

.nc-loader.is-done {
  opacity: 0;
  visibility: hidden;
}

.nc-loader-mark {
  font-family: var(--nc-display);
  font-size: clamp(18px, 2.4vw, 28px);
  letter-spacing: 0.42em;
  color: var(--nc-ink);
  padding-left: 0.42em;
}

.nc-cursor {
  position: fixed;
  top: 0; left: 0;
  z-index: 9999;
  pointer-events: none;
  transform: translate(-999px, -999px);
  transition: transform 0.08s linear;
}
.nc-cursor-dot {
  display: block;
  width: 5px; height: 5px;
  background: var(--nc-gold);
  border-radius: 50%;
  position: absolute;
  transform: translate(-2.5px, -2.5px);
  transition: transform 0.15s cubic-bezier(0.22,1,0.36,1);
}
.nc-cursor-ring {
