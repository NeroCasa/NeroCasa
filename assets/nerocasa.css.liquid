  margin: 0;
}

.ncs-b2b-copy-col .ncs-b2b-detail:first-child {
  margin-top: 0;
}

.ncs-b2b-copy .ncs-ledger,
.ncs-b2b-copy .ncs-process {
  max-width: none;
}

.ncs-b2b-copy .ncs-ledger {
  margin-top: 28px;
}

.ncs-b2b-form-wrap {
  justify-self: center;
  width: 100%;
}

.ncs-b2b-layout--copyform .ncs-b2b-form-panel {
  padding: 28px 40px;
}

.ncs-b2b-layout--copyform .ncs-b2b-form textarea {
  min-height: 88px;
}

.ncs-about-hero-split {
  align-items: stretch;
}

.ncs-about-hero-copy {
  max-width: none;
}

.ncs-about-hero-lead {
  max-width: 54ch;
}

.ncs-about-hero-visual.nc-brand-visual-frame {
  min-height: clamp(280px, 36vw, 460px);
  border: 1px solid var(--nc-gold);
  background: #080807;
}

.ncs-about-entity p {
  max-width: none;
}

.ncs-about-closer-actions--end {
  display: flex;
  justify-content: center;
}

.ncs-legal-page .ncs-page-hero {
  max-width: none;
}

.ncs-legal-shell {
  padding: 0 8vw var(--nc-space-lg);
}

.ncs-legal-page .ncs-legal-body {
  max-width: none !important;
  padding: 8px 0 0;
  display: block;
  column-count: 2;
  column-gap: clamp(32px, 6vw, 80px);
  column-rule: 1px solid rgba(165, 123, 0, 0.22);
}

.ncs-legal-page .ncs-legal-body > * {
  break-inside: avoid;
}

.ncs-legal-page .ncs-legal-body h2,
.ncs-legal-page .ncs-legal-body h3 {
  margin-top: 12px;
  margin-bottom: 8px;
}

.ncs-legal-page .ncs-legal-body h2:first-child,
.ncs-legal-page .ncs-legal-body h3:first-child {
  margin-top: 0;
}

.ncs-legal-page .ncs-legal-body p:not(h2 ~ p):not(h3 ~ p) {
  column-span: all;
}

.ncs-legal-page .ncs-legal-body > div:only-child {
  column-count: 2;
  column-gap: inherit;
  column-rule: inherit;
}

.ncs-article-page .ncs-legal-body {
  max-width: min(1100px, 84vw) !important;
  display: block;
  column-count: 1;
}

.ncs-btn .nc-gold {
  color: #080807 !important;
}

.ncs-btn--outline,
.ncs-btn--ghost {
  color: var(--nc-ink) !important;
}

.ncs-btn--outline .nc-gold,
.ncs-btn--ghost .nc-gold {
  color: var(--nc-gold) !important;
}

.ncs-hero-ctas .ncs-btn--ghost:hover .nc-gold,
.ncs-btn:hover .nc-gold {
  color: #080807 !important;
}

.ncs-btn--outline:hover .nc-gold,
.ncs-btn--ghost:hover .nc-gold {
  color: var(--nc-gold) !important;
}

.ncs-home-family-head a .nc-gold {
  color: var(--nc-gold);
}

@media (max-width: 960px) {
  .ncs-b2b-copy,
  .ncs-about-manifesto,
  .ncs-about-values,
  .ncs-about-closer-grid {
    grid-template-columns: 1fr !important;
  }

  .ncs-legal-page .ncs-legal-body,
  .ncs-legal-page .ncs-legal-body > div:only-child {
    column-count: 1;
    column-rule: 0;
  }

  .ncs-b2b-layout--copyform .ncs-b2b-form-panel {
    padding: 24px 20px;
  }
}

@media (max-width: 900px) {
  .ncs-size-mode-row {
    gap: 20px;
  }

  .ncs-spec-grid {
    grid-template-columns: none;
  }

  .ncs-b2b-layout.ncs-b2b-layout--copyform,
  .ncs-b2b-layout.ncs-b2b-layout--stack,
  .ncs-b2b-layout.ncs-b2b-layout--split {
    padding: calc(var(--nc-header-h) + 48px) 6vw var(--nc-space-md);
  }

  .ncs-b2b-layout--copyform .ncs-b2b-header {
    padding-top: 0;
  }

  .ncs-legal-shell {
    padding: 0 6vw var(--nc-space-lg);
  }
}


.nc-grain {
  z-index: 2;
}
#MainContent {
  position: relative;
  z-index: 1;
}
