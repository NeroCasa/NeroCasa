/* NeroCasa — single storefront cascade. Fonts are self-hosted latin woff2. */
@font-face {
  font-family: "Cormorant Garamond";
  font-style: normal;
  font-weight: 300;
  font-display: swap;
  src: url({{ 'cormorant-garamond-latin-300-normal.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Cormorant Garamond";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url({{ 'cormorant-garamond-latin-400-normal.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Cormorant Garamond";
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url({{ 'cormorant-garamond-latin-500-normal.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Cormorant Garamond";
  font-style: italic;
  font-weight: 300;
  font-display: swap;
  src: url({{ 'cormorant-garamond-latin-300-italic.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Cormorant Garamond";
  font-style: italic;
  font-weight: 400;
  font-display: swap;
  src: url({{ 'cormorant-garamond-latin-400-italic.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Inter";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url({{ 'inter-latin-400-normal.woff2' | asset_url }}) format("woff2");
}
@font-face {
  font-family: "Inter";
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url({{ 'inter-latin-500-normal.woff2' | asset_url }}) format("woff2");
}

:root {
  --nc-bg:#080807;--nc-panel:#10100e;--nc-ink:#f2eee6;--nc-muted:#9d978d;
  --nc-line:rgba(242,238,230,.12);--nc-gold:#A57B00;
  --nc-display:"Cormorant Garamond",Didot,"Bodoni 72",serif;
  --nc-ui:"Inter","Helvetica Neue",Arial,sans-serif;
}
* {box-sizing:border-box}
html {scroll-behavior:smooth}
body {margin:0;background:var(--nc-bg);color:var(--nc-ink);font-family:var(--nc-ui);font-weight:300;letter-spacing:.01em}
body.nc-search-open {overflow:hidden}
a {color:inherit;text-decoration:none}
button,
input,
select,
textarea {font:inherit;color:inherit}
img {max-width:100%}

.nc-header {position:fixed;z-index:100;top:0;left:0;right:0;height:82px;padding:0 4.5vw;display:grid;grid-template-columns:190px 1fr 190px;align-items:center;gap:30px;border-bottom:1px solid rgba(165,123,0,.2);background:rgba(8,8,7,.9);transition:background .35s,border-color .35s}
.nc-header.is-scrolled {background:rgba(8,8,7,.9);border-color:rgba(165,123,0,.2)}
.nc-logo-brand {width:150px;height:55px;display:flex;align-items:center}
.nc-logo-brand img {width:100%;height:100%;object-fit:contain;object-position:left center}
.nc-nav {display:flex;justify-content:center;gap:28px;text-transform:uppercase;font-size:9px;letter-spacing:.16em}
.nc-nav a {opacity:.72;transition:opacity .25s,color .25s}
.nc-nav a:hover,
.nc-nav a.is-active {opacity:1;color:var(--nc-gold)}
.nc-mobile-menu a.is-active {color:var(--nc-gold);opacity:1}
.nc-actions {display:flex;justify-content:flex-end;gap:10px}
.nc-icon-link {width:35px;height:35px;display:inline-flex;align-items:center;justify-content:center;border:0;background:none;position:relative;cursor:pointer}
.nc-icon-link svg {width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.35}
.nc-cart-count {position:absolute;top:0;right:-2px;min-width:14px;height:14px;padding:0 3px;border-radius:50%;background:var(--nc-gold);color:#080807;font-size:7px;display:flex;align-items:center;justify-content:center}
.ncs-cart-added {margin:10px 0 0;font-size:11px;letter-spacing:.04em;color:var(--nc-gold)}
.ncs-cart-line-sku {display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.55;margin-top:4px}

.nc-menu-toggle {display:none;align-items:center;justify-content:center;width:40px;height:40px;padding:0;border:0;background:none;cursor:pointer;flex-direction:column;gap:5px}
.nc-menu-toggle span {display:block;width:18px;height:1px;background:var(--nc-ink);transition:transform .25s,opacity .25s}
.nc-menu-toggle[aria-expanded=true] span:nth-child(1) {transform:translateY(6px) rotate(45deg)}
.nc-menu-toggle[aria-expanded=true] span:nth-child(2) {opacity:0}
.nc-menu-toggle[aria-expanded=true] span:nth-child(3) {transform:translateY(-6px) rotate(-45deg)}
.nc-mobile-menu {display:none!important;position:fixed;top:var(--nc-header-h,82px);left:0;right:0;bottom:0;z-index:95;padding:28px 24px 40px;background:rgba(8,8,7,.97);backdrop-filter:blur(12px);flex-direction:column;gap:0;overflow-y:auto}
.nc-mobile-menu.is-open {display:flex!important}
.nc-mobile-menu a {display:block;padding:18px 0;border-bottom:1px solid var(--nc-line);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--nc-ink);opacity:.82}
.nc-mobile-menu a.is-active,
.nc-mobile-menu a:hover {color:var(--nc-gold);opacity:1}
body.nc-menu-open {overflow:hidden}

.nc-search-overlay {position:fixed;inset:0;z-index:200;background:rgba(8,8,7,.88);backdrop-filter:blur(10px)}
.nc-search-overlay[hidden] {display:none!important;pointer-events:none}
.nc-search-panel {max-width:900px;margin:0 auto;padding:18vh 5vw;display:flex;gap:30px;align-items:flex-start;pointer-events:auto}
.nc-search-form {flex:1;display:flex;border-bottom:1px solid rgba(242,238,230,.4)}
.nc-search-form input {width:100%;padding:14px 0;background:none;border:0;outline:0;font-size:clamp(28px,4vw,52px);font-family:var(--nc-display)}
.nc-search-form button,
.nc-search-close {border:0;background:none;cursor:pointer}
.nc-search-form button svg {width:25px;fill:none;stroke:currentColor}
.nc-search-close {font-size:28px}

.ncs-home-hero {height:100vh;min-height:650px;position:relative;overflow:hidden;background:var(--nc-bg,#080807)}
/* Hero slab / overlay / page-hero-shell rules removed from here — they were
   byte-for-byte duplicated (and fully superseded) by nerocasa-luxury.css,
   which loads after this file. Keeping one authoritative copy avoids two
   files drifting out of sync. See nerocasa-luxury.css for the live rules. */
.ncs-hero-content {position:absolute;inset:0;display:grid;place-items:center;z-index:2}
.ncs-hero-content h1 {font-family:var(--nc-display);font-weight:400;font-size:clamp(70px,13vw,210px);line-height:.72;letter-spacing:-.055em;margin:0}

.ncs-collections-list .ncs-fit-img {
  width: 100%;
  aspect-ratio: 4 / 5;
}

.ncs-collections-list .ncs-fit-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ncs-collections-list>a:hover img {filter:brightness(.98) saturate(.92)}
.ncs-collections-list>a:after {display:none}
.ncs-collections-list .ncs-collection-tile-label {position:static;left:auto;bottom:auto}
.ncs-collections-list small {display:block;color:var(--nc-gold);font-size:8px;letter-spacing:.2em;margin-bottom:8px}

.ncs-story-body p {margin:0 0 14px;line-height:1.75;color:rgba(242,238,230,.82)}
.ncs-story-body p:last-child {margin-bottom:0}
.ncs-story-body strong {color:var(--nc-gold);font-weight:500}

.ncs-btn {display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:18px 36px;border:1px solid var(--nc-gold);background:var(--nc-gold);color:#080807;font-size:11px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .25s,color .25s,transform .2s,box-shadow .25s;box-shadow:0 4px 20px rgba(165,123,0,.28)}
.ncs-btn:hover {background:#c49200;border-color:#c49200;color:#080807;transform:translateY(-2px);box-shadow:0 8px 28px rgba(165,123,0,.4)}

.ncs-collections-page,
.ncs-collection-page {padding:14vw 6vw 9vw;background:var(--nc-bg)}
.ncs-collections-page header .ncs-page-kicker,
.ncs-collection-header .ncs-page-kicker {font-size:8px;color:var(--nc-gold);letter-spacing:.22em}
.ncs-collections-page h1,
.ncs-collection-header h1 {font-family:var(--nc-display);font-weight:400;font-size:clamp(70px,11vw,160px);line-height:.76;letter-spacing:-.055em;margin:22px 0 7vw}
.ncs-collection-header p {max-width:620px;color:var(--nc-muted);line-height:1.7;font-size:13px;margin:-5vw 0 6vw}
.ncs-collections-list {display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ncs-collections-list>a {position:relative;min-height:0;overflow:visible}
.ncs-collections-list .ncs-collection-tile-label {position:static;left:auto;bottom:auto}
.ncs-collections-list h2 {font-family:var(--nc-display);font-weight:400;font-size:clamp(42px,5vw,76px);margin:0 0 12px;line-height:.85}
.ncs-collections-list b {font-size:8px;letter-spacing:.18em;font-weight:400;color:var(--nc-gold)}
.ncs-grid-products {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 20px;align-items:stretch}
.ncs-card {display:flex;flex-direction:column;gap:14px;background:transparent;min-width:0}
.ncs-card-media {overflow:hidden;background:var(--nc-bg)}
.ncs-grid-products .ncs-fit-img,
.ncs-card-media.ncs-fit-img {aspect-ratio:4/5}
.ncs-grid-products .ncs-fit-img img,
.ncs-card-media.ncs-fit-img img {width:100%;height:100%;object-fit:cover!important}
.ncs-card-info {display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:0;border-bottom:0}
.ncs-card-info span {font-size:9px;letter-spacing:.15em;text-transform:uppercase}
.ncs-card-info b {font-size:9px;color:var(--nc-gold);font-weight:400;white-space:nowrap}
.ncs-empty {color:var(--nc-muted);padding:50px 0;font-size:12px}

.ncs-product-page {display:grid;grid-template-columns:1.12fr .88fr;gap:7vw;padding:9vw 6vw 7vw;background:var(--nc-bg)}
.ncs-product-gallery {position:sticky;top:30px;height:max-content}
.ncs-main-product-image {background:transparent;overflow:visible;display:block;padding:0;min-height:0}
.ncs-main-product-image img {width:100%;height:auto;max-width:100%;aspect-ratio:auto;object-fit:unset;display:block;transition:opacity .2s}
.ncs-product-kicker {font-size:8px;color:var(--nc-gold);letter-spacing:.22em}
.ncs-product-config h1 {font-family:var(--nc-display);font-weight:400;font-size:clamp(54px,6vw,95px);line-height:.8;letter-spacing:-.05em;margin:18px 0}
.ncs-product-number {font-size:9px;color:var(--nc-muted);letter-spacing:.12em}
.ncs-availability {font-size:8px;letter-spacing:.18em;color:var(--nc-muted);margin-top:20px}
.ncs-price {border-block:1px solid var(--nc-line);padding:22px 0;margin:28px 0}
.ncs-price span {font-family:var(--nc-display);font-size:30px}
.ncs-price small {display:block;color:#777269;font-size:7px;letter-spacing:.18em;margin-top:7px}
.ncs-compare-price {color:var(--nc-muted);font-size:12px;margin-left:10px}
.ncs-short-desc {color:var(--nc-muted);font-size:13px;line-height:1.8}
.ncs-short-desc p {margin:0}
.ncs-product-note,
.ncs-dimension-note {color:var(--nc-muted);font-size:12px;line-height:1.7;margin:10px 0 0;letter-spacing:.02em}
.ncs-dimension-note {margin:0 0 14px}
.ncs-fixed-dimensions .ncs-product-note {margin-top:12px}
.ncs-dimension-note {margin:0 0 14px}
.ncs-choice,
.ncs-size-mode {margin:30px 0}
.ncs-choice>label,
.ncs-size-mode>label {display:block;font-size:8px;letter-spacing:.2em;color:var(--nc-muted);margin-bottom:12px}
.ncs-choice-row {display:flex;flex-wrap:wrap;gap:7px}
.ncs-choice-row button,
.ncs-size-mode-row button {background:transparent;border:1px solid var(--nc-line);padding:13px 15px;font-size:9px;letter-spacing:.1em;cursor:pointer}
.ncs-choice-row button.is-active,
.ncs-choice-row button:hover,
.ncs-size-mode-row button.is-active {border-color:var(--nc-gold);color:var(--nc-gold)}
.ncs-size-mode-row {display:grid;grid-template-columns:1fr 1fr;gap:7px}
.ncs-fixed-dimensions {margin-top:18px}
.ncs-fixed-size-title {font-size:8px;letter-spacing:.16em;color:var(--nc-muted);margin-bottom:10px}
.ncs-fixed-dimensions-values {display:flex;gap:7px;flex-wrap:wrap}
.ncs-dim-set {display:flex;flex-wrap:wrap;align-items:center;gap:7px;width:100%}
.ncs-dim-set + .ncs-dim-set {margin-top:8px}
.ncs-dim-set small,
.ncs-dim-set-label {width:100%;font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--nc-muted)}
.ncs-dim-set-label {margin:14px 0 8px}
.ncs-fixed-dimensions-values span {padding:11px 13px;border:1px solid var(--nc-line);font-size:10px}
.ncs-fixed-dimensions-values b {color:var(--nc-gold);margin-right:4px}
.ncs-custom-whatsapp-box {display:flex;align-items:center;justify-content:center;width:100%;margin-top:18px;padding:18px;border:1px solid var(--nc-gold);background:var(--nc-gold);color:#080807;font-size:11px;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;cursor:pointer;box-shadow:0 4px 20px rgba(165,123,0,.28);transition:background .25s,transform .2s,box-shadow .25s}
.ncs-custom-whatsapp-box:hover {background:#c49200;border-color:#c49200;color:#080807;transform:translateY(-2px);box-shadow:0 8px 28px rgba(165,123,0,.4)}
.ncs-buy {border-top:1px solid var(--nc-line);padding-top:22px;margin-top:38px}
.ncs-buy>div span {display:block;font-size:7px;letter-spacing:.2em;color:var(--nc-muted)}
.ncs-buy>div b {display:block;font-size:10px;font-weight:400;margin-top:7px}
.ncs-selected-dimensions {display:block;color:var(--nc-muted);font-size:8px;letter-spacing:.13em;margin-top:7px}
.ncs-buy form {margin-top:20px}
.ncs-buy form button {width:100%;padding:18px;border:1px solid var(--nc-gold);background:var(--nc-gold);color:#080807;display:flex;justify-content:space-between;font-size:8px;letter-spacing:.18em;cursor:pointer}
.ncs-buy form button:disabled {opacity:.4;cursor:not-allowed}
.ncs-accordion {margin-top:30px;border-top:1px solid var(--nc-line)}
.ncs-story-detail {border-bottom:1px solid var(--nc-line)}
.ncs-story-detail summary {list-style:none;padding:18px 0;font-size:8px;letter-spacing:.18em;cursor:pointer;display:flex;justify-content:space-between}
.ncs-story-detail summary::-webkit-details-marker {display:none}
.ncs-story-detail summary:after {content:"+";color:var(--nc-gold)}
.ncs-story-detail[open] summary:after {content:"–"}
.ncs-story-detail>div {padding:0 0 20px;color:var(--nc-muted);font-size:12px;line-height:1.85}
.ncs-dims {display:flex;gap:28px;list-style:none;padding:0;margin:0}
.ncs-dims li {display:flex;flex-direction:column;gap:5px}
.ncs-dims span {font-size:8px;color:var(--nc-gold);letter-spacing:.15em}
.ncs-dims b {font-weight:400;color:var(--nc-ink)}

.ncs-info-page {padding:0}
.ncs-info-page>span {font-size:8px;color:var(--nc-gold);letter-spacing:.22em}
.ncs-info-page h1 {font-family:var(--nc-display);font-weight:400;font-size:clamp(36px,4.8vw,56px);line-height:1.05;letter-spacing:-.03em;margin:0}

.ncs-b2b-form {display:flex;flex-direction:column;gap:24px}
.ncs-form-row {display:grid;grid-template-columns:1fr 1fr;gap:30px}
.ncs-b2b-form label {display:flex;flex-direction:column;gap:8px;color:var(--nc-muted);font-size:8px;letter-spacing:.16em;text-transform:uppercase}
.ncs-b2b-form input,
.ncs-b2b-form select,
.ncs-b2b-form textarea {width:100%;background:transparent;border:0;border-bottom:1px solid var(--nc-line);outline:0;padding:13px 0;font-size:14px}
.ncs-b2b-form input:focus,
.ncs-b2b-form select:focus,
.ncs-b2b-form textarea:focus {border-color:var(--nc-gold)}
.ncs-b2b-form select option {background:var(--nc-bg)}
.ncs-b2b-form .ncs-btn {align-self:flex-start;margin-top:8px}
.ncs-form-success {color:var(--nc-gold);line-height:1.7}
.ncs-form-error {color:#d98568}
.ncs-form-full {grid-column:1/-1}

.ncs-contact-page .ncs-info-page {padding-bottom:5vw}
.ncs-contact-page .ncs-info-page h1 {margin-bottom:0}

.ncs-upload-note {font-size:9px;line-height:1.6;color:#6f6a62;margin-top:18px}

.ncs-search-page {min-height:70vh;padding:14vw 8vw 8vw}
.ncs-search-page h1 {font-family:var(--nc-display);font-size:clamp(42px,6vw,78px);font-weight:400}
.ncs-search-page-form {display:flex;max-width:700px;border-bottom:1px solid var(--nc-line);margin:30px 0 70px}
.ncs-search-page-form input {flex:1;background:none;border:0;outline:0;padding:15px 0;font-size:24px}
.ncs-search-page-form button {border:0;background:none;color:var(--nc-gold);font-size:8px;letter-spacing:.16em}
.ncs-pagination {display:flex;justify-content:center;gap:25px;margin-top:70px;font-size:9px;letter-spacing:.15em}
.ncs-pagination a {color:var(--nc-gold)}

.nc-footer {padding:8vw 6vw 25px;border-top:1px solid var(--nc-line);background:#060605}
.nc-footer-top {display:grid;grid-template-columns:1fr 2fr;gap:80px}
.nc-footer-brand img {width:150px;height:auto}
.nc-footer-nav {display:grid;grid-template-columns:repeat(3,1fr);gap:35px}
.nc-footer-nav>div {display:flex;flex-direction:column;gap:10px}
.nc-footer-nav span {font-size:8px;color:var(--nc-gold);letter-spacing:.2em;text-transform:uppercase;margin-bottom:8px}
.nc-footer-nav a {font-size:10px;color:var(--nc-muted);transition:color .2s}
.nc-footer-nav a:hover {color:var(--nc-ink)}

.nc-footer-bottom {display:flex;gap:25px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-top:1px solid var(--nc-line);padding-top:16px;color:#666159;font-size:8px;letter-spacing:.13em}
.nc-footer-legal {display:flex;align-items:center;gap:22px;margin-left:auto}
.nc-footer-legal-pair {display:inline-flex;align-items:center;gap:8px}
.nc-footer-legal-sep {opacity:.55}

@media(max-width:900px) {
  .nc-header {grid-template-columns:40px 1fr auto;height:68px;padding:0 16px;gap:12px}.nc-header .nc-nav {display:none}.nc-logo-brand {width:120px;justify-self:center}.nc-actions {display:flex;gap:6px}.nc-menu-toggle {display:flex}
  .ncs-home-hero {min-height:600px;height:90vh}.ncs-hero-content h1 {font-size:clamp(62px,18vw,130px)}
  .ncs-hero-slab--1 {width:50%}
  .ncs-hero-slab--2 {left:24%;width:52%}
  .ncs-hero-slab--3 {width:50%}

  .ncs-collections-page,
.ncs-collection-page {padding:24vw 6vw 16vw}.ncs-collections-list,
.ncs-collections-list--grid {grid-template-columns:1fr}.ncs-collections-list>a,
.ncs-collections-list>a:nth-child(3),
.ncs-collections-list--grid>a {grid-column:auto;min-height:0}
  .ncs-grid-products {grid-template-columns:1fr 1fr}
  .ncs-product-page {grid-template-columns:1fr;padding:95px 18px 70px}.ncs-product-gallery {position:relative;top:auto}.ncs-product-config {padding-top:30px}
  .ncs-info-page {padding:0}
  .ncs-form-row {grid-template-columns:1fr}

  .nc-footer {padding:16vw 6vw 85px}.nc-footer-top {grid-template-columns:1fr;gap:55px}.nc-footer-nav {grid-template-columns:1fr 1fr}.nc-footer-nav>div:last-child {grid-column:1/-1}
}
@media(max-width:600px) {
  .ncs-grid-products {grid-template-columns:1fr}
  .ncs-size-mode-row {grid-template-columns:1fr}.ncs-dims {gap:18px}
}

.ncs-hero-content h1 .nc-gold {color:#A57B00}

/* NEROCASA FINAL LUXURY OVERRIDES */
:root {--nc-display:"Cormorant Garamond",Didot,"Bodoni 72",serif;--nc-ui:"Inter","Helvetica Neue",Arial,sans-serif}
.ncs-hero-content h1,
.ncs-collections-page h1,
.ncs-collection-header h1,
.ncs-product-config h1,
.ncs-info-page h1,
.ncs-search-page h1,
.ncs-form-title {font-family:var(--nc-display)!important;font-weight:400!important;letter-spacing:-.035em}
.ncs-hero-content h1 {font-size:clamp(58px,9vw,145px);line-height:.82}
.ncs-hero-content h1>span:first-child {color:var(--nc-ink)}
.ncs-hero-content h1 .nc-gold {color:var(--nc-gold)}
.ncs-collections-page h1,
.ncs-collection-header h1,
.ncs-info-page h1,
.ncs-search-page h1 {font-size:clamp(36px,4.8vw,56px)!important;line-height:1.05!important;color:var(--nc-ink)!important;background:none!important;-webkit-background-clip:unset!important;background-clip:unset!important}

.ncs-collections-list {grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.ncs-collections-list--grid {display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:24px!important}
.ncs-collections-list>a,
.ncs-collections-list>a:nth-child(3),
.ncs-collections-list--grid>a {grid-column:auto;min-height:0}
@media(min-width:901px) {.ncs-collections-page--index .ncs-collections-list.ncs-collections-list--grid {display:flex!important;flex-wrap:wrap;gap:24px!important;grid-template-columns:none!important}.ncs-collections-page--index .ncs-collection-tile {flex:0 0 calc((100% - 48px)/3);width:calc((100% - 48px)/3);max-width:calc((100% - 48px)/3)}.ncs-collections-page--index .ncs-collection-tile:only-child {flex:0 0 480px;width:480px;max-width:min(480px,100%)}}
.ncs-collections-page--index {padding-top:0!important}
.ncs-collections-page--index .ncs-fit-img,
.ncs-collections-page--index .ncs-fit-img--compact {aspect-ratio:4/5!important}
.ncs-collections-list h2 {font-size:clamp(30px,3.2vw,54px)}

.ncs-form-title {font-size:clamp(34px,4vw,58px);margin:0 0 30px;color:var(--nc-ink)}

.ncs-b2b-page .ncs-info-page h1 {font-size:clamp(42px,5.2vw,78px)}

@media(max-width:900px) {.ncs-collections-list {grid-template-columns:1fr}.ncs-collections-list>a,
.ncs-collections-list>a:nth-child(3) {min-height:0}}

/* FINAL LAYOUT REFINEMENT — remove empty title placeholders and elevate Why NeroCasa */
.ncs-info-page:empty {display:none!important;padding:0!important;margin:0!important;min-height:0!important}
.ncs-collections-page {padding-top:7.5vw}
.ncs-custom-page.ncs-info-page {display:none!important}
.ncs-contact-page .ncs-info-page {display:none!important}
.ncs-b2b-page>.ncs-info-page {display:none!important}
.ncs-collections-page h1:empty,
.ncs-info-page h1:empty {display:none}

/* Footer: navigation starts at the left; no logo block */
.nc-footer-top {grid-template-columns:minmax(0,1fr) minmax(0,2fr)}

@media(max-width:900px) {
  .ncs-collections-page {padding-top:18vw}
}
@media(max-width:600px) {.nc-footer-nav {grid-template-columns:1fr 1fr}.nc-footer-nav>div:last-child {grid-column:1/-1}}

/* FINAL SPATIAL SYSTEM — fixed navigation clearance */
:root {--nc-header-h:82px}
/* All non-homepage content starts below the fixed header. */
.ncs-collections-page {padding-top:0}
.ncs-collection-page {padding-top:0}
.ncs-product-page {padding-top:calc(82px + 28px)}
.ncs-search-page {padding-top:0}
.ncs-info-page {padding-top:0}
.ncs-custom-page {padding-top:0}

.ncs-b2b-page {padding-top:0}
.ncs-contact-page {padding-top:0}

/* Prevent empty heading wrappers from creating visual gaps. */
.ncs-info-page:has(h1:empty) {display:none}
.ncs-collection-header:empty {display:none}
/* Never allow page content to slide underneath the fixed header. */
.nc-header + .nc-search-overlay ~ #MainContent {padding-bottom:0}
@media(max-width:900px) {
  :root {--nc-header-h:68px}
  #MainContent {padding-bottom:0}
  .ncs-collections-page,
.ncs-collection-page,
.ncs-search-page,
.ncs-b2b-page,
.ncs-contact-page {padding-top:0}

  .ncs-product-page {padding-top:calc(68px + 22px)}
  .ncs-blog-page,
.ncs-article-page {padding-top:0}
}

/* ── Journal / Blog ── */
.ncs-blog-page,
.ncs-article-page {padding:0 0 7vw}
.ncs-blog-hero,
.ncs-article-hero {max-width:720px}
.ncs-blog-intro,
.ncs-article-meta {color:var(--nc-muted);font-size:15px;line-height:1.75;margin-top:0}
.ncs-blog-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 32px;margin-top:12px;padding:0 8vw}
.ncs-blog-card {border:0;background:transparent}
.ncs-blog-card:hover {transform:none}
.ncs-blog-card-link {display:block;color:inherit;text-decoration:none;height:100%}
.ncs-blog-card-media {aspect-ratio:4/3;overflow:hidden;background:#111;margin-bottom:16px}
.ncs-blog-card-media img {width:100%;height:100%;object-fit:cover;filter:brightness(.78) saturate(.85)}
.ncs-blog-card-body {padding:0}
.ncs-blog-card-body time {font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--nc-gold)}
.ncs-blog-card-body h2 {font-family:var(--nc-display);font-weight:400;font-size:clamp(24px,2.4vw,34px);line-height:1.05;margin:12px 0 10px}
.ncs-blog-card-body p {color:var(--nc-muted);font-size:14px;line-height:1.7;margin:0}
.ncs-blog-read {display:inline-block;margin-top:16px;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--nc-gold)}
.ncs-blog-pagination {display:flex;justify-content:space-between;gap:16px;margin-top:48px;padding:0 8vw}
.ncs-blog-empty {color:var(--nc-muted);margin-top:24px;padding:0 8vw}
.ncs-article-back {display:inline-block;margin-bottom:18px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--nc-muted)}
.ncs-article-back:hover {color:var(--nc-gold)}
.ncs-article-tags {display:inline-flex;flex-wrap:wrap;gap:8px;margin-left:12px}
.ncs-article-tags span {font-size:9px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--nc-line);padding:4px 8px;color:var(--nc-muted)}
.ncs-article-featured {max-width:980px;margin:24px 8vw 0}
.ncs-article-featured img {display:block;width:100%;height:auto;filter:brightness(.82) saturate(.88)}
.ncs-article-content {max-width:760px;margin:32px 8vw 0}
.ncs-article-content h2,
.ncs-article-content h3 {font-family:var(--nc-display);font-weight:400;color:var(--nc-ink);margin:36px 0 14px;line-height:1.15}
.ncs-article-content h2 {font-size:clamp(28px,3vw,42px)}
.ncs-article-content h3 {font-size:clamp(22px,2.2vw,30px)}
.ncs-article-content a {color:var(--nc-gold);text-decoration:underline;text-underline-offset:3px}
.ncs-article-cta {max-width:760px;margin:48px 8vw 0;padding-top:24px;border-top:1px solid var(--nc-line)}
.ncs-article-cta p {color:var(--nc-muted);margin:0 0 20px}
.ncs-article-cta-actions {display:flex;flex-wrap:wrap;gap:12px}
@media(max-width:900px) {
  .ncs-blog-grid {grid-template-columns:1fr}
}


/* NeroCasa — luxury refinement layer (keeps --nc-gold: #A57B00) */

:root {
  --nc-header-h: 82px;
  --nc-space-xs: 16px;
  --nc-space-sm: 32px;
  --nc-space-md: 64px;
  --nc-space-lg: clamp(80px, 10vw, 140px);
  --nc-space-xl: clamp(100px, 14vw, 180px);
  --nc-line: rgba(242, 238, 230, 0.1);
  --nc-display: "Cormorant Garamond", Didot, "Bodoni 72", serif;
  --nc-ui: "Inter", "Helvetica Neue", Arial, sans-serif;
}

.nc-grain {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
}

body {
  font-family: var(--nc-ui);
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}

/* ── Shared page hero ── */
.ncs-page-kicker {
  display: none !important;
}

.ncs-page-hero {
  padding: calc(var(--nc-header-h) + var(--nc-space-md)) 8vw var(--nc-space-lg);
  max-width: 920px;
}

.ncs-page-hero h1 {
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(48px, 6.5vw, 88px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  margin: 0 0 32px;
  color: var(--nc-ink);
}

.ncs-page-hero h1 em {
  font-style: italic;
  color: var(--nc-gold);
}

.ncs-page-hero > p {
  max-width: 520px;
  margin: 0;
  color: var(--nc-muted);
  font-size: 15px;
  line-height: 1.85;
}

.ncs-page-hero--compact {
  padding: calc(var(--nc-header-h) + 36px) 8vw 28px;
  max-width: 720px;
}

.ncs-page-hero--compact h1,
.ncs-collection-header.ncs-page-hero--compact h1 {
  font-size: clamp(36px, 4.8vw, 56px) !important;
  margin: 0 0 14px !important;
}

/* ── Scroll reveal ── */
[data-nc-reveal] {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.85s var(--nc-ease, cubic-bezier(0.22, 1, 0.36, 1)),
    transform 0.85s var(--nc-ease, cubic-bezier(0.22, 1, 0.36, 1));
}

[data-nc-reveal].is-visible {
  opacity: 1;
  transform: none;
}

/* ── Header & logo ── */
.nc-logo-brand img {
  width: auto;
  height: 44px;
  max-width: 120px;
  object-fit: contain;
  object-position: left center;
}

.nc-actions {
  gap: 16px !important;
  align-items: center;
}

.nc-footer-social {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 24px;
}

.nc-social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid rgba(165, 123, 0, 0.28);
  color: var(--nc-muted);
  text-decoration: none;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}

.nc-social-link:hover,
.nc-social-link:focus-visible {
  color: var(--nc-gold);
  border-color: var(--nc-gold);
  background: rgba(165, 123, 0, 0.08);
  outline: none;
}

.nc-social-icon {
  display: block;
  flex-shrink: 0;
  width: 20px;
  height: 20px;
}

.nc-social-icon--inline {
  width: 16px;
  height: 16px;
}

.nc-social-label {
  line-height: 1;
}

.nc-footer-contact-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

@media (max-width: 749px) {
  .nc-footer-social {
    gap: 8px;
  }

  .nc-social-link {
    flex: 1 1 calc(50% - 8px);
    min-width: calc(50% - 8px);
    justify-content: center;
  }
}

.nc-header {
  height: var(--nc-header-h);
  backdrop-filter: blur(12px);
  grid-template-columns: 180px 1fr 120px !important;
}

.nc-nav {
  font-size: 10px;
  letter-spacing: 0.18em;
  gap: 32px;
}

.nc-header.is-scrolled {
  background: rgba(8, 8, 7, 0.9);
}

/* ── Hero (home) ── */
.ncs-home-hero {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  height: 100vh;
  overflow: hidden;
  isolation: isolate;
  background: var(--nc-bg, #080807);
}

.ncs-home-hero-photo {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.55) saturate(0.85) contrast(1.02);
}

.ncs-hero-slabs {
  position: absolute;
  inset: 0;
  z-index: 0;
  will-change: transform;
}

.ncs-hero-slab {
  position: absolute;
  top: 0;
  bottom: 0;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.72) saturate(0.92) contrast(1.02);
  transition: filter 0.6s ease, transform 0.6s ease;
}

.ncs-hero-slab--1 {
  left: 0;
  width: 46%;
  -webkit-mask-image: linear-gradient(to right, #000 62%, transparent);
  mask-image: linear-gradient(to right, #000 62%, transparent);
}

.ncs-hero-slab--2 {
  left: 27%;
  width: 46%;
  opacity: 0.92;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
  mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
}

.ncs-hero-slab--3 {
  right: 0;
  width: 46%;
  -webkit-mask-image: linear-gradient(to left, #000 62%, transparent);
  mask-image: linear-gradient(to left, #000 62%, transparent);
}

.ncs-hero-slabs--dual .ncs-hero-slab--1 {
  left: 0;
  width: 58%;
  -webkit-mask-image: linear-gradient(to right, #000 50%, transparent);
  mask-image: linear-gradient(to right, #000 50%, transparent);
}

.ncs-hero-slabs--dual .ncs-hero-slab--dual {
  right: 0;
  left: auto;
  width: 58%;
  opacity: 0.94;
  filter: brightness(0.72) saturate(0.92) contrast(1.02);
  transition: filter 0.6s ease, transform 0.6s ease;
  -webkit-mask-image: linear-gradient(to left, #000 50%, transparent);
  mask-image: linear-gradient(to left, #000 50%, transparent);
}

.ncs-hero-overlay--page {
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.42) 42%, rgba(0, 0, 0, 0.55) 100%),
    linear-gradient(0deg, rgba(8, 8, 7, 0.88) 0%, rgba(8, 8, 7, 0.28) 50%, rgba(8, 8, 7, 0.82) 100%);
}

.ncs-page-hero-shell {
  position: relative;
  isolation: isolate;
}

.ncs-page-hero-shell .ncs-hero-media {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  height: 100%;
  min-height: 100%;
  pointer-events: none;
}

.ncs-page-hero-shell .ncs-hero-media .ncs-hero-marble-bg,
.ncs-page-hero-shell .ncs-hero-media .ncs-hero-slabs {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ncs-page-hero-shell .ncs-page-hero,
.ncs-page-hero-shell .ncs-collection-header,
.ncs-page-hero-shell .ncs-search-hero,
.ncs-page-hero-shell .ncs-b2b-header,
.ncs-page-hero-shell .ncs-about-hero-copy,
.ncs-page-hero-shell .ncs-about-hero-visual,
.ncs-page-hero-shell .ncs-b2b-form-wrap,
.ncs-page-hero-shell > h1 {
  position: relative;
  z-index: 2;
}

.ncs-page-hero-shell .ncs-b2b-form-panel {
  background: transparent;
}

.ncs-b2b-layout.ncs-page-hero-shell,
.ncs-about-hero-split.ncs-page-hero-shell {
  overflow: hidden;
}

.ncs-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(8, 8, 7, 0.55), transparent 70%),
    linear-gradient(0deg, var(--nc-bg, #080807) 0%, rgba(8, 8, 7, 0.35) 42%, transparent 68%),
    radial-gradient(ellipse at center, rgba(8, 8, 7, 0.18), rgba(8, 8, 7, 0.55));
}

.ncs-hero-content {
  position: absolute;
  inset: 0;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 28px;
  text-align: center;
  padding: calc(var(--nc-header-h) + 88px) 6vw 48px;
  box-sizing: border-box;
  z-index: 2;
}

.ncs-hero-content h1 {
  font-size: clamp(56px, 10vw, 148px);
  line-height: 0.95;
  letter-spacing: -0.04em;
}

.ncs-hero-content h1 .nc-gold {
  color: var(--nc-gold);
}

.ncs-hero-tagline {
  font-family: var(--nc-display);
  font-size: clamp(18px, 2.2vw, 26px);
  font-weight: 300;
  font-style: italic;
  letter-spacing: 0.04em;
  color: rgba(242, 238, 230, 0.78);
  margin: 0;
  max-width: 420px;
}

/* ── Home accent strip — removed from home, hide if legacy markup remains ── */

/* ── Collection tiles (home + collections index) ── */
.ncs-collection-tile {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-decoration: none;
  color: inherit;
  background: transparent;
  border: 0;
  overflow: visible;
}

.ncs-collection-tile::after {
  display: none;
}

.ncs-collection-tile-label {
  padding: 0 4px;
  pointer-events: none;
}

.ncs-collection-tile-label strong,
.ncs-collection-tile-label h2 {
  margin: 0;
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(26px, 2.8vw, 40px);
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: var(--nc-ink);
}

.ncs-collections-list .ncs-collection-tile-label h2 {
  font-size: clamp(28px, 3vw, 46px);
}

.ncs-collections-list > a {
  position: relative;
  overflow: visible;
  min-height: 0 !important;
}

.ncs-collections-list > a::after {
  display: none;
}

/* ── Equal-size image boxes ── */
.ncs-fit-img {
  width: 100%;
  aspect-ratio: 4 / 5;
  position: relative;
  overflow: hidden;
  background: #080807;
}

.ncs-fit-img img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.94) saturate(0.9);
  transition: filter 0.35s ease;
}

/* Collection tiles — identical boxes, image fills edge to edge */
.ncs-fit-img--tile {
  aspect-ratio: 4 / 5;
  background: #080807;
}

.ncs-fit-img--tile img {
  object-fit: cover;
}

.ncs-fit-img--compact {
  aspect-ratio: 4 / 5;
}

.ncs-collection-tile:hover .ncs-fit-img img,
.ncs-card:hover .ncs-fit-img img {
  filter: brightness(1) saturate(0.96);
}

.ncs-main-product-image {
  aspect-ratio: auto;
  min-height: 0;
  background: transparent;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14px;
}

.ncs-main-product-image img {
  position: static;
  inset: auto;
  width: 100%;
  height: auto;
  max-width: 100%;
  object-fit: contain;
}

.ncs-shown-in {
  margin: 0;
  padding: 0 4px;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--nc-muted);
  text-align: center;
}

/* Collections index — 3 equal columns */
.ncs-collections-list--grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 24px !important;
  max-width: none !important;
  align-items: stretch;
}

.ncs-collections-page .ncs-collection-tile {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
  height: 100%;
}

.ncs-collections-page .ncs-fit-img {
  flex: 0 0 auto;
}

/* ── Product page — image leads, full object visible ── */
.ncs-product-page {
  grid-template-columns: 1fr 1fr !important;
  align-items: start;
}

.ncs-product-gallery {
  position: sticky;
  top: calc(var(--nc-header-h, 82px) + 24px);
}

@media (max-width: 900px) {
  .ncs-product-page {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }

  .ncs-product-gallery {
    position: static;
  }
}

/* ── Section rhythm ── */

/* Remove gradient text globally */
.ncs-collections-page h1,
.ncs-collection-header h1,
.ncs-info-page h1,
.ncs-search-page h1,
.ncs-form-title {
  background: none !important;
  -webkit-background-clip: unset !important;
  background-clip: unset !important;
  color: var(--nc-ink) !important;
  line-height: 1.05 !important;
}

/* ── Collections grid ── */

.ncs-collections-list .ncs-collection-tile-label {
  position: static !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
}

.ncs-collections-list .ncs-collection-tile-label small {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: lowercase;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 400;
}

/* ── Product rail ── */

/* ── Product cards on collection pages — 3 equal tiles ── */
.ncs-grid-products {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 28px 20px !important;
  max-width: none;
  align-items: stretch;
}

.ncs-grid-products .ncs-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
  height: 100%;
}

.ncs-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-decoration: none;
  color: inherit;
  background: transparent;
  border: 0;
  overflow: visible;
}

.ncs-grid-products .ncs-fit-img,
.ncs-card-media.ncs-fit-img {
  flex: 0 0 auto;
  aspect-ratio: 4 / 5;
  background: var(--nc-bg);
}

.ncs-grid-products .ncs-fit-img img,
.ncs-card-media.ncs-fit-img img {
  object-fit: cover !important;
}

.ncs-card-media {
  overflow: hidden;
  background: var(--nc-bg);
}

.ncs-card-info {
  padding: 0 4px !important;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  border-bottom: 0;
}

.ncs-card-info span {
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1.35;
}

.ncs-card-info b {
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--nc-gold);
  font-weight: 400;
}

.ncs-card-from {
  font-size: 11px !important;
  letter-spacing: 0.12em;
  color: var(--nc-gold) !important;
  font-weight: 400;
}

.ncs-card-marbles {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  padding-top: 2px;
}

.ncs-marble-swatches {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ncs-marble-swatch {
  flex: 0 0 14px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid rgba(242, 238, 230, 0.22);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  pointer-events: auto;
}

.ncs-marble-swatch.is-active {
  box-shadow: 0 0 0 2px var(--nc-gold), 0 0 12px rgba(165,123,0,0.3);
  transform: scale(1.1);
}

.ncs-marble-swatch--ibiza-white { background: #f0ebe3; }
.ncs-marble-swatch--armani-grey { background: #8a8580; }
.ncs-marble-swatch--travertine { background: #c4a06a; }
.ncs-marble-swatch--rosso-levanto { background: #6b3434; }

.ncs-marble-card:hover .ncs-marble-swatch {
  cursor: pointer;
}

.ncs-marble-card .ncs-marble-swatch:hover,
.ncs-marble-card .ncs-marble-swatch:focus-visible {
  transform: scale(1.15);
  box-shadow: 0 0 0 1px var(--nc-gold);
}

.ncs-card-marbles-label {
  margin: 0;
  font-size: 10px;
  letter-spacing: 0.1em;
  line-height: 1.55;
  color: var(--nc-muted);
  font-weight: 400;
}

.ncs-card-marbles-label .ncs-marble-dot {
  margin: 0 5px;
  color: var(--nc-gold);
  opacity: 0.55;
}

/* ── Bespoke CTA ── */

/* ── Mail / newsletter ── */

/* ── WHY NEROCASA — editorial layout ── */
.ncs-about-page {
  background: var(--nc-bg);
  padding-bottom: var(--nc-space-xl);
}

.ncs-about-hero-split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  gap: var(--nc-space-md);
  align-items: center;
  padding: calc(var(--nc-header-h) + var(--nc-space-md)) 8vw var(--nc-space-lg);
}

.ncs-about-hero-copy {
  max-width: 560px;
}

.ncs-about-hero-copy h1 {
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1.04;
  letter-spacing: -0.03em;
  margin: 0 0 28px;
  color: var(--nc-ink);
}

.ncs-about-hero-copy h1 em {
  font-style: italic;
  color: var(--nc-gold);
}

.ncs-about-hero-lead {
  max-width: 480px;
  margin: 0;
  color: var(--nc-muted);
  font-size: 16px;
  line-height: 1.85;
}

.ncs-about-hero-visual {
  position: relative;
  overflow: visible;
  background: transparent;
}

.ncs-about-hero-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(16px, 3vw, 32px);
  background: transparent;
  border: 0;
}

.ncs-about-hero-logo img {
  width: min(100%, 420px);
  height: auto;
  object-fit: contain;
  filter: none !important;
}

.ncs-about-hero-visual:not(.nc-brand-visual-frame) img {
  width: 100%;
  height: 100%;
  min-height: clamp(320px, 42vw, 560px);
  object-fit: cover;
  filter: brightness(0.82) saturate(0.75);
}

.ncs-about-quote {
  margin: 0;
  padding: var(--nc-space-lg) 8vw;
  border: 0;
  border-left: 2px solid var(--nc-gold);
  margin-left: 8vw;
  margin-right: 8vw;
  background: linear-gradient(90deg, rgba(165, 123, 0, 0.06), transparent 72%);
}

.ncs-about-quote p {
  font-family: var(--nc-display);
  font-size: clamp(28px, 3.8vw, 52px);
  line-height: 1.25;
  font-weight: 300;
  font-style: italic;
  max-width: 820px;
  margin: 0;
  padding-left: var(--nc-space-sm);
  color: var(--nc-ink);
}

.ncs-about-pillars {
  padding: var(--nc-space-xl) 8vw;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--nc-space-sm);
}

.ncs-about-pillar {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 28px;
  padding: var(--nc-space-md);
  border: 0;
  align-items: start;
  background: var(--nc-panel);
}

.ncs-about-pillar--wide {
  grid-column: 1 / -1;
  grid-template-columns: 64px 1fr;
  max-width: calc(50% + 32px);
}

.ncs-pillar-num {
  font-family: var(--nc-display);
  font-size: clamp(28px, 2.5vw, 40px);
  color: var(--nc-gold);
  line-height: 1;
  padding-top: 8px;
}

.ncs-pillar-body h2 {
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(26px, 2.8vw, 40px);
  line-height: 1.1;
  margin: 0 0 20px;
  color: var(--nc-ink);
}

.ncs-pillar-body p {
  max-width: 520px;
  margin: 0;
  color: var(--nc-muted);
  font-size: 15px;
  line-height: 1.85;
}

.ncs-about-stones-head {
  max-width: 520px;
  margin-bottom: var(--nc-space-md);
}

.ncs-about-stones-head p {
  margin: 0;
  color: var(--nc-muted);
  font-size: 15px;
  line-height: 1.75;
}

.ncs-stone-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--nc-space-sm);
}

.ncs-stone-card {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ncs-stone-swatch {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: var(--nc-panel);
}

.ncs-stone-swatch img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.78) saturate(0.72);
  transition: transform 0.6s ease, filter 0.4s ease;
}

.ncs-stone-card:hover .ncs-stone-swatch img {
  transform: scale(1.03);
  filter: brightness(0.88) saturate(0.82);
}

.ncs-stone-card h3 {
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(22px, 2.2vw, 30px);
  line-height: 1.1;
  margin: 0;
  color: var(--nc-ink);
}

.ncs-stone-card p {
  margin: 0;
  color: var(--nc-muted);
  font-size: 13px;
  line-height: 1.7;
}

/* Hide old why-nerocasa grid if present */

/* ── Contact page ── */
.ncs-contact-page {
  padding-top: 0;
}

.ncs-contact-layout {
  padding-bottom: var(--nc-space-xl);
}

.ncs-contact-layout--split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: clamp(40px, 6vw, 96px);
  align-items: start;
  padding: calc(var(--nc-header-h) + 36px) 8vw var(--nc-space-lg);
}

.ncs-contact-layout--split .ncs-contact-hero {
  padding: 0;
  max-width: none;
}

.ncs-contact-layout--split .ncs-contact-hero > p {
  max-width: 46ch;
}

.ncs-contact-layout--split .ncs-contact-lines {
  padding: 36px 0 0;
  max-width: none;
}

.ncs-contact-layout--split .ncs-contact-form-wrap {
  margin: 0;
  max-width: none;
  padding: 0;
  width: auto;
}

.ncs-contact-hero .ncs-btn {
  margin-top: 36px;
}

.ncs-contact-visual {
  margin: 0 8vw var(--nc-space-md);
  max-height: clamp(260px, 34vw, 420px);
  overflow: hidden;
  background: var(--nc-panel);
}

.ncs-contact-visual img {
  width: 100%;
  height: clamp(260px, 34vw, 420px);
  object-fit: cover;
  object-position: center;
  filter: brightness(0.78) saturate(0.8);
  display: block;
}

.ncs-btn--ghost {
  background: transparent;
  color: var(--nc-gold);
}

.ncs-btn--ghost:hover {
  background: var(--nc-gold);
  color: #080807;
}

.ncs-contact-lines {
  list-style: none;
  margin: 0;
  padding: 8px 8vw 0;
  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.ncs-contact-lines li {
  display: grid;
  grid-template-columns: 110px minmax(0, 1fr);
  gap: 16px;
  align-items: baseline;
}

.ncs-contact-lines span {
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--nc-gold);
}

.ncs-contact-lines a {
  color: var(--nc-ink);
  text-decoration: none;
}

.ncs-contact-lines a:hover {
  color: var(--nc-gold);
}

.ncs-contact-form-panel {
  background: transparent;
  padding: 0;
}

/* ── Collection pages ── */
.ncs-collections-page {
  padding: 0 8vw var(--nc-space-lg);
}

.ncs-collections-page--index {
  padding-top: 0 !important;
}

@media (min-width: 901px) {
  .ncs-collections-page--index .ncs-collections-list.ncs-collections-list--grid {
    display: flex !important;
    flex-wrap: wrap;
    gap: 24px !important;
    grid-template-columns: none !important;
  }

  .ncs-collections-page--index .ncs-collection-tile {
    flex: 0 0 calc((100% - 48px) / 3);
    width: calc((100% - 48px) / 3);
    max-width: calc((100% - 48px) / 3);
  }

  .ncs-collections-page--index .ncs-collection-tile:only-child {
    flex: 0 0 480px;
    width: 480px;
    max-width: min(480px, 100%);
  }
}

.ncs-collections-page--index .ncs-collection-tile {
  background: #080807;
  padding: 0;
  gap: 14px;
  border: 1px solid rgba(242, 238, 230, 0.14);
}

.ncs-collections-page--index .ncs-fit-img,
.ncs-collections-page--index .ncs-fit-img--tile,
.ncs-collections-page--index .ncs-fit-img--compact {
  aspect-ratio: 4 / 5 !important;
}

.ncs-collections-page--index .ncs-collection-tile-label {
  padding: 0 14px 16px;
}

.ncs-collections-page .ncs-page-hero {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 24px;
  max-width: none;
}

.ncs-collections-page .ncs-page-hero h1 {
  margin-bottom: 12px;
}

.ncs-collections-lead {
  max-width: 46em;
  margin: 0;
  color: var(--nc-muted);
  font-size: 16px;
  line-height: 1.65;
}

.ncs-collection-page {
  padding: 0 8vw var(--nc-space-lg);
}

.ncs-collections-page::before,
.ncs-collection-page .ncs-collection-header:not(:empty)::before {
  content: none;
}

.ncs-collection-header {
  margin-bottom: var(--nc-space-md);
  max-width: 720px;
}

.ncs-collection-header h1 {
  font-size: clamp(44px, 6vw, 80px) !important;
  line-height: 1.05 !important;
  margin: 0 0 20px !important;
}

.ncs-collection-lead {
  font-family: var(--nc-display);
  font-style: italic;
  font-size: clamp(17px, 2.1vw, 22px);
  font-weight: 300;
  line-height: 1.45;
  color: rgba(242, 238, 230, 0.78);
  margin: 0 0 18px !important;
  max-width: 520px;
}

.ncs-collection-desc {
  color: var(--nc-muted) !important;
  font-size: 14px !important;
  line-height: 1.75 !important;
  margin: 0 0 20px !important;
}

.ncs-collection-header p:not(.ncs-collection-lead):not(.ncs-collection-desc) {
  margin: 0 0 24px !important;
  font-size: 15px;
  line-height: 1.85;
  max-width: 560px;
}

.ncs-collection-count {
  display: inline-block;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--nc-gold);
  margin-top: 8px;
}

.ncs-collections-list {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--nc-space-sm);
}

.ncs-collections-list--grid > a {
  min-height: 0 !important;
}

.ncs-collections-list > a:nth-child(3),
.ncs-collections-list > a:nth-child(4) {
  grid-column: auto;
  min-height: 0 !important;
}

.ncs-collections-list h2 {
  font-size: clamp(32px, 4vw, 56px);
  margin-bottom: 16px;
}

.ncs-collections-list small {
  display: block !important;
  margin-bottom: 12px !important;
  font-size: 11px !important;
}

/* ── Product page spacing ── */
.ncs-product-page {
  padding: calc(var(--nc-header-h) + 32px) 8vw var(--nc-space-lg);
  gap: 8vw;
}

.ncs-product-config h1 {
  font-size: clamp(40px, 4.5vw, 72px) !important;
  line-height: 1.05 !important;
  margin: 12px 0 24px !important;
}

.ncs-price {
  border: 0;
  padding: 36px 0 0;
  margin: 40px 0 0;
}

.ncs-buy {
  border-top: 0;
  padding-top: 40px;
  margin-top: 0;
}

.ncs-accordion {
  border-top: 1px solid var(--nc-line);
  margin-top: 56px;
  padding-top: 8px;
}

.ncs-choice > label,
.ncs-size-mode > label,
.ncs-buy > div span {
  font-size: 10px;
}

/* ── B2B page ── */
.ncs-b2b-page {
  padding-top: 0;
  padding-bottom: var(--nc-space-xl);
}

.ncs-b2b-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  gap: var(--nc-space-lg);
  align-items: start;
  padding: 0 8vw;
}

.ncs-b2b-header {
  padding: 0;
  max-width: 520px;
}

.ncs-b2b-header.ncs-page-hero {
  padding: 0;
  max-width: 520px;
}

.ncs-b2b-header h1 {
  font-family: var(--nc-display);
  font-weight: 400;
  font-size: clamp(48px, 6.5vw, 88px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  margin: 0 0 24px;
  color: var(--nc-ink);
}

.ncs-b2b-header p {
  margin: 0;
  color: var(--nc-muted);
  font-size: 15px;
  line-height: 1.85;
}

.ncs-b2b-trust {
  list-style: none;
  padding: 0;
  margin: 36px 0 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.ncs-b2b-trust li {
  font-size: 13px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--nc-muted);
  padding-left: 20px;
  position: relative;
}

.ncs-b2b-trust li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8px;
  height: 1px;
  background: var(--nc-gold);
  transform: translateY(-50%);
}

.ncs-b2b-form-panel {
  background: transparent;
  padding: 0;
}

.ncs-b2b-form label {
  font-size: 10px;
}

/* ── Material grid — softer ── */

/* ── Footer ── */
.nc-footer {
  border-top: 1px solid var(--nc-line);
  padding: var(--nc-space-lg) 8vw 32px;
  background: #060605;
}

.nc-footer-top {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) !important;
  gap: var(--nc-space-lg) !important;
  align-items: start;
}

.nc-footer-brand {
  max-width: 320px;
}

.nc-footer-logo {
  font-family: var(--nc-display);
  font-size: clamp(28px, 3vw, 36px);
  letter-spacing: 0.16em;
  display: inline-block;
  margin-bottom: 20px;
}

.nc-footer-brand p {
  margin: 0;
  color: var(--nc-muted);
  font-size: 14px;
  line-height: 1.75;
}

.nc-footer-nav {
  grid-template-columns: repeat(3, 1fr) !important;
}

.nc-footer-nav a {
  font-size: 11px;
  line-height: 1.6;
}

.nc-footer-bottom {
  margin-top: var(--nc-space-md);
  font-size: 10px;
  border-top: 1px solid var(--nc-line);
  padding-top: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  color: #666159;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.nc-footer-entity {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 52ch;
}

.nc-footer-copy {
  opacity: 0.85;
}

.nc-footer-owner {
  margin: 0;
  font-size: 10px;
  line-height: 1.55;
  letter-spacing: 0.04em;
  text-transform: none;
  color: #666159;
}

.nc-footer-owner strong {
  font-weight: 500;
  color: #8a8378;
}

.nc-footer-legal {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-left: auto;
}

.nc-footer-legal a {
  color: #666159;
  transition: color 0.2s;
}

.nc-footer-legal a:hover {
  color: var(--nc-gold);
}

.nc-footer-legal-pair {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.nc-footer-legal-sep {
  opacity: 0.55;
}

/* ── Buttons ── */
.ncs-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 12px !important;
  font-weight: 500;
  padding: 18px 36px !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase;
  background: var(--nc-gold) !important;
  color: #080807 !important;
  border: 1px solid var(--nc-gold) !important;
  cursor: pointer;
  transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  box-shadow: 0 4px 20px rgba(165, 123, 0, 0.28);
}

.ncs-btn:hover {
  background: #c49200 !important;
  border-color: #c49200 !important;
  color: #080807 !important;
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(165, 123, 0, 0.4);
}

.ncs-btn:active {
  transform: translateY(0) scale(0.98) !important;
  box-shadow: 0 2px 8px rgba(165,123,0,0.2) !important;
}

.ncs-custom-whatsapp-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 18px;
  padding: 18px;
  background: var(--nc-gold);
  color: #080807;
  border: 1px solid var(--nc-gold);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(165, 123, 0, 0.28);
  transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}

.ncs-custom-whatsapp-box:hover {
  background: #c49200;
  border-color: #c49200;
  color: #080807;
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(165, 123, 0, 0.4);
}

.ncs-btn--outline {
  background: transparent !important;
  color: var(--nc-ink) !important;
  border-color: rgba(242, 238, 230, 0.35) !important;
  box-shadow: none;
}

.ncs-btn--outline:hover {
  background: rgba(165, 123, 0, 0.12) !important;
  border-color: var(--nc-gold) !important;
  color: var(--nc-gold) !important;
  transform: translateY(-1px);
}

.ncs-btn--ghost {
  background: transparent !important;
  color: var(--nc-gold) !important;
  box-shadow: none;
}

.ncs-btn--ghost:hover {
  background: var(--nc-gold) !important;
  color: #080807 !important;
}

.ncs-btn--compact {
  padding: 14px 24px !important;
  font-size: 11px !important;
}

.nc-footer-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: var(--nc-space-md) 0;
  margin-top: var(--nc-space-md);
  border-top: 1px solid var(--nc-line);
}

.nc-footer-logo img {
  width: auto;
  height: 52px;
  max-width: 140px;
  object-fit: contain;
  display: block;
  margin-bottom: 20px;
}

.nc-footer-nav span {
  display: none;
}

.nc-footer-nav > div {
  gap: 14px !important;
}

/* ── Empty header cleanup ── */
.ncs-info-page:empty,
.ncs-collection-header:empty {
  display: none !important;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  :root {
    --nc-header-h: 68px;
  }

  .ncs-page-hero {
    padding: calc(var(--nc-header-h) + 48px) 6vw var(--nc-space-md);
  }

  .ncs-about-hero-split {
    grid-template-columns: 1fr;
    padding: calc(var(--nc-header-h) + 48px) 6vw var(--nc-space-md);
    gap: var(--nc-space-sm);
  }

  .ncs-about-hero-visual {
    min-height: 280px;
  }

  .ncs-about-hero-visual img {
    min-height: 280px;
  }

  .ncs-about-quote {
    margin-left: 6vw;
    margin-right: 6vw;
    padding: var(--nc-space-md) 6vw;
  }

  .ncs-about-pillars {
