<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.background | default: '#080807' }}">
  {% render 'nc-meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {%- comment -%}
    Base reset, inlined. It was a separate 130-byte stylesheet, which cost a
    full render-blocking request for three declarations.
  {%- endcomment -%}
  <style>
    html { background: {{ settings.background | default: '#080807' }}; }
    body { background: {{ settings.background | default: '#080807' }}; color: #f2eee6; }
    * { box-sizing: border-box; }
  </style>
  {{ 'nerocasa-additions.css' | asset_url | stylesheet_tag }}
  {{ 'nerocasa-luxury.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --nc-bg: {{ settings.background | default: '#080807' }};
      --nc-gold: {{ settings.gold | default: '#A57B00' }};
      --nc-ease: cubic-bezier(0.22, 1, 0.36, 1);
      --nc-space-1: 8px;
      --nc-space-2: 16px;
      --nc-space-3: 24px;
      --nc-space-4: 40px;
      --nc-space-5: 64px;
      --nc-space-6: 96px;
      --nc-space-7: 144px;
    }
  </style>
</head>
<body>
  <div class="nc-loader" data-nc-loader>
    <span class="nc-loader-mark">NEROCASA</span>
  </div>
  <div class="nc-cursor" data-nc-cursor hidden></div>
  {% section 'nc-header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'nc-footer' %}
  <script src="{{ 'nerocasa.js' | asset_url }}" defer></script>
  <script src="{{ 'nerocasa-v20.js' | asset_url }}" defer></script>
</body>
</html>
