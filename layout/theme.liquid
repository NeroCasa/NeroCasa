<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#080807">
  <meta name="description" content="NeroCasa — architectural marble furniture and objects, made to order.">
  <title>{% if page_title %}{{ page_title }} — {{ shop.name }}{% else %}NEROCASA{% endif %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'nerocasa.css' | asset_url | stylesheet_tag }}
  {{ 'nerocasa-v20.css' | asset_url | stylesheet_tag }}
  {{ 'nerocasa-additions.css' | asset_url | stylesheet_tag }}
  {{ 'nerocasa-luxury.css' | asset_url | stylesheet_tag }}
</head>
<body>
  {% section 'nc-header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'nc-footer' %}
  <script src="{{ 'nerocasa.js' | asset_url }}" defer></script>
  <script src="{{ 'nerocasa-v20.js' | asset_url }}" defer></script>
</body>
</html>
