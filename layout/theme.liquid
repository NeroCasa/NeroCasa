<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  {%- comment -%} Google tag GT-PJ46R9SC — Search Console / Google. One per page. Do not add a second gtag. {%- endcomment -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id=GT-PJ46R9SC"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'GT-PJ46R9SC');
  </script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.background | default: '#080807' }}">
  {% render 'nc-meta-tags' %}
  {{ content_for_header }}
  {% render 'nc-favicon' %}
  {%- comment -%}
    Base reset, inlined. It was a separate 130-byte stylesheet, which cost a
    full render-blocking request for three declarations.
  {%- endcomment -%}
  <style>
    html { background: {{ settings.background | default: '#080807' }}; }
    body { background: {{ settings.background | default: '#080807' }}; color: #f2eee6; }
    * { box-sizing: border-box; }
  </style>
  {{ 'nerocasa.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --nc-bg: {{ settings.background | default: '#080807' }};
      --nc-gold: {{ settings.gold | default: '#A57B00' }};
      --nc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    }
  </style>
</head>
<body>
  <div class="nc-loader" data-nc-loader>
    <span class="nc-loader-mark">NEROCASA</span>
  </div>
  <div class="nc-cursor" data-nc-cursor hidden></div>
  <div class="nc-grain" aria-hidden="true"></div>
  {% section 'nc-header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'nc-footer' %}
  <script src="{{ 'nerocasa.js' | asset_url }}" defer></script>
  <script src="{{ 'nerocasa-v20.js' | asset_url }}" defer></script>
</body>
</html>
